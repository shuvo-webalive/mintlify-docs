  "keyFeatures": [
    "Product & Variant Catalogue with real-time multi-channel sync",
    "End-to-end Order Management with split orders and partial fulfilment",
    "Purchase Order & Supplier Management with multi-location receiving",
    "Custom Portals with drag-and-drop form builders and approval workflows",
    "Accounting & Finance Sync with Xero, MYOB, and QuickBooks",
    "No-code Admin Tools for workflows, dashboards, and permissions",
    "Dashboards & Reporting with role-based custom views",
    "Prebuilt connectors for Shopify, Amazon, HubSpot, NetSuite, AroFlo, and more",
    "REST API with OAuth 2.0 and webhook support",
    "Multi-language SDK (Python, PHP)"
  ],
  "publicApiSurface": [
    "POST /api/v1/oauth2/token",
    "GET /api/v3/accounts",
