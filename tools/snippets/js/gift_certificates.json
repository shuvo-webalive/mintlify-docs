{
  "sdk": "js",
  "module": "gift_certificates",
  "endpoints": {
    "get_gift_certificates": {
      "function": "giftCertificates.getGiftCertificates",
      "code": "const response = await client.giftCertificates.getGiftCertificates({limit: 20});\nconsole.log(response.data);\n"
    },
    "create_gift_certificate": {
      "function": "giftCertificates.createGiftCertificate",
      "code": "const response = await client.giftCertificates.createGiftCertificate({\n    gift_certificate: {amount: '5.00', expiry_date: '2027-10-01'},\n});\nconsole.log(response.data);\n"
    },
    "delete_gift_certificate": {
      "function": "giftCertificates.deleteGiftCertificate",
      "code": "const response = await client.giftCertificates.deleteGiftCertificate('gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f');\nconsole.log(response.data);\n"
    },
    "get_gift_certificate": {
      "function": "giftCertificates.getGiftCertificate",
      "code": "const response = await client.giftCertificates.getGiftCertificate('gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f');\nconsole.log(response.data);\n"
    },
    "update_gift_certificate": {
      "function": "giftCertificates.updateGiftCertificate",
      "code": "const response = await client.giftCertificates.updateGiftCertificate('gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f', {\n    gift_certificate: {expiry_date: '2027-12-31'},\n});\nconsole.log(response.data);\n"
    },
    "get_gift_certificate_allocations": {
      "function": "giftCertificates.getGiftCertificateAllocations",
      "code": "const response = await client.giftCertificates.getGiftCertificateAllocations('gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f', {\n    limit: 20,\n});\nconsole.log(response.data);\n"
    },
    "get_gift_certificate_transactions": {
      "function": "giftCertificates.getGiftCertificateTransactions",
      "code": "const response = await client.giftCertificates.getGiftCertificateTransactions('gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f', {\n    limit: 20,\n});\nconsole.log(response.data);\n"
    },
    "amend_gift_certificate": {
      "function": "giftCertificates.amendGiftCertificate",
      "code": "const response = await client.giftCertificates.amendGiftCertificate('gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f', {\n    gift_certificate: {new_balance: '7.00'},\n});\nconsole.log(response.data);\n"
    },
    "allocate_gift_certificate": {
      "function": "giftCertificates.allocateGiftCertificate",
      "code": "const response = await client.giftCertificates.allocateGiftCertificate('gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f', {\n    gift_certificate: {account: {code: 'W13ZGY'}},\n});\nconsole.log(response.data);\n"
    },
    "deallocate_gift_certificate": {
      "function": "giftCertificates.deallocateGiftCertificate",
      "code": "const response = await client.giftCertificates.deallocateGiftCertificate('gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f', {\n    gift_certificate: {account: {code: 'W13ZGY'}},\n});\nconsole.log(response.data);\n"
    },
    "get_gift_certificate_allocation": {
      "function": "giftCertificates.getGiftCertificateAllocation",
      "code": "const response = await client.giftCertificates.getGiftCertificateAllocation(\n    'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n    'gca_1d4f7a2c9e5b4083b6a1c2d3e4f5a6b7',\n);\nconsole.log(response.data);\n"
    },
    "get_gift_certificate_transaction": {
      "function": "giftCertificates.getGiftCertificateTransaction",
      "code": "const response = await client.giftCertificates.getGiftCertificateTransaction(\n    'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n    'gct_8e2c5a9f1b7d4c6e0a3b5d7f9c1e2a4b',\n);\nconsole.log(response.data);\n"
    }
  }
}
