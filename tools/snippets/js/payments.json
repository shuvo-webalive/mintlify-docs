{
  "sdk": "js",
  "module": "payments",
  "endpoints": {
    "get_payments": {
      "function": "payments.getPayments",
      "code": "const response = await client.payments.getPayments({limit: 20});\nconsole.log(response.data);\n"
    },
    "create_payment": {
      "function": "payments.createPayment",
      "code": "const response = await client.payments.createPayment({\n    payment: {\n        date: '2026-10-01',\n        payment_note: 'October invoice',\n        payment_applied: [{processor: 'Cash', amount: '10.00', reference: 'RCPT-1001'}],\n        invoices: [{id: 'INV-0001', applied: '10.00'}],\n    },\n});\nconsole.log(response.data);\n"
    },
    "get_payments_notes": {
      "function": "payments.getPaymentsNotes",
      "code": "const response = await client.payments.getPaymentsNotes({limit: 20});\nconsole.log(response.data);\n"
    },
    "delete_payment": {
      "function": "payments.deletePayment",
      "code": "const response = await client.payments.deletePayment('PAY-0001');\nconsole.log(response.data);\n"
    },
    "update_payment": {
      "function": "payments.updatePayment",
      "code": "const response = await client.payments.updatePayment('PAY-0001', {payment: {note: 'Paid at the front counter.'}});\nconsole.log(response.data);\n"
    },
    "get_payment": {
      "function": "payments.getPayment",
      "code": "const response = await client.payments.getPayment('PAY-0001');\nconsole.log(response.data);\n"
    },
    "get_invoice_payments": {
      "function": "payments.getInvoicePayments",
      "code": "const response = await client.payments.getInvoicePayments('INV-0001', {limit: 20});\nconsole.log(response.data);\n"
    },
    "get_order_payments": {
      "function": "payments.getOrderPayments",
      "code": "const response = await client.payments.getOrderPayments('ORD-0001', {limit: 20});\nconsole.log(response.data);\n"
    },
    "get_payment_notes": {
      "function": "payments.getPaymentNotes",
      "code": "const response = await client.payments.getPaymentNotes('PAY-0001', {limit: 20});\nconsole.log(response.data);\n"
    },
    "create_payment_note": {
      "function": "payments.createPaymentNote",
      "code": "import {readFileSync} from 'node:fs';\n\nconst response = await client.payments.createPaymentNote('PAY-0001', 'Customer asked for a copy by post.', {\n    files: {file: ['receipt.pdf', readFileSync('receipt.pdf')]},\n});\nconsole.log(response.data);\n"
    },
    "get_payment_note": {
      "function": "payments.getPaymentNote",
      "code": "const response = await client.payments.getPaymentNote('PAY-0001', 'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d');\nconsole.log(response.data);\n"
    },
    "delete_payment_note": {
      "function": "payments.deletePaymentNote",
      "code": "const response = await client.payments.deletePaymentNote('PAY-0001', '3f2b8c1d-9e4a-4f6b-8c2d-1e0f9a8b7c6d');\nconsole.log(response.data);\n"
    },
    "get_payment_note_file": {
      "function": "payments.getPaymentNoteFile",
      "code": "const response = await client.payments.getPaymentNoteFile(\n    'PAY-0001',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n    '6b1f0c2e-8d4a-4e3b-9f5c-2a7d1e0b3c4f',\n);\nconsole.log(response.data);\n"
    },
    "get_invoice_payment": {
      "function": "payments.getInvoicePayment",
      "code": "const response = await client.payments.getInvoicePayment('INV-0001', 'PAY-0001');\nconsole.log(response.data);\n"
    },
    "get_payment_note_files": {
      "function": "payments.getPaymentNoteFiles",
      "code": "const response = await client.payments.getPaymentNoteFiles('PAY-0001', 'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d');\nconsole.log(response.data);\n"
    }
  }
}
