{
  "sdk": "js",
  "module": "note_groups",
  "endpoints": {
    "get_note_groups": {
      "function": "noteGroups.getNoteGroups",
      "code": "const response = await client.noteGroups.getNoteGroups({limit: 20});\nconsole.log(response.data);\n"
    },
    "create_note_group": {
      "function": "noteGroups.createNoteGroup",
      "code": "const response = await client.noteGroups.createNoteGroup({\n    note_group: {name: 'Project team', note_users: [{name: 'Jane Citizen', email_address: 'jane@example.com'}]},\n});\nconsole.log(response.data);\n"
    },
    "delete_note_group": {
      "function": "noteGroups.deleteNoteGroup",
      "code": "const response = await client.noteGroups.deleteNoteGroup('2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9');\nconsole.log(response.data);\n"
    },
    "get_note_group": {
      "function": "noteGroups.getNoteGroup",
      "code": "const response = await client.noteGroups.getNoteGroup('2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9');\nconsole.log(response.data);\n"
    },
    "update_note_group": {
      "function": "noteGroups.updateNoteGroup",
      "code": "const response = await client.noteGroups.updateNoteGroup('2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9', {\n    note_group: {display_name: 'Project team (Sydney)', description: 'Notes for the Sydney project team.'},\n});\nconsole.log(response.data);\n"
    },
    "get_note_group_notes": {
      "function": "noteGroups.getNoteGroupNotes",
      "code": "const response = await client.noteGroups.getNoteGroupNotes('2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9', {limit: 20});\nconsole.log(response.data);\n"
    },
    "get_note_group_notes_by_user": {
      "function": "noteGroups.getNoteGroupNotesByUser",
      "code": "const response = await client.noteGroups.getNoteGroupNotesByUser(\n    '2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9',\n    'jane@example.com',\n    {limit: 20},\n);\nconsole.log(response.data);\n"
    }
  }
}
