    },
    "delete_proforma_invoice": {
      "function": "proformaInvoices.deleteProformaInvoice",
      "code": "const response = await client.proformaInvoices.deleteProformaInvoice('PF-0001');\nconsole.log(response.data);\n"
    },
    "create_proforma_invoice_payment": {
      "function": "proformaInvoices.createProformaInvoicePayment",
      "code": "const response = await client.proformaInvoices.createProformaInvoicePayment('PF-0001', {payment: {}});\nconsole.log(response.data);\n"
