{
  "sdk": "js",
  "module": "item_fulfillments",
  "endpoints": {
    "get_item_fulfillments": {
      "function": "itemFulfillments.getItemFulfillments",
      "code": "const response = await client.itemFulfillments.getItemFulfillments({limit: 20});\nconsole.log(response.data);\n"
    },
    "create_item_fulfillment": {
      "function": "itemFulfillments.createItemFulfillment",
      "code": "const response = await client.itemFulfillments.createItemFulfillment({\n    item_fulfillment: {\n        invoice_id: 'INV-0001',\n        fulfillments: [{invoice_line: '8e7d6c5b-4a39-4281-9706-f5e4d3c2b1a0', fulfillment_quantity: 1}],\n    },\n});\nconsole.log(response.data);\n"
    },
    "get_item_fulfillment": {
      "function": "itemFulfillments.getItemFulfillment",
      "code": "const response = await client.itemFulfillments.getItemFulfillment('ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9');\nconsole.log(response.data);\n"
    },
    "update_item_fulfillment": {
      "function": "itemFulfillments.updateItemFulfillment",
      "code": "const response = await client.itemFulfillments.updateItemFulfillment('ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9', {\n    item_fulfillment: {tracking_number: 'TRK-0001'},\n});\nconsole.log(response.data);\n"
    },
    "create_item_fulfillment_note": {
      "function": "itemFulfillments.createItemFulfillmentNote",
      "code": "import {readFileSync} from 'node:fs';\n\nconst response = await client.itemFulfillments.createItemFulfillmentNote(\n    'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n    '<p>Left with reception.</p>',\n    {files: {file: ['delivery-photo.jpg', readFileSync('delivery-photo.jpg')]}},\n);\nconsole.log(response.data);\n"
    },
    "delete_item_fulfillment": {
      "function": "itemFulfillments.deleteItemFulfillment",
      "code": "const response = await client.itemFulfillments.deleteItemFulfillment('ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9');\nconsole.log(response.data);\n"
    },
    "delete_item_fulfillment_note": {
      "function": "itemFulfillments.deleteItemFulfillmentNote",
      "code": "const response = await client.itemFulfillments.deleteItemFulfillmentNote(\n    'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n    'note_b1c2d3e4f5061728394a5b6c7d8e9f00',\n);\nconsole.log(response.data);\n"
    },
    "get_item_fulfillment_notes": {
      "function": "itemFulfillments.getItemFulfillmentNotes",
      "code": "const response = await client.itemFulfillments.getItemFulfillmentNotes('ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9', {\n    limit: 20,\n});\nconsole.log(response.data);\n"
    },
    "get_item_fulfillment_note": {
      "function": "itemFulfillments.getItemFulfillmentNote",
      "code": "const response = await client.itemFulfillments.getItemFulfillmentNote(\n    'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n    'note_b1c2d3e4f5061728394a5b6c7d8e9f00',\n);\nconsole.log(response.data);\n"
    }
  }
}
