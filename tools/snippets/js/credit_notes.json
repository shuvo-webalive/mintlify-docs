{
  "sdk": "js",
  "module": "credit_notes",
  "endpoints": {
    "get_credit_notes": {
      "function": "creditNotes.getCreditNotes",
      "code": "const response = await client.creditNotes.getCreditNotes({limit: 20});\nconsole.log(response.data);\n"
    },
    "get_credit_note": {
      "function": "creditNotes.getCreditNote",
      "code": "const response = await client.creditNotes.getCreditNote('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d');\nconsole.log(response.data);\n"
    },
    "update_credit_note": {
      "function": "creditNotes.updateCreditNote",
      "code": "const response = await client.creditNotes.updateCreditNote('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d', {\n    credit_note: {custom_attributes: []},\n});\nconsole.log(response.data);\n"
    },
    "create_credit_note": {
      "function": "creditNotes.createCreditNote",
      "code": "const response = await client.creditNotes.createCreditNote({credit_note: {invoice_id: 'INV-0001', amount: 5}});\nconsole.log(response.data);\n"
    },
    "delete_credit_note": {
      "function": "creditNotes.deleteCreditNote",
      "code": "const response = await client.creditNotes.deleteCreditNote('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d');\nconsole.log(response.data);\n"
    },
    "apply_credit_note": {
      "function": "creditNotes.applyCreditNote",
      "code": "const response = await client.creditNotes.applyCreditNote('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d', {\n    credit_note: {invoices: [{invoice_id: 'INV-0001', amount: 5}]},\n});\nconsole.log(response.data);\n"
    },
    "get_credit_note_items": {
      "function": "creditNotes.getCreditNoteItems",
      "code": "const response = await client.creditNotes.getCreditNoteItems('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d');\nconsole.log(response.data);\n"
    },
    "get_credit_note_credit_note_applications": {
      "function": "creditNotes.getCreditNoteCreditNoteApplications",
      "code": "const response = await client.creditNotes.getCreditNoteCreditNoteApplications('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d');\nconsole.log(response.data);\n"
    },
    "get_credit_note_notes": {
      "function": "creditNotes.getCreditNoteNotes",
      "code": "const response = await client.creditNotes.getCreditNoteNotes('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d', {limit: 20});\nconsole.log(response.data);\n"
    },
    "get_credit_note_note": {
      "function": "creditNotes.getCreditNoteNote",
      "code": "const response = await client.creditNotes.getCreditNoteNote(\n    'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n);\nconsole.log(response.data);\n"
    },
    "create_credit_note_note": {
      "function": "creditNotes.createCreditNoteNote",
      "code": "import {readFileSync} from 'node:fs';\n\nconst response = await client.creditNotes.createCreditNoteNote(\n    'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n    'Customer asked for a copy by post.',\n    {files: {file: ['receipt.pdf', readFileSync('receipt.pdf')]}},\n);\nconsole.log(response.data);\n"
    },
    "delete_credit_note_note": {
      "function": "creditNotes.deleteCreditNoteNote",
      "code": "const response = await client.creditNotes.deleteCreditNoteNote(\n    'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n);\nconsole.log(response.data);\n"
    },
    "get_credit_note_note_files": {
      "function": "creditNotes.getCreditNoteNoteFiles",
      "code": "const response = await client.creditNotes.getCreditNoteNoteFiles(\n    'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n);\nconsole.log(response.data);\n"
    },
    "get_credit_note_note_file": {
      "function": "creditNotes.getCreditNoteNoteFile",
      "code": "const response = await client.creditNotes.getCreditNoteNoteFile(\n    'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n    '6b1f0c2e-8d4a-4e3b-9f5c-2a7d1e0b3c4f',\n);\nconsole.log(response.data);\n"
    }
