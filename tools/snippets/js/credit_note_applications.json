{
  "sdk": "js",
  "module": "credit_note_applications",
  "endpoints": {
    "get_credit_note_applications": {
      "function": "creditNoteApplications.getCreditNoteApplications",
      "code": "const response = await client.creditNoteApplications.getCreditNoteApplications({limit: 20});\nconsole.log(response.data);\n"
    },
    "get_credit_note_application": {
      "function": "creditNoteApplications.getCreditNoteApplication",
      "code": "const response = await client.creditNoteApplications.getCreditNoteApplication('CNA-0001');\nconsole.log(response.data);\n"
    },
    "get_invoice_credit_note_applications": {
      "function": "creditNoteApplications.getInvoiceCreditNoteApplications",
      "code": "const response = await client.creditNoteApplications.getInvoiceCreditNoteApplications('INV-0001', {limit: 20});\nconsole.log(response.data);\n"
    }
  }
}
