      "code": "const response = await client.purchaseRefunds.createPurchaseCreditNotePurchaseRefund(\n    'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n    {\n        purchase_refund: {\n            amount: '0.50',\n            payment_method: 'Acme Pty Ltd bank account',\n            reference: 'REF-1001',\n            note: 'Refund for returned stock.',\n        },\n    },\n);\nconsole.log(response.data);\n"
    },
