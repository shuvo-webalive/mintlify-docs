{
  "sdk": "php",
  "module": "charging_periods",
  "endpoints": {
    "get_settings_charging_periods": {
      "function": "getSettingsChargingPeriods",
      "code": "$response = $client->chargingPeriods->getSettingsChargingPeriods(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_charging_period": {
      "function": "createSettingsChargingPeriod",
      "code": "$response = $client->chargingPeriods->createSettingsChargingPeriod([\n    'charging_period' => [\n        'name' => 'Monthly charge',\n        'display_name' => 'Monthly charge',\n        'time_period' => 'tp_2b1b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_charging_period": {
      "function": "getSettingsChargingPeriod",
      "code": "$response = $client->chargingPeriods->getSettingsChargingPeriod(\n    'cp_171b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint_r($response->data);\n"
    },
    "delete_settings_charging_period": {
      "function": "deleteSettingsChargingPeriod",
      "code": "$response = $client->chargingPeriods->deleteSettingsChargingPeriod(\n    'cp_171b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint_r($response->data);\n"
    },
    "update_settings_charging_period": {
      "function": "updateSettingsChargingPeriod",
      "code": "$response = $client->chargingPeriods->updateSettingsChargingPeriod(\n    'cp_171b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n    [\n        'charging_period' => [\n            'display_name' => 'Monthly charge (AU)',\n            'description' => 'Charges once a month',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
