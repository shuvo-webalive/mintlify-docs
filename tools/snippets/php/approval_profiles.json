{
  "sdk": "php",
  "module": "approval_profiles",
  "endpoints": {
    "get_settings_approval_profiles": {
      "function": "getSettingsApprovalProfiles",
      "code": "$response = $client->approvalProfiles->getSettingsApprovalProfiles(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_approval_profile": {
      "function": "createSettingsApprovalProfile",
      "code": "$response = $client->approvalProfiles->createSettingsApprovalProfile([\n    'approval_profile' => [\n        'name' => 'Account approval',\n        'entity' => 'account',\n        'event' => '<event name>',\n        'approver_type' => '<approver type>',\n        'approver' => '<approver>',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_approval_profile": {
      "function": "getSettingsApprovalProfile",
      "code": "$response = $client->approvalProfiles->getSettingsApprovalProfile(\n    'ap_0c2e4a6b8d1f4c3e5a7b9d0f2a4c6e8b',\n);\nprint_r($response->data);\n"
    },
    "delete_settings_approval_profile": {
      "function": "deleteSettingsApprovalProfile",
      "code": "$response = $client->approvalProfiles->deleteSettingsApprovalProfile(\n    'ap_0c2e4a6b8d1f4c3e5a7b9d0f2a4c6e8b',\n);\nprint_r($response->data);\n"
    },
    "update_settings_approval_profile": {
      "function": "updateSettingsApprovalProfile",
      "code": "$response = $client->approvalProfiles->updateSettingsApprovalProfile(\n    'ap_0c2e4a6b8d1f4c3e5a7b9d0f2a4c6e8b',\n    ['approval_profile' => ['display_name' => 'Large order approval (finance)']],\n);\nprint_r($response->data);\n"
    }
  }
}
