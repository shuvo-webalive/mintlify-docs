{
  "sdk": "php",
  "module": "purchase_credit_notes",
  "endpoints": {
    "get_purchase_credit_notes": {
      "function": "getPurchaseCreditNotes",
      "code": "$response = $client->purchaseCreditNotes->getPurchaseCreditNotes(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "get_purchase_credit_note": {
      "function": "getPurchaseCreditNote",
      "code": "$response = $client->purchaseCreditNotes->getPurchaseCreditNote(\n    'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n);\nprint_r($response->data);\n"
    },
    "update_purchase_credit_note": {
      "function": "updatePurchaseCreditNote",
      "code": "$response = $client->purchaseCreditNotes->updatePurchaseCreditNote(\n    'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n    ['purchase_credit_note' => ['custom_attributes' => []]],\n);\nprint_r($response->data);\n"
    },
    "create_purchase_credit_note": {
      "function": "createPurchaseCreditNote",
      "code": "$response = $client->purchaseCreditNotes->createPurchaseCreditNote([\n    'purchase_credit_note' => ['purchase_invoice_id' => 'PI-0001', 'amount' => '1.00'],\n]);\nprint_r($response->data);\n"
    },
    "delete_purchase_credit_note": {
      "function": "deletePurchaseCreditNote",
      "code": "$response = $client->purchaseCreditNotes->deletePurchaseCreditNote(\n    'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n);\nprint_r($response->data);\n"
    },
    "apply_purchase_credit_note": {
      "function": "applyPurchaseCreditNote",
      "code": "$response = $client->purchaseCreditNotes->applyPurchaseCreditNote(\n    'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n    [\n        'purchase_credit_note' => [\n            'purchase_invoices' => [['purchase_invoice_id' => 'PI-0001', 'amount' => '1.00']],\n        ],\n    ],\n);\nprint_r($response->data);\n"
    },
    "create_purchase_credit_note_note": {
      "function": "createPurchaseCreditNoteNote",
      "code": "$response = $client->purchaseCreditNotes->createPurchaseCreditNoteNote(\n    'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n    '<p>Credit agreed with supplier.</p>',\n    ['file' => ['delivery-note.pdf', fopen('delivery-note.pdf', 'r')]],\n);\nprint_r($response->data);\n"
    },
    "delete_purchase_credit_note_note": {
      "function": "deletePurchaseCreditNoteNote",
      "code": "$response = $client->purchaseCreditNotes->deletePurchaseCreditNoteNote(\n    'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n    'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n);\nprint_r($response->data);\n"
    }
  }
}
