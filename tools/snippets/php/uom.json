    },
    "get_settings_uom": {
      "function": "getSettingsUom",
      "code": "$response = $client->uom->getSettingsUom('uom_1a2b3c4d5e6f708192a3b4c5d6e7f809');\nprint_r($response->data);\n"
    },
    "delete_settings_uom": {
      "function": "deleteSettingsUom",
      "code": "$response = $client->uom->deleteSettingsUom('uom_1a2b3c4d5e6f708192a3b4c5d6e7f809');\nprint_r($response->data);\n"
    },
    "update_settings_uom": {
      "function": "updateSettingsUom",
      "code": "$response = $client->uom->updateSettingsUom('uom_1a2b3c4d5e6f708192a3b4c5d6e7f809', [\n    'uom' => ['display_name' => 'Centimetre', 'description' => 'Metric length unit'],\n]);\nprint_r($response->data);\n"
