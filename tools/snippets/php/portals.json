{
  "sdk": "php",
  "module": "portals",
  "endpoints": {
    "activate_portal": {
      "function": "activatePortal",
      "code": "$response = $client->portals->activatePortal(['portal' => ['code' => 'abc123def456']]);\nprint_r($response->data);\n"
    },
    "create_portal_change_password": {
      "function": "createPortalChangePassword",
      "code": "$response = $client->portals->createPortalChangePassword([\n    'portal' => [\n        'email' => 'jane@example.com',\n        'current_password' => 'OldPassw0rd!',\n        'new_password' => 'NewPassw0rd!',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "create_portal_login": {
      "function": "createPortalLogin",
      "code": "$response = $client->portals->createPortalLogin([\n    'portal' => ['email' => 'jane@example.com', 'password' => 'Passw0rd!'],\n]);\nprint_r($response->data);\n"
    },
    "create_portal_reset": {
      "function": "createPortalReset",
      "code": "$response = $client->portals->createPortalReset([\n    'portal' => [\n        'code' => 'abc123def456',\n        'email' => 'jane@example.com',\n        'password' => 'NewPassw0rd!',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "create_portal_reset_link": {
      "function": "createPortalResetLink",
      "code": "$response = $client->portals->createPortalResetLink(['portal' => ['email' => 'jane@example.com']]);\nprint_r($response->data);\n"
    },
    "create_portal_validate": {
      "function": "createPortalValidate",
      "code": "$response = $client->portals->createPortalValidate(['portal' => ['code' => 'abc123def456']]);\nprint_r($response->data);\n"
    },
    "set_portal_password": {
      "function": "setPortalPassword",
      "code": "$response = $client->portals->setPortalPassword([\n    'portal' => ['email' => 'jane@example.com', 'password' => 'NewPassw0rd!'],\n]);\nprint_r($response->data);\n"
    }
  }
}
