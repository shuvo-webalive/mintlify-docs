{
  "sdk": "php",
  "module": "document_templates",
  "endpoints": {
    "get_settings_document_templates": {
      "function": "getSettingsDocumentTemplates",
      "code": "$response = $client->documentTemplates->getSettingsDocumentTemplates(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_document_template": {
      "function": "createSettingsDocumentTemplate",
      "code": "$response = $client->documentTemplates->createSettingsDocumentTemplate([\n    'document_template' => ['name' => 'Invoice layout', 'document_template_type' => 'PDF_DOCUMENT'],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_document_template": {
      "function": "getSettingsDocumentTemplate",
      "code": "$response = $client->documentTemplates->getSettingsDocumentTemplate(\n    'dt_a9df2cf857f5eadf952194e93c27c13e',\n);\nprint_r($response->data);\n"
    },
    "delete_settings_document_template": {
      "function": "deleteSettingsDocumentTemplate",
      "code": "$response = $client->documentTemplates->deleteSettingsDocumentTemplate(\n    'dt_a9df2cf857f5eadf952194e93c27c13e',\n);\nprint_r($response->data);\n"
    },
    "update_settings_document_template": {
      "function": "updateSettingsDocumentTemplate",
      "code": "$response = $client->documentTemplates->updateSettingsDocumentTemplate(\n    'dt_a9df2cf857f5eadf952194e93c27c13e',\n    [\n        'document_template' => [\n            'display_name' => 'Invoice layout (AU)',\n            'description' => 'Layout for Australian invoices',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
