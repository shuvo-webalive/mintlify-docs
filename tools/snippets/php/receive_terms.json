{
  "sdk": "php",
  "module": "receive_terms",
  "endpoints": {
    "get_settings_receive_terms": {
      "function": "getSettingsReceiveTerms",
      "code": "$response = $client->receiveTerms->getSettingsReceiveTerms(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_receive_term": {
      "function": "createSettingsReceiveTerm",
      "code": "$response = $client->receiveTerms->createSettingsReceiveTerm([\n    'receive_term' => [\n        'name' => 'net-30',\n        'display_name' => 'Net 30',\n        'period' => 'MONTHLY',\n        'duration' => 1,\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_receive_term": {
      "function": "getSettingsReceiveTerm",
      "code": "$response = $client->receiveTerms->getSettingsReceiveTerm('RT-0001');\nprint_r($response->data);\n"
    },
    "delete_settings_receive_term": {
      "function": "deleteSettingsReceiveTerm",
      "code": "$response = $client->receiveTerms->deleteSettingsReceiveTerm('RT-0001');\nprint_r($response->data);\n"
    },
    "update_settings_receive_term": {
      "function": "updateSettingsReceiveTerm",
      "code": "$response = $client->receiveTerms->updateSettingsReceiveTerm('RT-0001', [\n    'receive_term' => [\n        'display_name' => 'Net 30 days',\n        'description' => 'Goods received within one month.',\n    ],\n]);\nprint_r($response->data);\n"
    }
  }
}
