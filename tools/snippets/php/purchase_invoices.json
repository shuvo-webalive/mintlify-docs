    },
    "delete_purchase_invoice_note": {
      "function": "deletePurchaseInvoiceNote",
      "code": "$response = $client->purchaseInvoices->deletePurchaseInvoiceNote(\n    'PI-0001',\n    'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n);\nprint_r($response->data);\n"
    },
    "get_purchase_invoice_note_files": {
      "function": "getPurchaseInvoiceNoteFiles",
      "code": "$response = $client->purchaseInvoices->getPurchaseInvoiceNoteFiles(\n    'PI-0001',\n    'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n    ['limit' => 20],\n);\nprint_r($response->data);\n"
    },
    "get_purchase_invoice_note_file": {
      "function": "getPurchaseInvoiceNoteFile",
      "code": "$response = $client->purchaseInvoices->getPurchaseInvoiceNoteFile(\n    'PI-0001',\n    'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n    '6b2c1d0e-4f3a-4b5c-8d9e-0f1a2b3c4d5e',\n);\nprint_r($response->data);\n"
    },
    "get_purchase_invoice_purchase_credit_note_application": {
