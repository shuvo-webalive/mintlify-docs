      "code": "$response = $client->purchaseInvoices->getPurchaseInvoiceLine(\n    'PI-0001',\n    '3f2a9c1e-7b4d-4e8a-9c0b-1d2e3f4a5b6c',\n);\nprint_r($response->data);\n"
    },
    "update_purchase_invoice_note": {
      "function": "updatePurchaseInvoiceNote",
      "code": "$response = $client->purchaseInvoices->updatePurchaseInvoiceNote(\n    'PI-0001',\n    'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n    '<p>Goods received in full.</p>',\n    ['file' => ['delivery-note.pdf', fopen('delivery-note.pdf', 'r')]],\n);\nprint_r($response->data);\n"
    },
