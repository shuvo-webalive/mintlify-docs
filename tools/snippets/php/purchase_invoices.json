{
  "sdk": "php",
  "module": "purchase_invoices",
  "endpoints": {
    "get_purchase_invoices": {
      "function": "getPurchaseInvoices",
      "code": "$response = $client->purchaseInvoices->getPurchaseInvoices(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_purchase_invoice": {
      "function": "createPurchaseInvoice",
      "code": "$response = $client->purchaseInvoices->createPurchaseInvoice([\n    'purchase_invoice' => [\n        'account_id' => 'W13ZGY',\n        'lines' => [\n            [\n                'item_name' => 'Copy paper A4',\n                'item_quantity' => 1,\n                'item_price_snapshot' => ['pricing_rule' => ['price' => 5]],\n            ],\n        ],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_purchase_invoices_notes": {
      "function": "getPurchaseInvoicesNotes",
      "code": "$response = $client->purchaseInvoices->getPurchaseInvoicesNotes(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "delete_purchase_invoice": {
      "function": "deletePurchaseInvoice",
      "code": "$response = $client->purchaseInvoices->deletePurchaseInvoice('PI-0001');\nprint_r($response->data);\n"
    },
    "get_purchase_invoice": {
      "function": "getPurchaseInvoice",
      "code": "$response = $client->purchaseInvoices->getPurchaseInvoice('PI-0001');\nprint_r($response->data);\n"
    },
    "amend_purchase_invoice": {
      "function": "amendPurchaseInvoice",
      "code": "$response = $client->purchaseInvoices->amendPurchaseInvoice('PI-0001', [\n    'purchase_invoice' => [\n        'lines' => [['op' => 'add', 'item_id' => 'ITEM-0001', 'item_quantity' => 1]],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "cancel_purchase_invoice": {
      "function": "cancelPurchaseInvoice",
      "code": "$response = $client->purchaseInvoices->cancelPurchaseInvoice('PI-0001', '{}');\nprint_r($response->data);\n"
    },
    "get_purchase_invoice_information": {
      "function": "getPurchaseInvoiceInformation",
      "code": "$response = $client->purchaseInvoices->getPurchaseInvoiceInformation('PI-0001');\nprint_r($response->data);\n"
    },
    "update_purchase_invoice_information": {
      "function": "updatePurchaseInvoiceInformation",
      "code": "$response = $client->purchaseInvoices->updatePurchaseInvoiceInformation('PI-0001', [\n    'purchase_invoice' => ['origin' => 'Supplier portal'],\n]);\nprint_r($response->data);\n"
    },
    "get_purchase_invoice_lines": {
      "function": "getPurchaseInvoiceLines",
      "code": "$response = $client->purchaseInvoices->getPurchaseInvoiceLines('PI-0001', ['limit' => 20]);\nprint_r($response->data);\n"
    },
