    },
    "create_purchase_invoice_note": {
      "function": "createPurchaseInvoiceNote",
      "code": "$response = $client->purchaseInvoices->createPurchaseInvoiceNote(\n    'PI-0001',\n    '<p>Goods received in full.</p>',\n    ['file' => ['delivery-note.pdf', fopen('delivery-note.pdf', 'r')]],\n);\nprint_r($response->data);\n"
    },
    "get_purchase_invoice_purchase_credit_note_applications": {
