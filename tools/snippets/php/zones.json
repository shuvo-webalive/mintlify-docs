{
  "sdk": "php",
  "module": "zones",
  "endpoints": {
    "get_settings_zones": {
      "function": "getSettingsZones",
      "code": "$response = $client->zones->getSettingsZones(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_zone": {
      "function": "createSettingsZone",
      "code": "$response = $client->zones->createSettingsZone([\n    'zone' => [\n        'name' => 'Australia and New Zealand',\n        'country_list' => ['country_4f3e2d1c0b0a99887766554433221100'],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_zone": {
      "function": "getSettingsZone",
      "code": "$response = $client->zones->getSettingsZone('zn_0a1b2c3d4e5f60718293a4b5c6d7e8f9');\nprint_r($response->data);\n"
    },
    "delete_settings_zone": {
      "function": "deleteSettingsZone",
      "code": "$response = $client->zones->deleteSettingsZone('zn_0a1b2c3d4e5f60718293a4b5c6d7e8f9');\nprint_r($response->data);\n"
    },
    "update_settings_zone": {
      "function": "updateSettingsZone",
      "code": "$response = $client->zones->updateSettingsZone('zn_0a1b2c3d4e5f60718293a4b5c6d7e8f9', [\n    'zone' => ['display_name' => 'ANZ', 'description' => 'Australia and New Zealand'],\n]);\nprint_r($response->data);\n"
    }
  }
}
