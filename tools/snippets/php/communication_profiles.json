{
  "sdk": "php",
  "module": "communication_profiles",
  "endpoints": {
    "get_settings_communication_profiles": {
      "function": "getSettingsCommunicationProfiles",
      "code": "$response = $client->communicationProfiles->getSettingsCommunicationProfiles(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_communication_profile": {
      "function": "createSettingsCommunicationProfile",
      "code": "$response = $client->communicationProfiles->createSettingsCommunicationProfile([\n    'communication_profile' => ['name' => 'Wholesale notices'],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_communication_profile": {
      "function": "getSettingsCommunicationProfile",
      "code": "$response = $client->communicationProfiles->getSettingsCommunicationProfile(\n    'cmp_7b2d9e4a1c6f4b8d9a3e5c1f2b4d6a8e',\n);\nprint_r($response->data);\n"
    },
    "delete_settings_communication_profile": {
      "function": "deleteSettingsCommunicationProfile",
      "code": "$response = $client->communicationProfiles->deleteSettingsCommunicationProfile(\n    'cmp_7b2d9e4a1c6f4b8d9a3e5c1f2b4d6a8e',\n);\nprint_r($response->data);\n"
    },
    "update_settings_communication_profile": {
      "function": "updateSettingsCommunicationProfile",
      "code": "$response = $client->communicationProfiles->updateSettingsCommunicationProfile(\n    'cmp_7b2d9e4a1c6f4b8d9a3e5c1f2b4d6a8e',\n    [\n        'communication_profile' => [\n            'display_name' => 'Wholesale notices',\n            'description' => 'Messages for wholesale accounts',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
