{
  "sdk": "php",
  "module": "employees",
  "endpoints": {
    "get_employees": {
      "function": "getEmployees",
      "code": "$response = $client->employees->getEmployees(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_employee": {
      "function": "createEmployee",
      "code": "$response = $client->employees->createEmployee(['employee' => ['name' => 'Jane Citizen']]);\nprint_r($response->data);\n"
    },
    "delete_employee": {
      "function": "deleteEmployee",
      "code": "$response = $client->employees->deleteEmployee('emp_7b3c9d1e2f4a4b5c8d6e7f8091a2b3c4');\nprint_r($response->data);\n"
    },
    "get_employee": {
      "function": "getEmployee",
      "code": "$response = $client->employees->getEmployee('emp_7b3c9d1e2f4a4b5c8d6e7f8091a2b3c4');\nprint_r($response->data);\n"
    },
    "update_employee": {
      "function": "updateEmployee",
      "code": "$response = $client->employees->updateEmployee('emp_7b3c9d1e2f4a4b5c8d6e7f8091a2b3c4', [\n    'employee' => ['description' => 'Senior technician'],\n]);\nprint_r($response->data);\n"
    }
  }
}
