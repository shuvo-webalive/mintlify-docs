{
  "sdk": "php",
  "module": "countries",
  "endpoints": {
    "get_settings_countries": {
      "function": "getSettingsCountries",
      "code": "$response = $client->countries->getSettingsCountries(['limit' => 100]);\nprint_r($response->data);\n"
    },
    "get_settings_country": {
      "function": "getSettingsCountry",
      "code": "$response = $client->countries->getSettingsCountry('country_e909c2d7067ea37437cf97fe11d91bd0');\nprint_r($response->data);\n"
    },
    "update_settings_country": {
      "function": "updateSettingsCountry",
      "code": "$response = $client->countries->updateSettingsCountry('country_e909c2d7067ea37437cf97fe11d91bd0', [\n    'country' => ['description' => 'Antarctica'],\n]);\nprint_r($response->data);\n"
    }
  }
}
