{
  "sdk": "php",
  "module": "countries",
  "endpoints": {
    "get_settings_countries": {
      "function": "getSettingsCountries",
      "code": "$response = $client->countries->getSettingsCountries(['limit' => 100]);\nprint_r($response->data);\n"
    },
    "get_settings_country": {
      "function": "getSettingsCountry",
      "code": "$response = $client->countries->getSettingsCountry('country_111b2c3d4e5f4a6b8c7d9e0f1a2b3c4d');\nprint_r($response->data);\n"
    },
    "update_settings_country": {
      "function": "updateSettingsCountry",
      "code": "$response = $client->countries->updateSettingsCountry('country_111b2c3d4e5f4a6b8c7d9e0f1a2b3c4d', [\n    'country' => ['description' => 'Antarctica'],\n]);\nprint_r($response->data);\n"
    }
  }
