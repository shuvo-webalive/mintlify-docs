{
  "sdk": "php",
  "module": "roles",
  "endpoints": {
    "get_settings_roles": {
      "function": "getSettingsRoles",
      "code": "$response = $client->roles->getSettingsRoles(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_role": {
      "function": "createSettingsRole",
      "code": "$response = $client->roles->createSettingsRole(['role' => ['name' => 'Support staff']]);\nprint_r($response->data);\n"
    },
    "get_settings_role": {
      "function": "getSettingsRole",
      "code": "$response = $client->roles->getSettingsRole('201b2c3d4e5f4a6b8c7d9e0f1a2b3c4d');\nprint_r($response->data);\n"
    },
    "delete_settings_role": {
      "function": "deleteSettingsRole",
      "code": "$response = $client->roles->deleteSettingsRole('201b2c3d4e5f4a6b8c7d9e0f1a2b3c4d');\nprint_r($response->data);\n"
    },
    "update_settings_role": {
      "function": "updateSettingsRole",
      "code": "$response = $client->roles->updateSettingsRole('201b2c3d4e5f4a6b8c7d9e0f1a2b3c4d', [\n    'role' => ['display_name' => 'Support staff (AU)'],\n]);\nprint_r($response->data);\n"
    }
  }
