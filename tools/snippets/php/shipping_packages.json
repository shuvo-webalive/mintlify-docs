{
  "sdk": "php",
  "module": "shipping_packages",
  "endpoints": {
    "get_settings_shipping_packages": {
      "function": "getSettingsShippingPackages",
      "code": "$response = $client->shippingPackages->getSettingsShippingPackages(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_shipping_package": {
      "function": "createSettingsShippingPackage",
      "code": "$response = $client->shippingPackages->createSettingsShippingPackage([\n    'shipping_package' => ['name' => 'Small box', 'length' => 10, 'weight' => 1.5],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_shipping_package": {
      "function": "getSettingsShippingPackage",
      "code": "$response = $client->shippingPackages->getSettingsShippingPackage(\n    'sp_2b3c4d5e6f708192a3b4c5d6e7f8091a',\n);\nprint_r($response->data);\n"
    },
    "delete_settings_shipping_package": {
      "function": "deleteSettingsShippingPackage",
      "code": "$response = $client->shippingPackages->deleteSettingsShippingPackage(\n    'sp_2b3c4d5e6f708192a3b4c5d6e7f8091a',\n);\nprint_r($response->data);\n"
    },
    "update_settings_shipping_package": {
      "function": "updateSettingsShippingPackage",
      "code": "$response = $client->shippingPackages->updateSettingsShippingPackage(\n    'sp_2b3c4d5e6f708192a3b4c5d6e7f8091a',\n    ['shipping_package' => ['display_name' => 'Small box', 'description' => 'Up to 2 kg']],\n);\nprint_r($response->data);\n"
    }
  }
}
