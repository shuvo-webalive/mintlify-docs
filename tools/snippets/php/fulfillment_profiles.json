{
  "sdk": "php",
  "module": "fulfillment_profiles",
  "endpoints": {
    "get_settings_fulfillment_profiles": {
      "function": "getSettingsFulfillmentProfiles",
      "code": "$response = $client->fulfillmentProfiles->getSettingsFulfillmentProfiles(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_fulfillment_profile": {
      "function": "createSettingsFulfillmentProfile",
      "code": "$response = $client->fulfillmentProfiles->createSettingsFulfillmentProfile([\n    'fulfillment_profile' => [\n        'name' => 'Standard fulfillment',\n        'statuses' => [['name' => 'Open', 'status_index' => 0]],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_fulfillment_profile": {
      "function": "getSettingsFulfillmentProfile",
      "code": "$response = $client->fulfillmentProfiles->getSettingsFulfillmentProfile(\n    'fp_5d6e7f8091a2b3c4d5e6f708192a3b4c',\n);\nprint_r($response->data);\n"
    },
    "delete_settings_fulfillment_profile": {
      "function": "deleteSettingsFulfillmentProfile",
      "code": "$response = $client->fulfillmentProfiles->deleteSettingsFulfillmentProfile(\n    'fp_5d6e7f8091a2b3c4d5e6f708192a3b4c',\n);\nprint_r($response->data);\n"
    },
    "update_settings_fulfillment_profile": {
      "function": "updateSettingsFulfillmentProfile",
      "code": "$response = $client->fulfillmentProfiles->updateSettingsFulfillmentProfile(\n    'fp_5d6e7f8091a2b3c4d5e6f708192a3b4c',\n    [\n        'fulfillment_profile' => [\n            'display_name' => 'Standard fulfillment',\n            'description' => 'Open, packed and sent',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
