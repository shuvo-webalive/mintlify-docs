{
  "sdk": "php",
  "module": "custom_features",
  "endpoints": {
    "get_custom_features": {
      "function": "getCustomFeatures",
      "code": "$response = $client->customFeatures->getCustomFeatures(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "get_custom_feature_by_id": {
      "function": "getCustomFeatureById",
      "code": "$response = $client->customFeatures->getCustomFeatureById('cmp_4b7d2e9a1c3f4e8a9b6d5c2e1f0a3b7d');\nprint_r($response->data);\n"
    },
    "create_custom_feature": {
      "function": "createCustomFeature",
      "code": "$response = $client->customFeatures->createCustomFeature([\n    'component' => [\n        'name' => 'service_contract',\n        'display_name' => 'Service contract',\n        'use_in' => 'account',\n        'relation' => 'ONE_TO_MANY',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "delete_custom_feature_by_id": {
      "function": "deleteCustomFeatureById",
      "code": "$response = $client->customFeatures->deleteCustomFeatureById(\n    'cmp_4b7d2e9a1c3f4e8a9b6d5c2e1f0a3b7d',\n);\nprint_r($response->data);\n"
    },
    "update_custom_feature_by_id": {
      "function": "updateCustomFeatureById",
      "code": "$response = $client->customFeatures->updateCustomFeatureById(\n    'cmp_4b7d2e9a1c3f4e8a9b6d5c2e1f0a3b7d',\n    [\n        'component' => [\n            'display_name' => 'Service contract (updated)',\n            'description' => 'Support contracts held by Acme Pty Ltd',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    },
    "create_custom_feature_by_id": {
      "function": "createCustomFeatureById",
      "code": "$response = $client->customFeatures->createCustomFeatureById(\n    'cmp_4b7d2e9a1c3f4e8a9b6d5c2e1f0a3b7d',\n    [\n        'configuration' => [\n            'settings' => ['form_layout' => 'TWO_COLS'],\n            'column_1' => [\n                'attributes' => [\n                    [\n                        'type' => 'ATTRIBUTE',\n                        'name' => 'contract_tier',\n                        'required' => 'false',\n                        'show_in_list_view' => 'true',\n                    ],\n                ],\n            ],\n            'column_2' => ['attributes' => [['type' => 'LABEL', 'name' => 'Contract details']]],\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
