{
  "sdk": "php",
  "module": "purchase_payments",
  "endpoints": {
    "get_purchase_payments": {
      "function": "getPurchasePayments",
      "code": "$response = $client->purchasePayments->getPurchasePayments(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_purchase_payment": {
      "function": "createPurchasePayment",
      "code": "$response = $client->purchasePayments->createPurchasePayment([\n    'purchase_payment' => [\n        'payment_method_applications' => [['amount' => '1.00', 'payment_processor' => 'PROC-0001']],\n        'purchase_invoice_applications' => [['purchase_invoice' => 'PI-0001', 'amount' => '1.00']],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "delete_purchase_payment": {
      "function": "deletePurchasePayment",
      "code": "$response = $client->purchasePayments->deletePurchasePayment('PP-0001');\nprint_r($response->data);\n"
    },
    "get_purchase_payment": {
      "function": "getPurchasePayment",
      "code": "$response = $client->purchasePayments->getPurchasePayment('PP-0001');\nprint_r($response->data);\n"
    },
    "update_purchase_payment": {
      "function": "updatePurchasePayment",
      "code": "$response = $client->purchasePayments->updatePurchasePayment('PP-0001', [\n    'purchase_payment' => ['payment_note' => 'Paid by bank transfer.'],\n]);\nprint_r($response->data);\n"
    },
    "create_purchase_invoice_purchase_payment": {
      "function": "createPurchaseInvoicePurchasePayment",
      "code": "$response = $client->purchasePayments->createPurchaseInvoicePurchasePayment('PI-0001', [\n    'purchase_payment' => [\n        'payment_method_applications' => [['amount' => '1.00', 'payment_processor' => 'PROC-0001']],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_purchase_payment_notes": {
      "function": "getPurchasePaymentNotes",
      "code": "$response = $client->purchasePayments->getPurchasePaymentNotes('PP-0001', ['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_purchase_payment_note": {
      "function": "createPurchasePaymentNote",
      "code": "$response = $client->purchasePayments->createPurchasePaymentNote(\n    'PP-0001',\n    '<p>Goods received in full.</p>',\n    ['file' => ['delivery-note.pdf', fopen('delivery-note.pdf', 'r')]],\n);\nprint_r($response->data);\n"
    },
    "get_purchase_payment_note": {
      "function": "getPurchasePaymentNote",
      "code": "$response = $client->purchasePayments->getPurchasePaymentNote(\n    'PP-0001',\n    'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n);\nprint_r($response->data);\n"
    },
    "delete_purchase_payment_note": {
      "function": "deletePurchasePaymentNote",
      "code": "$response = $client->purchasePayments->deletePurchasePaymentNote(\n    'PP-0001',\n    'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n);\nprint_r($response->data);\n"
    },
    "get_purchase_payment_note_files": {
      "function": "getPurchasePaymentNoteFiles",
      "code": "$response = $client->purchasePayments->getPurchasePaymentNoteFiles(\n    'PP-0001',\n    'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n    ['limit' => 20],\n);\nprint_r($response->data);\n"
    },
    "get_purchase_payment_note_file": {
      "function": "getPurchasePaymentNoteFile",
      "code": "$response = $client->purchasePayments->getPurchasePaymentNoteFile(\n    'PP-0001',\n    'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n    '6b2c1d0e-4f3a-4b5c-8d9e-0f1a2b3c4d5e',\n);\nprint_r($response->data);\n"
    },
    "get_purchase_payment_purchase_credit_notes": {
      "function": "getPurchasePaymentPurchaseCreditNotes",
      "code": "$response = $client->purchasePayments->getPurchasePaymentPurchaseCreditNotes('PP-0001', [\n    'limit' => 20,\n]);\nprint_r($response->data);\n"
    },
    "update_purchase_payment_note": {
      "function": "updatePurchasePaymentNote",
      "code": "$response = $client->purchasePayments->updatePurchasePaymentNote(\n    'PP-0001',\n    'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n    '<p>Goods received in full.</p>',\n    ['file' => ['delivery-note.pdf', fopen('delivery-note.pdf', 'r')]],\n);\nprint_r($response->data);\n"
    },
    "delete_purchase_payment_note_file": {
      "function": "deletePurchasePaymentNoteFile",
      "code": "$response = $client->purchasePayments->deletePurchasePaymentNoteFile(\n    'PP-0001',\n    'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n    '6b2c1d0e-4f3a-4b5c-8d9e-0f1a2b3c4d5e',\n);\nprint_r($response->data);\n"
    }
  }
}
