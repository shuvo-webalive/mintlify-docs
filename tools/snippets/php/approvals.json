{
  "sdk": "php",
  "module": "approvals",
  "endpoints": {
    "get_approvals_account": {
      "function": "getApprovalsAccount",
      "code": "$response = $client->approvals->getApprovalsAccount(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "get_approvals_saleorder": {
      "function": "getApprovalsSaleorder",
      "code": "$response = $client->approvals->getApprovalsSaleorder(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "get_approvals_account_by_uuid": {
      "function": "getApprovalsAccountByUuid",
      "code": "$response = $client->approvals->getApprovalsAccountByUuid('1a3c5e7b-9d2f-4b6d-8f0a-2c4e6b8d0f1a');\nprint_r($response->data);\n"
    },
    "approve_approval": {
      "function": "approveApproval",
      "code": "$response = $client->approvals->approveApproval([\n    'approval' => [\n        'entity' => 'account',\n        'resource_id' => 'W13ZGY',\n        'note' => 'Checked and approved.',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "reject_approval": {
      "function": "rejectApproval",
      "code": "$response = $client->approvals->rejectApproval([\n    'approval' => [\n        'entity' => 'account',\n        'resource_id' => 'W13ZGY',\n        'note' => 'Missing billing details.',\n    ],\n]);\nprint_r($response->data);\n"
    }
  }
}
