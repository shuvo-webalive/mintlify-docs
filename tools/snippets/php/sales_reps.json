{
  "sdk": "php",
  "module": "sales_reps",
  "endpoints": {
    "get_settings_sales_reps": {
      "function": "getSettingsSalesReps",
      "code": "$response = $client->salesReps->getSettingsSalesReps(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_sales_rep": {
      "function": "createSettingsSalesRep",
      "code": "$response = $client->salesReps->createSettingsSalesRep([\n    'sales_rep' => [\n        'first_name' => 'Jane',\n        'last_name' => 'Citizen',\n        'email_address' => 'jane@example.com',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_sales_rep": {
      "function": "getSettingsSalesRep",
      "code": "$response = $client->salesReps->getSettingsSalesRep('sr_7c1e4b9a2d3f4e5a8b6c0d1e2f3a4b5c');\nprint_r($response->data);\n"
    },
    "update_settings_sales_rep": {
      "function": "updateSettingsSalesRep",
      "code": "$response = $client->salesReps->updateSettingsSalesRep('sr_7c1e4b9a2d3f4e5a8b6c0d1e2f3a4b5c', [\n    'sales_rep' => ['last_name' => 'Citizen-Smith'],\n]);\nprint_r($response->data);\n"
    },
    "delete_settings_sales_rep": {
      "function": "deleteSettingsSalesRep",
      "code": "$response = $client->salesReps->deleteSettingsSalesRep('sr_7c1e4b9a2d3f4e5a8b6c0d1e2f3a4b5c');\nprint_r($response->data);\n"
    }
  }
}
