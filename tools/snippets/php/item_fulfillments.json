{
  "sdk": "php",
  "module": "item_fulfillments",
  "endpoints": {
    "get_item_fulfillments": {
      "function": "getItemFulfillments",
      "code": "$response = $client->itemFulfillments->getItemFulfillments(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_item_fulfillment": {
      "function": "createItemFulfillment",
      "code": "$response = $client->itemFulfillments->createItemFulfillment([\n    'item_fulfillment' => [\n        'invoice_id' => 'INV-0001',\n        'fulfillments' => [\n            ['invoice_line' => '8e7d6c5b-4a39-4281-9706-f5e4d3c2b1a0', 'fulfillment_quantity' => 1],\n        ],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_item_fulfillment": {
      "function": "getItemFulfillment",
      "code": "$response = $client->itemFulfillments->getItemFulfillment('ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9');\nprint_r($response->data);\n"
    },
    "update_item_fulfillment": {
      "function": "updateItemFulfillment",
      "code": "$response = $client->itemFulfillments->updateItemFulfillment(\n    'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n    ['item_fulfillment' => ['tracking_number' => 'TRK-0001']],\n);\nprint_r($response->data);\n"
    },
    "create_item_fulfillment_note": {
      "function": "createItemFulfillmentNote",
      "code": "$response = $client->itemFulfillments->createItemFulfillmentNote(\n    'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n    '<p>Left with reception.</p>',\n    ['file' => ['delivery-photo.jpg', fopen('delivery-photo.jpg', 'r')]],\n);\nprint_r($response->data);\n"
    },
    "delete_item_fulfillment": {
      "function": "deleteItemFulfillment",
      "code": "$response = $client->itemFulfillments->deleteItemFulfillment(\n    'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n);\nprint_r($response->data);\n"
    },
    "delete_item_fulfillment_note": {
      "function": "deleteItemFulfillmentNote",
      "code": "$response = $client->itemFulfillments->deleteItemFulfillmentNote(\n    'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n    'note_b1c2d3e4f5061728394a5b6c7d8e9f00',\n);\nprint_r($response->data);\n"
    },
    "get_item_fulfillment_notes": {
      "function": "getItemFulfillmentNotes",
      "code": "$response = $client->itemFulfillments->getItemFulfillmentNotes(\n    'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n    ['limit' => 20],\n);\nprint_r($response->data);\n"
    },
    "get_item_fulfillment_note": {
      "function": "getItemFulfillmentNote",
      "code": "$response = $client->itemFulfillments->getItemFulfillmentNote(\n    'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n    'note_b1c2d3e4f5061728394a5b6c7d8e9f00',\n);\nprint_r($response->data);\n"
    }
  }
}
