{
  "sdk": "php",
  "module": "custom_events",
  "endpoints": {
    "get_settings_custom_events": {
      "function": "getSettingsCustomEvents",
      "code": "$response = $client->customEvents->getSettingsCustomEvents(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_custom_event": {
      "function": "createSettingsCustomEvent",
      "code": "$response = $client->customEvents->createSettingsCustomEvent([\n    'custom_event' => [\n        'name' => 'Order approved by finance',\n        'base_event' => 'se_1d3f5a7c9e2b4d6f8a0c2e4b6d8f0a2c',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_custom_event": {
      "function": "getSettingsCustomEvent",
      "code": "$response = $client->customEvents->getSettingsCustomEvent('ce_8b0d2f4a6c8e4b1d3f5a7c9e1b3d5f7a');\nprint_r($response->data);\n"
    },
    "delete_settings_custom_event": {
      "function": "deleteSettingsCustomEvent",
      "code": "$response = $client->customEvents->deleteSettingsCustomEvent('ce_8b0d2f4a6c8e4b1d3f5a7c9e1b3d5f7a');\nprint_r($response->data);\n"
    },
    "update_settings_custom_event": {
      "function": "updateSettingsCustomEvent",
      "code": "$response = $client->customEvents->updateSettingsCustomEvent(\n    'ce_8b0d2f4a6c8e4b1d3f5a7c9e1b3d5f7a',\n    ['custom_event' => ['display_name' => 'Order approved by finance team']],\n);\nprint_r($response->data);\n"
    }
  }
}
