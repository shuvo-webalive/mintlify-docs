{
  "sdk": "php",
  "module": "proforma_invoices",
  "endpoints": {
    "get_proforma_invoices": {
      "function": "getProformaInvoices",
      "code": "$response = $client->proformaInvoices->getProformaInvoices(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "get_proforma_invoice": {
      "function": "getProformaInvoice",
      "code": "$response = $client->proformaInvoices->getProformaInvoice('PF-0001');\nprint_r($response->data);\n"
    },
    "delete_proforma_invoice": {
      "function": "deleteProformaInvoice",
      "code": "$response = $client->proformaInvoices->deleteProformaInvoice('PF-0001');\nprint_r($response->data);\n"
    },
    "create_proforma_invoice_payment": {
      "function": "createProformaInvoicePayment",
      "code": "$response = $client->proformaInvoices->createProformaInvoicePayment('PF-0001', [\n    'payment' => (object) [],\n]);\nprint_r($response->data);\n"
    }
  }
}
