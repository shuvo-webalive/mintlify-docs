{
  "sdk": "php",
  "module": "purchase_orders",
  "endpoints": {
    "get_purchase_orders": {
      "function": "getPurchaseOrders",
      "code": "$response = $client->purchaseOrders->getPurchaseOrders(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_purchase_order": {
      "function": "createPurchaseOrder",
      "code": "$response = $client->purchaseOrders->createPurchaseOrder([\n    'purchase_order' => [\n        'account' => [\n            'name' => 'Acme Pty Ltd',\n            'type' => 'SUPPLIER',\n            'email_address' => 'jane@example.com',\n        ],\n        'lines' => [\n            [\n                'item_name' => 'Copy paper A4',\n                'item_quantity' => 1,\n                'item_price_snapshot' => ['pricing_rule' => ['price' => 5]],\n            ],\n        ],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_purchase_orders_notes": {
      "function": "getPurchaseOrdersNotes",
      "code": "$response = $client->purchaseOrders->getPurchaseOrdersNotes(['limit' => 20]);\nprint_r($response->data);\n"
    },
