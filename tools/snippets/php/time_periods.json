{
  "sdk": "php",
  "module": "time_periods",
  "endpoints": {
    "get_settings_time_periods": {
      "function": "getSettingsTimePeriods",
      "code": "$response = $client->timePeriods->getSettingsTimePeriods(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_time_period": {
      "function": "createSettingsTimePeriod",
      "code": "$response = $client->timePeriods->createSettingsTimePeriod([\n    'time_period' => [\n        'name' => 'One month',\n        'display_name' => 'One month',\n        'period' => 'MONTHLY',\n        'duration' => 1,\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_time_period": {
      "function": "getSettingsTimePeriod",
      "code": "$response = $client->timePeriods->getSettingsTimePeriod('tp_5d2e8f1a9b3c4d7e8f0a1b2c3d4e5f6a');\nprint_r($response->data);\n"
    },
    "delete_settings_time_period": {
      "function": "deleteSettingsTimePeriod",
      "code": "$response = $client->timePeriods->deleteSettingsTimePeriod('tp_5d2e8f1a9b3c4d7e8f0a1b2c3d4e5f6a');\nprint_r($response->data);\n"
    },
    "update_settings_time_period": {
      "function": "updateSettingsTimePeriod",
      "code": "$response = $client->timePeriods->updateSettingsTimePeriod('tp_5d2e8f1a9b3c4d7e8f0a1b2c3d4e5f6a', [\n    'time_period' => [\n        'display_name' => 'One calendar month',\n        'description' => 'Used for monthly billing',\n    ],\n]);\nprint_r($response->data);\n"
    }
  }
}
