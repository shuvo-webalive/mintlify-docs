{
  "sdk": "php",
  "module": "payments",
  "endpoints": {
    "get_payments": {
      "function": "getPayments",
      "code": "$response = $client->payments->getPayments(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "get_payments_notes": {
      "function": "getPaymentsNotes",
      "code": "$response = $client->payments->getPaymentsNotes(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "delete_payment": {
      "function": "deletePayment",
      "code": "$response = $client->payments->deletePayment('PAY-0001');\nprint_r($response->data);\n"
    },
    "update_payment": {
      "function": "updatePayment",
      "code": "$response = $client->payments->updatePayment('PAY-0001', [\n    'payment' => ['note' => 'Paid at the front counter.'],\n]);\nprint_r($response->data);\n"
    },
    "get_payment": {
      "function": "getPayment",
      "code": "$response = $client->payments->getPayment('PAY-0001');\nprint_r($response->data);\n"
    },
    "get_invoice_payments": {
      "function": "getInvoicePayments",
      "code": "$response = $client->payments->getInvoicePayments('INV-0001', ['limit' => 20]);\nprint_r($response->data);\n"
    },
    "get_order_payments": {
      "function": "getOrderPayments",
      "code": "$response = $client->payments->getOrderPayments('ORD-0001', ['limit' => 20]);\nprint_r($response->data);\n"
    },
    "get_payment_notes": {
      "function": "getPaymentNotes",
      "code": "$response = $client->payments->getPaymentNotes('PAY-0001', ['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_payment_note": {
      "function": "createPaymentNote",
      "code": "$response = $client->payments->createPaymentNote('PAY-0001', 'Customer asked for a copy by post.', [\n    'file' => ['receipt.pdf', fopen('receipt.pdf', 'r')],\n]);\nprint_r($response->data);\n"
    },
    "get_payment_note": {
      "function": "getPaymentNote",
      "code": "$response = $client->payments->getPaymentNote('PAY-0001', 'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d');\nprint_r($response->data);\n"
    },
    "delete_payment_note": {
      "function": "deletePaymentNote",
      "code": "$response = $client->payments->deletePaymentNote(\n    'PAY-0001',\n    '3f2b8c1d-9e4a-4f6b-8c2d-1e0f9a8b7c6d',\n);\nprint_r($response->data);\n"
    },
    "get_payment_note_file": {
      "function": "getPaymentNoteFile",
      "code": "$response = $client->payments->getPaymentNoteFile(\n    'PAY-0001',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n    '6b1f0c2e-8d4a-4e3b-9f5c-2a7d1e0b3c4f',\n);\nprint_r($response->data);\n"
    },
    "create_payment": {
      "function": "createPayment",
      "code": "$response = $client->payments->createPayment([\n    'payment' => [\n        'date' => '2026-10-01',\n        'payment_note' => 'October invoice',\n        'payment_applied' => [\n            ['processor' => 'Cash', 'amount' => '10.00', 'reference' => 'RCPT-1001'],\n        ],\n        'invoices' => [['id' => 'INV-0001', 'applied' => '10.00']],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_invoice_payment": {
      "function": "getInvoicePayment",
      "code": "$response = $client->payments->getInvoicePayment('INV-0001', 'PAY-0001');\nprint_r($response->data);\n"
    },
    "get_payment_note_files": {
      "function": "getPaymentNoteFiles",
      "code": "$response = $client->payments->getPaymentNoteFiles(\n    'PAY-0001',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n);\nprint_r($response->data);\n"
    }
  }
}
