{
  "sdk": "php",
  "module": "item_receipts",
  "endpoints": {
    "get_item_receipts": {
      "function": "getItemReceipts",
      "code": "$response = $client->itemReceipts->getItemReceipts(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_item_receipt": {
      "function": "createItemReceipt",
      "code": "$response = $client->itemReceipts->createItemReceipt([\n    'item_receipt' => [\n        'purchase_order' => 'PO-0001',\n        'receipt_status' => 'STARTED',\n        'receipt_date' => '2026-10-01',\n        'lines' => [\n            [\n                'purchase_order_line' => 'd4c3b2a1-0f9e-4d8c-b7a6-958473625140',\n                'receipt_quantity' => 1,\n            ],\n        ],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "update_item_receipt": {
      "function": "updateItemReceipt",
      "code": "$response = $client->itemReceipts->updateItemReceipt('ir_4e5f60718293a4b5c6d7e8f90a1b2c3d', [\n    'item_receipt' => ['tracking_number' => 'TRK-0001'],\n]);\nprint_r($response->data);\n"
    },
    "get_item_receipt": {
      "function": "getItemReceipt",
      "code": "$response = $client->itemReceipts->getItemReceipt('ir_4e5f60718293a4b5c6d7e8f90a1b2c3d');\nprint_r($response->data);\n"
    },
    "get_purchase_order_item_receipts": {
      "function": "getPurchaseOrderItemReceipts",
      "code": "$response = $client->itemReceipts->getPurchaseOrderItemReceipts('PO-0001', ['limit' => 20]);\nprint_r($response->data);\n"
    },
    "delete_item_receipt": {
      "function": "deleteItemReceipt",
      "code": "$response = $client->itemReceipts->deleteItemReceipt('ir_4e5f60718293a4b5c6d7e8f90a1b2c3d');\nprint_r($response->data);\n"
    },
    "delete_item_receipt_note": {
      "function": "deleteItemReceiptNote",
      "code": "$response = $client->itemReceipts->deleteItemReceiptNote(\n    'ir_4e5f60718293a4b5c6d7e8f90a1b2c3d',\n    'note_c2d3e4f5061728394a5b6c7d8e9f0011',\n);\nprint_r($response->data);\n"
    }
  }
}
