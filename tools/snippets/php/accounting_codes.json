{
  "sdk": "php",
  "module": "accounting_codes",
  "endpoints": {
    "get_settings_accounting_codes": {
      "function": "getSettingsAccountingCodes",
      "code": "$response = $client->accountingCodes->getSettingsAccountingCodes(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_accounting_code": {
      "function": "createSettingsAccountingCode",
      "code": "$response = $client->accountingCodes->createSettingsAccountingCode([\n    'accounting_code' => [\n        'name' => 'Consulting revenue',\n        'account_code_type' => 'sales_revenue',\n        'gl_account_number' => '940215',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_accounting_code": {
      "function": "getSettingsAccountingCode",
      "code": "$response = $client->accountingCodes->getSettingsAccountingCode('121b2c3d4e5f4a6b8c7d9e0f1a2b3c4d');\nprint_r($response->data);\n"
    },
    "delete_settings_accounting_code": {
      "function": "deleteSettingsAccountingCode",
      "code": "$response = $client->accountingCodes->deleteSettingsAccountingCode(\n    '121b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint_r($response->data);\n"
    },
    "update_settings_accounting_code": {
      "function": "updateSettingsAccountingCode",
      "code": "$response = $client->accountingCodes->updateSettingsAccountingCode(\n    '121b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n    [\n        'accounting_code' => [\n            'display_name' => 'Consulting revenue (AU)',\n            'description' => 'Revenue from consulting work',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
