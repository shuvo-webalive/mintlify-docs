{
  "sdk": "php",
  "module": "gift_certificates",
  "endpoints": {
    "get_gift_certificates": {
      "function": "getGiftCertificates",
      "code": "$response = $client->giftCertificates->getGiftCertificates(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_gift_certificate": {
      "function": "createGiftCertificate",
      "code": "$response = $client->giftCertificates->createGiftCertificate([\n    'gift_certificate' => ['amount' => '5.00', 'expiry_date' => '2027-10-01'],\n]);\nprint_r($response->data);\n"
    },
    "delete_gift_certificate": {
      "function": "deleteGiftCertificate",
      "code": "$response = $client->giftCertificates->deleteGiftCertificate('gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f');\nprint_r($response->data);\n"
    },
    "get_gift_certificate": {
      "function": "getGiftCertificate",
      "code": "$response = $client->giftCertificates->getGiftCertificate('gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f');\nprint_r($response->data);\n"
    },
    "update_gift_certificate": {
      "function": "updateGiftCertificate",
      "code": "$response = $client->giftCertificates->updateGiftCertificate(\n    'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n    ['gift_certificate' => ['expiry_date' => '2027-12-31']],\n);\nprint_r($response->data);\n"
    },
    "get_gift_certificate_allocations": {
      "function": "getGiftCertificateAllocations",
      "code": "$response = $client->giftCertificates->getGiftCertificateAllocations(\n    'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n    ['limit' => 20],\n);\nprint_r($response->data);\n"
    },
    "get_gift_certificate_transactions": {
      "function": "getGiftCertificateTransactions",
      "code": "$response = $client->giftCertificates->getGiftCertificateTransactions(\n    'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n    ['limit' => 20],\n);\nprint_r($response->data);\n"
    },
    "amend_gift_certificate": {
      "function": "amendGiftCertificate",
      "code": "$response = $client->giftCertificates->amendGiftCertificate('gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f', [\n    'gift_certificate' => ['new_balance' => '7.00'],\n]);\nprint_r($response->data);\n"
    },
    "allocate_gift_certificate": {
      "function": "allocateGiftCertificate",
      "code": "$response = $client->giftCertificates->allocateGiftCertificate(\n    'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n    ['gift_certificate' => ['account' => ['code' => 'W13ZGY']]],\n);\nprint_r($response->data);\n"
    },
    "deallocate_gift_certificate": {
      "function": "deallocateGiftCertificate",
      "code": "$response = $client->giftCertificates->deallocateGiftCertificate(\n    'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n    ['gift_certificate' => ['account' => ['code' => 'W13ZGY']]],\n);\nprint_r($response->data);\n"
    },
    "get_gift_certificate_allocation": {
      "function": "getGiftCertificateAllocation",
      "code": "$response = $client->giftCertificates->getGiftCertificateAllocation(\n    'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n    'gca_1d4f7a2c9e5b4083b6a1c2d3e4f5a6b7',\n);\nprint_r($response->data);\n"
    },
    "get_gift_certificate_transaction": {
      "function": "getGiftCertificateTransaction",
      "code": "$response = $client->giftCertificates->getGiftCertificateTransaction(\n    'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n    'gct_8e2c5a9f1b7d4c6e0a3b5d7f9c1e2a4b',\n);\nprint_r($response->data);\n"
    }
  }
}
