{
  "sdk": "php",
  "module": "teams",
  "endpoints": {
    "get_settings_teams": {
      "function": "getSettingsTeams",
      "code": "$response = $client->teams->getSettingsTeams(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_team": {
      "function": "createSettingsTeam",
      "code": "$response = $client->teams->createSettingsTeam(['team' => ['name' => 'Field Services']]);\nprint_r($response->data);\n"
    },
    "get_settings_team": {
      "function": "getSettingsTeam",
      "code": "$response = $client->teams->getSettingsTeam('team_0000000000000001000000000000a1b2');\nprint_r($response->data);\n"
    },
    "delete_settings_team": {
      "function": "deleteSettingsTeam",
      "code": "$response = $client->teams->deleteSettingsTeam('team_0000000000000001000000000000a1b2');\nprint_r($response->data);\n"
    },
    "update_settings_team": {
      "function": "updateSettingsTeam",
      "code": "$response = $client->teams->updateSettingsTeam('team_0000000000000001000000000000a1b2', [\n    'team' => ['display_name' => 'Field Services North', 'description' => 'Northern region crew'],\n]);\nprint_r($response->data);\n"
    }
  }
}
