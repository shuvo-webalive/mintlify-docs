{
  "sdk": "php",
  "module": "credit_notes",
  "endpoints": {
    "get_credit_notes": {
      "function": "getCreditNotes",
      "code": "$response = $client->creditNotes->getCreditNotes(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "get_credit_note": {
      "function": "getCreditNote",
      "code": "$response = $client->creditNotes->getCreditNote('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d');\nprint_r($response->data);\n"
    },
    "update_credit_note": {
      "function": "updateCreditNote",
      "code": "$response = $client->creditNotes->updateCreditNote('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d', [\n    'credit_note' => ['custom_attributes' => []],\n]);\nprint_r($response->data);\n"
    },
    "create_credit_note": {
      "function": "createCreditNote",
      "code": "$response = $client->creditNotes->createCreditNote([\n    'credit_note' => ['invoice_id' => 'INV-0001', 'amount' => 5],\n]);\nprint_r($response->data);\n"
    },
    "delete_credit_note": {
      "function": "deleteCreditNote",
      "code": "$response = $client->creditNotes->deleteCreditNote('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d');\nprint_r($response->data);\n"
    },
    "apply_credit_note": {
      "function": "applyCreditNote",
      "code": "$response = $client->creditNotes->applyCreditNote('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d', [\n    'credit_note' => ['invoices' => [['invoice_id' => 'INV-0001', 'amount' => 5]]],\n]);\nprint_r($response->data);\n"
    },
    "get_credit_note_items": {
      "function": "getCreditNoteItems",
      "code": "$response = $client->creditNotes->getCreditNoteItems('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d');\nprint_r($response->data);\n"
    },
    "get_credit_note_credit_note_applications": {
      "function": "getCreditNoteCreditNoteApplications",
      "code": "$response = $client->creditNotes->getCreditNoteCreditNoteApplications(\n    'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n);\nprint_r($response->data);\n"
    },
    "get_credit_note_notes": {
      "function": "getCreditNoteNotes",
      "code": "$response = $client->creditNotes->getCreditNoteNotes('cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d', [\n    'limit' => 20,\n]);\nprint_r($response->data);\n"
    },
    "get_credit_note_note": {
      "function": "getCreditNoteNote",
      "code": "$response = $client->creditNotes->getCreditNoteNote(\n    'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n);\nprint_r($response->data);\n"
    },
    "create_credit_note_note": {
      "function": "createCreditNoteNote",
      "code": "$response = $client->creditNotes->createCreditNoteNote(\n    'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n    'Customer asked for a copy by post.',\n    ['file' => ['receipt.pdf', fopen('receipt.pdf', 'r')]],\n);\nprint_r($response->data);\n"
    },
    "delete_credit_note_note": {
      "function": "deleteCreditNoteNote",
      "code": "$response = $client->creditNotes->deleteCreditNoteNote(\n    'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n);\nprint_r($response->data);\n"
    },
    "get_credit_note_note_files": {
      "function": "getCreditNoteNoteFiles",
      "code": "$response = $client->creditNotes->getCreditNoteNoteFiles(\n    'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n);\nprint_r($response->data);\n"
    },
    "get_credit_note_note_file": {
      "function": "getCreditNoteNoteFile",
      "code": "$response = $client->creditNotes->getCreditNoteNoteFile(\n    'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n    '6b1f0c2e-8d4a-4e3b-9f5c-2a7d1e0b3c4f',\n);\nprint_r($response->data);\n"
    }
  }
}
