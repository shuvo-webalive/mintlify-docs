{
  "sdk": "php",
  "module": "alert_responsibility",
  "endpoints": {
    "get_alert_responsibilities": {
      "function": "getAlertResponsibilities",
      "code": "$response = $client->alertResponsibility->getAlertResponsibilities(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "get_alert_responsibility": {
      "function": "getAlertResponsibility",
      "code": "$response = $client->alertResponsibility->getAlertResponsibility(\n    'ar_3e5a7c9b1d0f4e2a4c6b8d0e2f4a6c8b',\n);\nprint_r($response->data);\n"
    },
    "create_alert_responsibility": {
      "function": "createAlertResponsibility",
      "code": "$response = $client->alertResponsibility->createAlertResponsibility([\n    'alert_responsibility' => [\n        'name' => 'Billing alerts',\n        'description' => 'Alerts about failed billing.',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "update_alert_responsibility": {
      "function": "updateAlertResponsibility",
      "code": "$response = $client->alertResponsibility->updateAlertResponsibility(\n    'ar_3e5a7c9b1d0f4e2a4c6b8d0e2f4a6c8b',\n    [\n        'alert_responsibility' => [\n            'description' => 'Alerts about failed billing and refunds.',\n            'status' => 'inactive',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    },
    "delete_alert_responsibility": {
      "function": "deleteAlertResponsibility",
      "code": "$response = $client->alertResponsibility->deleteAlertResponsibility(\n    'ar_3e5a7c9b1d0f4e2a4c6b8d0e2f4a6c8b',\n);\nprint_r($response->data);\n"
    }
  }
