{
  "sdk": "php",
  "module": "billing_periods",
  "endpoints": {
    "get_settings_billing_periods": {
      "function": "getSettingsBillingPeriods",
      "code": "$response = $client->billingPeriods->getSettingsBillingPeriods(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_billing_period": {
      "function": "createSettingsBillingPeriod",
      "code": "$response = $client->billingPeriods->createSettingsBillingPeriod([\n    'billing_period' => [\n        'name' => 'Monthly billing',\n        'time_period' => '580762f9-04bd-2bd2-6d3d-7e71ae87aa72',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_billing_period": {
      "function": "getSettingsBillingPeriod",
      "code": "$response = $client->billingPeriods->getSettingsBillingPeriod(\n    'bp_8032a9c720486f23f5592488f24068d3',\n);\nprint_r($response->data);\n"
    },
    "delete_settings_billing_period": {
      "function": "deleteSettingsBillingPeriod",
      "code": "$response = $client->billingPeriods->deleteSettingsBillingPeriod(\n    'bp_8032a9c720486f23f5592488f24068d3',\n);\nprint_r($response->data);\n"
    },
    "update_settings_billing_period": {
      "function": "updateSettingsBillingPeriod",
      "code": "$response = $client->billingPeriods->updateSettingsBillingPeriod(\n    'bp_8032a9c720486f23f5592488f24068d3',\n    [\n        'billing_period' => [\n            'display_name' => 'Monthly billing (AU)',\n            'description' => 'Bills once a month',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
