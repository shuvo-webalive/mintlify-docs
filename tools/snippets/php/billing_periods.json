{
  "sdk": "php",
  "module": "billing_periods",
  "endpoints": {
    "get_settings_billing_periods": {
      "function": "getSettingsBillingPeriods",
      "code": "$response = $client->billingPeriods->getSettingsBillingPeriods(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_billing_period": {
      "function": "createSettingsBillingPeriod",
      "code": "$response = $client->billingPeriods->createSettingsBillingPeriod([\n    'billing_period' => [\n        'name' => 'Monthly billing',\n        'time_period' => '2b1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_billing_period": {
      "function": "getSettingsBillingPeriod",
      "code": "$response = $client->billingPeriods->getSettingsBillingPeriod(\n    'bp_181b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint_r($response->data);\n"
    },
    "delete_settings_billing_period": {
      "function": "deleteSettingsBillingPeriod",
      "code": "$response = $client->billingPeriods->deleteSettingsBillingPeriod(\n    'bp_181b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint_r($response->data);\n"
    },
    "update_settings_billing_period": {
      "function": "updateSettingsBillingPeriod",
      "code": "$response = $client->billingPeriods->updateSettingsBillingPeriod(\n    'bp_181b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n    [\n        'billing_period' => [\n            'display_name' => 'Monthly billing (AU)',\n            'description' => 'Bills once a month',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
