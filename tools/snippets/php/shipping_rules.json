{
  "sdk": "php",
  "module": "shipping_rules",
  "endpoints": {
    "get_settings_shipping_rules": {
      "function": "getSettingsShippingRules",
      "code": "$response = $client->shippingRules->getSettingsShippingRules(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_shipping_rule": {
      "function": "createSettingsShippingRule",
      "code": "$response = $client->shippingRules->createSettingsShippingRule([\n    'shipping_rule' => ['name' => 'Standard shipping'],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_shipping_rule": {
      "function": "getSettingsShippingRule",
      "code": "$response = $client->shippingRules->getSettingsShippingRule('sr_7f8091a2b3c4d5e6f708192a3b4c5d6e');\nprint_r($response->data);\n"
    },
    "delete_settings_shipping_rule": {
      "function": "deleteSettingsShippingRule",
      "code": "$response = $client->shippingRules->deleteSettingsShippingRule(\n    'sr_7f8091a2b3c4d5e6f708192a3b4c5d6e',\n);\nprint_r($response->data);\n"
    },
    "update_settings_shipping_rule": {
      "function": "updateSettingsShippingRule",
      "code": "$response = $client->shippingRules->updateSettingsShippingRule(\n    'sr_7f8091a2b3c4d5e6f708192a3b4c5d6e',\n    [\n        'shipping_rule' => [\n            'name' => 'Standard shipping',\n            'description' => 'Flat rate within Australia',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    },
    "create_settings_shipping_rule_configuration": {
      "function": "createSettingsShippingRuleConfiguration",
      "code": "$response = $client->shippingRules->createSettingsShippingRuleConfiguration(\n    'sr_7f8091a2b3c4d5e6f708192a3b4c5d6e',\n    [\n        'configuration' => [\n            'zones' => [['zone' => '0a1b2c3d-4e5f-6071-8293-a4b5c6d7e8f9']],\n            'rate' => [\n                'name' => 'Flat rate',\n                'method' => 'FLAT_RATE',\n                'handling_cost' => 1,\n                'shipping_cost' => 5,\n            ],\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
