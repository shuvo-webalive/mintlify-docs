{
  "sdk": "php",
  "module": "fulfillment_terms",
  "endpoints": {
    "get_settings_fulfillment_terms": {
      "function": "getSettingsFulfillmentTerms",
      "code": "$response = $client->fulfillmentTerms->getSettingsFulfillmentTerms(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_fulfillment_term": {
      "function": "createSettingsFulfillmentTerm",
      "code": "$response = $client->fulfillmentTerms->createSettingsFulfillmentTerm([\n    'fulfillment_term' => [\n        'name' => 'One month',\n        'display_name' => 'One month',\n        'period' => 'MONTHLY',\n        'duration' => 1,\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_fulfillment_term": {
      "function": "getSettingsFulfillmentTerm",
      "code": "$response = $client->fulfillmentTerms->getSettingsFulfillmentTerm(\n    'ft_6e7f8091a2b3c4d5e6f708192a3b4c5d',\n);\nprint_r($response->data);\n"
    },
    "delete_settings_fulfillment_term": {
      "function": "deleteSettingsFulfillmentTerm",
      "code": "$response = $client->fulfillmentTerms->deleteSettingsFulfillmentTerm(\n    'ft_6e7f8091a2b3c4d5e6f708192a3b4c5d',\n);\nprint_r($response->data);\n"
    },
    "update_settings_fulfillment_term": {
      "function": "updateSettingsFulfillmentTerm",
      "code": "$response = $client->fulfillmentTerms->updateSettingsFulfillmentTerm(\n    'ft_6e7f8091a2b3c4d5e6f708192a3b4c5d',\n    [\n        'fulfillment_term' => [\n            'display_name' => 'One month',\n            'description' => 'Fulfill within a month',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
