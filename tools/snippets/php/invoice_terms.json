{
  "sdk": "php",
  "module": "invoice_terms",
  "endpoints": {
    "get_settings_invoice_terms": {
      "function": "getSettingsInvoiceTerms",
      "code": "$response = $client->invoiceTerms->getSettingsInvoiceTerms(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_invoice_term": {
      "function": "createSettingsInvoiceTerm",
      "code": "$response = $client->invoiceTerms->createSettingsInvoiceTerm([\n    'invoice_term' => [\n        'name' => 'Net one month',\n        'display_name' => 'Net one month',\n        'period' => 'MONTHLY',\n        'duration' => 1,\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_invoice_term": {
      "function": "getSettingsInvoiceTerm",
      "code": "$response = $client->invoiceTerms->getSettingsInvoiceTerm('946ed1d6908648ca86cb1e5baef55e40');\nprint_r($response->data);\n"
    },
    "delete_settings_invoice_term": {
      "function": "deleteSettingsInvoiceTerm",
      "code": "$response = $client->invoiceTerms->deleteSettingsInvoiceTerm('946ed1d6908648ca86cb1e5baef55e40');\nprint_r($response->data);\n"
    },
    "update_settings_invoice_term": {
      "function": "updateSettingsInvoiceTerm",
      "code": "$response = $client->invoiceTerms->updateSettingsInvoiceTerm('946ed1d6908648ca86cb1e5baef55e40', [\n    'invoice_term' => [\n        'display_name' => 'Net one month (AU)',\n        'description' => 'Due one month after issue',\n    ],\n]);\nprint_r($response->data);\n"
    }
  }
}
