{
  "sdk": "php",
  "module": "email_templates",
  "endpoints": {
    "get_settings_email_templates": {
      "function": "getSettingsEmailTemplates",
      "code": "$response = $client->emailTemplates->getSettingsEmailTemplates(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_email_template": {
      "function": "createSettingsEmailTemplate",
      "code": "$response = $client->emailTemplates->createSettingsEmailTemplate([\n    'email_template' => ['name' => 'Welcome email', 'subject' => 'Welcome to Acme Pty Ltd'],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_email_template": {
      "function": "getSettingsEmailTemplate",
      "code": "$response = $client->emailTemplates->getSettingsEmailTemplate(\n    'et_141b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint_r($response->data);\n"
    },
    "delete_settings_email_template": {
      "function": "deleteSettingsEmailTemplate",
      "code": "$response = $client->emailTemplates->deleteSettingsEmailTemplate(\n    'et_141b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint_r($response->data);\n"
    },
    "update_settings_email_template": {
      "function": "updateSettingsEmailTemplate",
      "code": "$response = $client->emailTemplates->updateSettingsEmailTemplate(\n    'et_141b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n    [\n        'email_template' => [\n            'display_name' => 'Welcome email (AU)',\n            'description' => 'Sent to new customers',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
