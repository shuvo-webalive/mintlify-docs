{
  "sdk": "php",
  "module": "pricing_periods",
  "endpoints": {
    "get_settings_pricing_periods": {
      "function": "getSettingsPricingPeriods",
      "code": "$response = $client->pricingPeriods->getSettingsPricingPeriods(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_pricing_period": {
      "function": "createSettingsPricingPeriod",
      "code": "$response = $client->pricingPeriods->createSettingsPricingPeriod([\n    'pricing_period' => [\n        'name' => 'Monthly price',\n        'display_name' => 'Monthly price',\n        'time_period' => 'tp_2b1b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_pricing_period": {
      "function": "getSettingsPricingPeriod",
      "code": "$response = $client->pricingPeriods->getSettingsPricingPeriod('261b2c3d4e5f4a6b8c7d9e0f1a2b3c4d');\nprint_r($response->data);\n"
    },
    "delete_settings_pricing_period": {
      "function": "deleteSettingsPricingPeriod",
      "code": "$response = $client->pricingPeriods->deleteSettingsPricingPeriod(\n    '261b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint_r($response->data);\n"
    },
    "update_settings_pricing_period": {
      "function": "updateSettingsPricingPeriod",
      "code": "$response = $client->pricingPeriods->updateSettingsPricingPeriod(\n    '261b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n    [\n        'pricing_period' => [\n            'display_name' => 'Monthly price (AU)',\n            'description' => 'Priced once a month',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
