{
  "sdk": "php",
  "module": "pricing_periods",
  "endpoints": {
    "get_settings_pricing_periods": {
      "function": "getSettingsPricingPeriods",
      "code": "$response = $client->pricingPeriods->getSettingsPricingPeriods(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_pricing_period": {
      "function": "createSettingsPricingPeriod",
      "code": "$response = $client->pricingPeriods->createSettingsPricingPeriod([\n    'pricing_period' => [\n        'name' => 'Monthly price',\n        'display_name' => 'Monthly price',\n        'time_period' => 'tp_580762f904bd2bd26d3d7e71ae87aa72',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_pricing_period": {
      "function": "getSettingsPricingPeriod",
      "code": "$response = $client->pricingPeriods->getSettingsPricingPeriod('f216c928c95f828e123939dcefba4b7c');\nprint_r($response->data);\n"
    },
    "delete_settings_pricing_period": {
      "function": "deleteSettingsPricingPeriod",
      "code": "$response = $client->pricingPeriods->deleteSettingsPricingPeriod(\n    'f216c928c95f828e123939dcefba4b7c',\n);\nprint_r($response->data);\n"
    },
    "update_settings_pricing_period": {
      "function": "updateSettingsPricingPeriod",
      "code": "$response = $client->pricingPeriods->updateSettingsPricingPeriod(\n    'f216c928c95f828e123939dcefba4b7c',\n    [\n        'pricing_period' => [\n            'display_name' => 'Monthly price (AU)',\n            'description' => 'Priced once a month',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
