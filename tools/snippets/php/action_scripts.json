{
  "sdk": "php",
  "module": "action_scripts",
  "endpoints": {
    "get_action_scripts": {
      "function": "getActionScripts",
      "code": "$response = $client->actionScripts->getActionScripts(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "get_action_script": {
      "function": "getActionScript",
      "code": "$response = $client->actionScripts->getActionScript('ascr_7c9e1b3d5f2a4c6e8a0b2d4f6c8e0a1b');\nprint_r($response->data);\n"
    },
    "create_action_script": {
      "function": "createActionScript",
      "code": "$response = $client->actionScripts->createActionScript([\n    'action_script' => [\n        'name' => 'notify-account-manager',\n        'description' => 'Notifies the account manager.',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "update_action_script": {
      "function": "updateActionScript",
      "code": "$response = $client->actionScripts->updateActionScript('ascr_7c9e1b3d5f2a4c6e8a0b2d4f6c8e0a1b', [\n    'action_script' => ['description' => 'Notifies the account manager and the sales rep.'],\n]);\nprint_r($response->data);\n"
    },
    "delete_action_script": {
      "function": "deleteActionScript",
      "code": "$response = $client->actionScripts->deleteActionScript('ascr_7c9e1b3d5f2a4c6e8a0b2d4f6c8e0a1b');\nprint_r($response->data);\n"
    }
  }
}
