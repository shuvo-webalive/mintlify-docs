{
  "sdk": "php",
  "module": "additional_codes",
  "endpoints": {
    "get_settings_additional_codes": {
      "function": "getSettingsAdditionalCodes",
      "code": "$response = $client->additionalCodes->getSettingsAdditionalCodes(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_additional_code": {
      "function": "createSettingsAdditionalCode",
      "code": "$response = $client->additionalCodes->createSettingsAdditionalCode([\n    'additional_code' => ['name' => 'Project code'],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_additional_code": {
      "function": "getSettingsAdditionalCode",
      "code": "$response = $client->additionalCodes->getSettingsAdditionalCode(\n    'ac_ca6fd105f892361f26f628edd0e79b56',\n);\nprint_r($response->data);\n"
    },
    "delete_settings_additional_code": {
      "function": "deleteSettingsAdditionalCode",
      "code": "$response = $client->additionalCodes->deleteSettingsAdditionalCode(\n    'ac_ca6fd105f892361f26f628edd0e79b56',\n);\nprint_r($response->data);\n"
    },
    "update_settings_additional_code": {
      "function": "updateSettingsAdditionalCode",
      "code": "$response = $client->additionalCodes->updateSettingsAdditionalCode(\n    'ac_ca6fd105f892361f26f628edd0e79b56',\n    [\n        'additional_code' => [\n            'display_name' => 'Project code (AU)',\n            'description' => 'Project reference for purchase lines',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
}
