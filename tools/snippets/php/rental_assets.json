{
  "sdk": "php",
  "module": "rental_assets",
  "endpoints": {
    "get_rental_asset_availability": {
      "function": "getRentalAssetAvailability",
      "code": "$response = $client->rentalAssets->getRentalAssetAvailability(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "update_rental_asset_availability": {
      "function": "updateRentalAssetAvailability",
      "code": "$response = $client->rentalAssets->updateRentalAssetAvailability([\n    'rental_assets' => [\n        [\n            'id' => 'RENTAL_ASSET_ID',\n            'rental_asset_custom_availability' => [\n                [\n                    'preferred_day' => 'Wednesday',\n                    'available' => true,\n                    'start_time' => '08:00',\n                    'end_time' => '12:00',\n                ],\n            ],\n        ],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_rental_asset_profiles": {
      "function": "getRentalAssetProfiles",
      "code": "$response = $client->rentalAssets->getRentalAssetProfiles(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_rental_asset_profile": {
      "function": "createRentalAssetProfile",
      "code": "$response = $client->rentalAssets->createRentalAssetProfile([\n    'rental_asset_profile' => [\n        'name' => 'Standard daily rate',\n        'display_name' => 'Standard daily rate',\n        'currency' => 'AUD',\n        'rental_asset_profile_sessions' => [\n            [\n                'name' => 'Spring season',\n                'start_date' => '2026-11-02',\n                'end_date' => '2026-12-30',\n                'rental_asset_profile_session_prices' => [\n                    ['price' => 1.0, 'price_type' => 'DAILY', 'enabled_pro_rata' => false],\n                ],\n                'rental_asset_profile_session_availability' => [\n                    [\n                        'preferred_day' => 'Monday',\n                        'available' => true,\n                        'start_time' => '09:00',\n                        'end_time' => '17:00',\n                    ],\n                ],\n            ],\n        ],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_rental_assets": {
      "function": "getRentalAssets",
      "code": "$response = $client->rentalAssets->getRentalAssets(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_rental_asset": {
      "function": "createRentalAsset",
      "code": "$response = $client->rentalAssets->createRentalAsset([\n    'rental_asset' => ['name' => 'Projector 1', 'rental_asset_profile' => 'RENTAL_ASSET_PROFILE_ID'],\n]);\nprint_r($response->data);\n"
    },
    "get_rental_asset_profile": {
      "function": "getRentalAssetProfile",
      "code": "$response = $client->rentalAssets->getRentalAssetProfile('RENTAL_ASSET_PROFILE_ID');\nprint_r($response->data);\n"
    },
    "update_rental_asset_profile": {
      "function": "updateRentalAssetProfile",
      "code": "$response = $client->rentalAssets->updateRentalAssetProfile('RENTAL_ASSET_PROFILE_ID', [\n    'rental_asset_profile' => ['display_name' => 'Standard daily rate, weekdays'],\n]);\nprint_r($response->data);\n"
    },
    "delete_rental_asset_profile": {
      "function": "deleteRentalAssetProfile",
      "code": "$response = $client->rentalAssets->deleteRentalAssetProfile('RENTAL_ASSET_PROFILE_ID');\nprint_r($response->data);\n"
    },
    "update_rental_asset": {
      "function": "updateRentalAsset",
      "code": "$response = $client->rentalAssets->updateRentalAsset('RENTAL_ASSET_ID', [\n    'rental_asset' => ['description' => 'Ceiling mounted projector'],\n]);\nprint_r($response->data);\n"
    },
    "delete_rental_asset": {
      "function": "deleteRentalAsset",
      "code": "$response = $client->rentalAssets->deleteRentalAsset('RENTAL_ASSET_ID');\nprint_r($response->data);\n"
    },
    "get_rental_asset": {
      "function": "getRentalAsset",
      "code": "$response = $client->rentalAssets->getRentalAsset('RENTAL_ASSET_ID');\nprint_r($response->data);\n"
    },
    "cancel_rental_asset": {
      "function": "cancelRentalAsset",
      "code": "$response = $client->rentalAssets->cancelRentalAsset('RENTAL_ASSET_ID', '{}');\nprint_r($response->data);\n"
    },
    "reactivate_rental_asset": {
      "function": "reactivateRentalAsset",
      "code": "$response = $client->rentalAssets->reactivateRentalAsset('RENTAL_ASSET_ID', '{}');\nprint_r($response->data);\n"
    }
  }
}
