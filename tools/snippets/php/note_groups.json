{
  "sdk": "php",
  "module": "note_groups",
  "endpoints": {
    "get_note_groups": {
      "function": "getNoteGroups",
      "code": "$response = $client->noteGroups->getNoteGroups(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_note_group": {
      "function": "createNoteGroup",
      "code": "$response = $client->noteGroups->createNoteGroup([\n    'note_group' => [\n        'name' => 'Project team',\n        'note_users' => [['name' => 'Jane Citizen', 'email_address' => 'jane@example.com']],\n    ],\n]);\nprint_r($response->data);\n"
    },
    "delete_note_group": {
      "function": "deleteNoteGroup",
      "code": "$response = $client->noteGroups->deleteNoteGroup('2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9');\nprint_r($response->data);\n"
    },
    "get_note_group": {
      "function": "getNoteGroup",
      "code": "$response = $client->noteGroups->getNoteGroup('2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9');\nprint_r($response->data);\n"
    },
    "update_note_group": {
      "function": "updateNoteGroup",
      "code": "$response = $client->noteGroups->updateNoteGroup('2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9', [\n    'note_group' => [\n        'display_name' => 'Project team (Sydney)',\n        'description' => 'Notes for the Sydney project team.',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_note_group_notes": {
      "function": "getNoteGroupNotes",
      "code": "$response = $client->noteGroups->getNoteGroupNotes('2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9', [\n    'limit' => 20,\n]);\nprint_r($response->data);\n"
    },
    "get_note_group_notes_by_user": {
      "function": "getNoteGroupNotesByUser",
      "code": "$response = $client->noteGroups->getNoteGroupNotesByUser(\n    '2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9',\n    'jane@example.com',\n    ['limit' => 20],\n);\nprint_r($response->data);\n"
    }
  }
}
