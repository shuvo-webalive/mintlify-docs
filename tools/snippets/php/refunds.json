{
  "sdk": "php",
  "module": "refunds",
  "endpoints": {
    "get_refunds": {
      "function": "getRefunds",
      "code": "$response = $client->refunds->getRefunds(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "delete_refund": {
      "function": "deleteRefund",
      "code": "$response = $client->refunds->deleteRefund('REF-0001');\nprint_r($response->data);\n"
    },
    "get_refund": {
      "function": "getRefund",
      "code": "$response = $client->refunds->getRefund('REF-0001');\nprint_r($response->data);\n"
    },
    "update_refund": {
      "function": "updateRefund",
      "code": "$response = $client->refunds->updateRefund('REF-0001', [\n    'refund' => ['reference' => 'BANK-REF-2001', 'note' => 'Refunded to the original card.'],\n]);\nprint_r($response->data);\n"
    },
    "create_credit_note_refund": {
      "function": "createCreditNoteRefund",
      "code": "$response = $client->refunds->createCreditNoteRefund('CN-0001', [\n    'refund' => ['amount' => '2.00', 'payment_method' => 'Cash'],\n]);\nprint_r($response->data);\n"
    },
    "get_refund_notes": {
      "function": "getRefundNotes",
      "code": "$response = $client->refunds->getRefundNotes('REF-0001', ['limit' => 20]);\nprint_r($response->data);\n"
    },
    "get_refund_note": {
      "function": "getRefundNote",
      "code": "$response = $client->refunds->getRefundNote('REF-0001', 'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d');\nprint_r($response->data);\n"
    },
    "create_refund_note": {
      "function": "createRefundNote",
      "code": "$response = $client->refunds->createRefundNote('REF-0001', 'Customer asked for a copy by post.', [\n    'file' => ['receipt.pdf', fopen('receipt.pdf', 'r')],\n]);\nprint_r($response->data);\n"
    },
    "delete_refund_note": {
      "function": "deleteRefundNote",
      "code": "$response = $client->refunds->deleteRefundNote('REF-0001', 'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d');\nprint_r($response->data);\n"
    },
    "get_refund_note_files": {
      "function": "getRefundNoteFiles",
      "code": "$response = $client->refunds->getRefundNoteFiles(\n    'REF-0001',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n);\nprint_r($response->data);\n"
    },
    "get_refund_note_file": {
      "function": "getRefundNoteFile",
      "code": "$response = $client->refunds->getRefundNoteFile(\n    'REF-0001',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n    '6b1f0c2e-8d4a-4e3b-9f5c-2a7d1e0b3c4f',\n);\nprint_r($response->data);\n"
    },
    "delete_refund_note_file": {
      "function": "deleteRefundNoteFile",
      "code": "$response = $client->refunds->deleteRefundNoteFile(\n    'REF-0001',\n    'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n    '6b1f0c2e-8d4a-4e3b-9f5c-2a7d1e0b3c4f',\n);\nprint_r($response->data);\n"
    }
  }
}
