{
  "sdk": "php",
  "module": "custom_attributes",
  "endpoints": {
    "get_custom_attributes": {
      "function": "getCustomAttributes",
      "code": "$response = $client->customAttributes->getCustomAttributes(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_custom_attribute": {
      "function": "createCustomAttribute",
      "code": "$response = $client->customAttributes->createCustomAttribute([\n    'custom_attribute' => [\n        'name' => 'contract_tier',\n        'display_name' => 'Contract tier',\n        'type' => 'STRING',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "delete_custom_attribute": {
      "function": "deleteCustomAttribute",
      "code": "$response = $client->customAttributes->deleteCustomAttribute('f3a8c1d6e2b94a7c8d5e0f1a2b3c4d5e');\nprint_r($response->data);\n"
    },
    "get_custom_attribute": {
      "function": "getCustomAttribute",
      "code": "$response = $client->customAttributes->getCustomAttribute('f3a8c1d6e2b94a7c8d5e0f1a2b3c4d5e');\nprint_r($response->data);\n"
    },
    "update_custom_attribute": {
      "function": "updateCustomAttribute",
      "code": "$response = $client->customAttributes->updateCustomAttribute('f3a8c1d6e2b94a7c8d5e0f1a2b3c4d5e', [\n    'custom_attribute' => [\n        'display_name' => 'Contract tier (updated)',\n        'description' => 'The customer\\'s support contract tier',\n    ],\n]);\nprint_r($response->data);\n"
    }
  }
}
