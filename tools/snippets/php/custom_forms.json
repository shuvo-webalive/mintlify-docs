{
  "sdk": "php",
  "module": "custom_forms",
  "endpoints": {
    "get_settings_custom_forms": {
      "function": "getSettingsCustomForms",
      "code": "$response = $client->customForms->getSettingsCustomForms(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_custom_form": {
      "function": "createSettingsCustomForm",
      "code": "$response = $client->customForms->createSettingsCustomForm([\n    'custom_form' => ['name' => 'acme-account-form', 'setting_group' => 'ACCOUNT'],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_custom_form": {
      "function": "getSettingsCustomForm",
      "code": "$response = $client->customForms->getSettingsCustomForm('cf_8d2a4c6e0b1f4d3a9c7e5b2d1f0a8c6e');\nprint_r($response->data);\n"
    },
    "delete_settings_custom_form": {
      "function": "deleteSettingsCustomForm",
      "code": "$response = $client->customForms->deleteSettingsCustomForm('cf_8d2a4c6e0b1f4d3a9c7e5b2d1f0a8c6e');\nprint_r($response->data);\n"
    },
    "update_settings_custom_form": {
      "function": "updateSettingsCustomForm",
      "code": "$response = $client->customForms->updateSettingsCustomForm('cf_8d2a4c6e0b1f4d3a9c7e5b2d1f0a8c6e', [\n    'custom_form' => [\n        'display_name' => 'Acme account form',\n        'description' => 'The form Acme Pty Ltd uses for new accounts',\n    ],\n]);\nprint_r($response->data);\n"
    }
  }
}
