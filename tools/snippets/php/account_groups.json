{
  "sdk": "php",
  "module": "account_groups",
  "endpoints": {
    "get_settings_account_groups": {
      "function": "getSettingsAccountGroups",
      "code": "$response = $client->accountGroups->getSettingsAccountGroups(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_account_group": {
      "function": "createSettingsAccountGroup",
      "code": "$response = $client->accountGroups->createSettingsAccountGroup([\n    'account_group' => ['name' => 'Wholesale'],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_account_group": {
      "function": "getSettingsAccountGroup",
      "code": "$response = $client->accountGroups->getSettingsAccountGroup('ag_3c8e1a5b7d2f4a9c8e6b1d3f5a7c9e2b');\nprint_r($response->data);\n"
    },
    "update_settings_account_group": {
      "function": "updateSettingsAccountGroup",
      "code": "$response = $client->accountGroups->updateSettingsAccountGroup(\n    'ag_3c8e1a5b7d2f4a9c8e6b1d3f5a7c9e2b',\n    ['account_group' => ['display_name' => 'Wholesale customers']],\n);\nprint_r($response->data);\n"
    },
    "delete_settings_account_group": {
      "function": "deleteSettingsAccountGroup",
      "code": "$response = $client->accountGroups->deleteSettingsAccountGroup(\n    'ag_3c8e1a5b7d2f4a9c8e6b1d3f5a7c9e2b',\n);\nprint_r($response->data);\n"
    }
  }
}
