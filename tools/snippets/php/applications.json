{
  "sdk": "php",
  "module": "applications",
  "endpoints": {
    "get_settings_applications": {
      "function": "getSettingsApplications",
      "code": "$response = $client->applications->getSettingsApplications(['limit' => 20]);\nprint_r($response->data);\n"
    },
    "create_settings_application": {
      "function": "createSettingsApplication",
      "code": "$response = $client->applications->createSettingsApplication([\n    'application' => [\n        'name' => 'Acme Integration',\n        'redirect_url' => 'https://example.com/callback',\n    ],\n]);\nprint_r($response->data);\n"
    },
    "get_settings_application": {
      "function": "getSettingsApplication",
      "code": "$response = $client->applications->getSettingsApplication('app_0123456789abcdef');\nprint_r($response->data);\n"
    },
    "delete_settings_application": {
      "function": "deleteSettingsApplication",
      "code": "$response = $client->applications->deleteSettingsApplication('app_0123456789abcdef');\nprint_r($response->data);\n"
    },
    "update_settings_application": {
      "function": "updateSettingsApplication",
      "code": "$response = $client->applications->updateSettingsApplication('app_0123456789abcdef', [\n    'application' => [\n        'display_name' => 'Acme Integration',\n        'description' => 'Syncs orders with Acme',\n    ],\n]);\nprint_r($response->data);\n"
    }
  }
}
