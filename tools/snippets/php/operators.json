      "code": "$response = $client->operators->updateSettingsOperator(\n    'op_5e9a2c7b1d4f4e8a9b3c6d1f7a2e4c8b',\n    [\n        'operator' => [\n            'name' => 'Jane Citizen',\n            'display_name' => 'Jane C.',\n            'role' => '3f6b8c2e-7a1d-4e95-b0c4-8d2a6f1e9b73',\n            'operator_group' => 'c41e7a92-5b3d-4f08-9a6e-2d8b1f7c3e50',\n        ],\n    ],\n);\nprint_r($response->data);\n"
    }
  }
