{
  "sdk": "dart",
  "module": "purchase_credit_notes",
  "endpoints": {
    "get_purchase_credit_notes": {
      "function": "getPurchaseCreditNotes",
      "code": "final response = await client.purchaseCreditNotes.getPurchaseCreditNotes(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "get_purchase_credit_note": {
      "function": "getPurchaseCreditNote",
      "code": "final response = await client.purchaseCreditNotes.getPurchaseCreditNote(\n  'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n);\nprint(response.map);"
    },
    "update_purchase_credit_note": {
      "function": "updatePurchaseCreditNote",
      "code": "final response = await client.purchaseCreditNotes.updatePurchaseCreditNote(\n  'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n  {\n    'purchase_credit_note': {'custom_attributes': []},\n  },\n);\nprint(response.map);"
    },
    "create_purchase_credit_note": {
      "function": "createPurchaseCreditNote",
      "code": "final response = await client.purchaseCreditNotes.createPurchaseCreditNote({\n  'purchase_credit_note': {\n    'purchase_invoice_id': 'PI-0001',\n    'amount': '1.00',\n  },\n});\nprint(response.map);"
    },
    "delete_purchase_credit_note": {
      "function": "deletePurchaseCreditNote",
      "code": "final response = await client.purchaseCreditNotes.deletePurchaseCreditNote(\n  'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n);\nprint(response.map);"
    },
    "apply_purchase_credit_note": {
      "function": "applyPurchaseCreditNote",
      "code": "final response = await client.purchaseCreditNotes.applyPurchaseCreditNote(\n  'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n  {\n    'purchase_credit_note': {\n      'purchase_invoices': [\n        {'purchase_invoice_id': 'PI-0001', 'amount': '1.00'},\n      ],\n    },\n  },\n);\nprint(response.map);"
    },
    "create_purchase_credit_note_note": {
      "function": "createPurchaseCreditNoteNote",
      "code": "import 'dart:io';\n\nfinal response = await client.purchaseCreditNotes\n    .createPurchaseCreditNoteNote(\n      'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n      '<p>Credit agreed with supplier.</p>',\n      files: {\n        'file': [\n          'delivery-note.pdf',\n          File('delivery-note.pdf').readAsBytesSync(),\n        ],\n      },\n    );\nprint(response.map);"
    },
    "delete_purchase_credit_note_note": {
      "function": "deletePurchaseCreditNoteNote",
      "code": "final response = await client.purchaseCreditNotes\n    .deletePurchaseCreditNoteNote(\n      'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n      'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n    );\nprint(response.map);"
    }
  }
}
