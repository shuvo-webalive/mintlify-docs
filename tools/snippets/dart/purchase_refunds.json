      "function": "getPurchaseRefund",
      "code": "final response = await client.purchaseRefunds.getPurchaseRefund('PR-0001');\nprint(response.map);"
    },
    "create_purchase_credit_note_purchase_refund": {
      "function": "createPurchaseCreditNotePurchaseRefund",
      "code": "final response = await client.purchaseRefunds\n    .createPurchaseCreditNotePurchaseRefund(\n      'pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b',\n      {\n        'purchase_refund': {\n          'amount': '0.50',\n          'payment_method': 'Acme Pty Ltd bank account',\n          'reference': 'REF-1001',\n          'note': 'Refund for returned stock.',\n        },\n      },\n    );\nprint(response.map);"
    },
    "update_purchase_refund": {
      "function": "updatePurchaseRefund",
      "code": "final response = await client.purchaseRefunds.updatePurchaseRefund(\n  'PR-0001',\n  {\n    'purchase_refund': {'reference': 'REF-1002'},\n  },\n);\nprint(response.map);"
    },
