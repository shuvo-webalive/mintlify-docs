{
  "sdk": "dart",
  "module": "credit_notes",
  "endpoints": {
    "get_credit_notes": {
      "function": "getCreditNotes",
      "code": "final response = await client.creditNotes.getCreditNotes(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "get_credit_note": {
      "function": "getCreditNote",
      "code": "final response = await client.creditNotes.getCreditNote(\n  'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n);\nprint(response.map);"
    },
    "update_credit_note": {
      "function": "updateCreditNote",
      "code": "final response = await client.creditNotes.updateCreditNote(\n  'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n  {\n    'credit_note': {'custom_attributes': []},\n  },\n);\nprint(response.map);"
    },
    "create_credit_note": {
      "function": "createCreditNote",
      "code": "final response = await client.creditNotes.createCreditNote({\n  'credit_note': {'invoice_id': 'INV-0001', 'amount': 5},\n});\nprint(response.map);"
    },
    "delete_credit_note": {
      "function": "deleteCreditNote",
      "code": "final response = await client.creditNotes.deleteCreditNote(\n  'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n);\nprint(response.map);"
    },
    "apply_credit_note": {
      "function": "applyCreditNote",
      "code": "final response = await client.creditNotes.applyCreditNote(\n  'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n  {\n    'credit_note': {\n      'invoices': [\n        {'invoice_id': 'INV-0001', 'amount': 5},\n      ],\n    },\n  },\n);\nprint(response.map);"
    },
    "get_credit_note_items": {
      "function": "getCreditNoteItems",
      "code": "final response = await client.creditNotes.getCreditNoteItems(\n  'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n);\nprint(response.map);"
    },
    "get_credit_note_credit_note_applications": {
      "function": "getCreditNoteCreditNoteApplications",
      "code": "final response = await client.creditNotes.getCreditNoteCreditNoteApplications(\n  'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n);\nprint(response.map);"
    },
    "get_credit_note_notes": {
      "function": "getCreditNoteNotes",
      "code": "final response = await client.creditNotes.getCreditNoteNotes(\n  'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "get_credit_note_note": {
      "function": "getCreditNoteNote",
      "code": "final response = await client.creditNotes.getCreditNoteNote(\n  'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n  'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n);\nprint(response.map);"
    },
    "create_credit_note_note": {
      "function": "createCreditNoteNote",
      "code": "import 'dart:io';\n\nfinal response = await client.creditNotes.createCreditNoteNote(\n  'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n  'Customer asked for a copy by post.',\n  files: {\n    'file': ['receipt.pdf', File('receipt.pdf').readAsBytesSync()],\n  },\n);\nprint(response.map);"
    },
    "delete_credit_note_note": {
      "function": "deleteCreditNoteNote",
      "code": "final response = await client.creditNotes.deleteCreditNoteNote(\n  'cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d',\n  'note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d',\n);\nprint(response.map);"
    },
    "get_credit_note_note_files": {
