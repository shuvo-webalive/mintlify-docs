{
  "sdk": "dart",
  "module": "custom_forms",
  "endpoints": {
    "get_settings_custom_forms": {
      "function": "getSettingsCustomForms",
      "code": "final response = await client.customForms.getSettingsCustomForms(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "create_settings_custom_form": {
      "function": "createSettingsCustomForm",
      "code": "final response = await client.customForms.createSettingsCustomForm({\n  'custom_form': {'name': 'acme-account-form', 'setting_group': 'ACCOUNT'},\n});\nprint(response.map);"
    },
    "get_settings_custom_form": {
      "function": "getSettingsCustomForm",
      "code": "final response = await client.customForms.getSettingsCustomForm(\n  'cf_8d2a4c6e0b1f4d3a9c7e5b2d1f0a8c6e',\n);\nprint(response.map);"
    },
    "delete_settings_custom_form": {
      "function": "deleteSettingsCustomForm",
      "code": "final response = await client.customForms.deleteSettingsCustomForm(\n  'cf_8d2a4c6e0b1f4d3a9c7e5b2d1f0a8c6e',\n);\nprint(response.map);"
    },
    "update_settings_custom_form": {
      "function": "updateSettingsCustomForm",
      "code": "final response = await client.customForms.updateSettingsCustomForm(\n  'cf_8d2a4c6e0b1f4d3a9c7e5b2d1f0a8c6e',\n  {\n    'custom_form': {\n      'display_name': 'Acme account form',\n      'description': 'The form Acme Pty Ltd uses for new accounts',\n    },\n  },\n);\nprint(response.map);"
    }
  }
}
