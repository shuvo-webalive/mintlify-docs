{
  "sdk": "dart",
  "module": "purchase_credit_note_applications",
  "endpoints": {
    "get_purchase_credit_note_applications": {
      "function": "getPurchaseCreditNoteApplications",
      "code": "final response = await client.purchaseCreditNoteApplications\n    .getPurchaseCreditNoteApplications(queryParams: {'limit': 20});\nprint(response.map);"
