      "code": "final response = await client.purchasePayments\n    .getPurchasePaymentPurchaseCreditNotes(\n      'PP-0001',\n      queryParams: {'limit': 20},\n    );\nprint(response.map);"
    },
    "update_purchase_payment_note": {
      "function": "updatePurchasePaymentNote",
      "code": "import 'dart:io';\n\nfinal response = await client.purchasePayments.updatePurchasePaymentNote(\n  'PP-0001',\n  'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n  '<p>Goods received in full.</p>',\n  files: {\n    'file': [\n      'delivery-note.pdf',\n      File('delivery-note.pdf').readAsBytesSync(),\n    ],\n  },\n);\nprint(response.map);"
    },
    "delete_purchase_payment_note_file": {
