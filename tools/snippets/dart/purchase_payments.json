{
  "sdk": "dart",
  "module": "purchase_payments",
  "endpoints": {
    "get_purchase_payments": {
      "function": "getPurchasePayments",
      "code": "final response = await client.purchasePayments.getPurchasePayments(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "create_purchase_payment": {
      "function": "createPurchasePayment",
      "code": "final response = await client.purchasePayments.createPurchasePayment({\n  'purchase_payment': {\n    'payment_method_applications': [\n      {'amount': '1.00', 'payment_processor': 'PROC-0001'},\n    ],\n    'purchase_invoice_applications': [\n      {'purchase_invoice': 'PI-0001', 'amount': '1.00'},\n    ],\n  },\n});\nprint(response.map);"
    },
    "delete_purchase_payment": {
      "function": "deletePurchasePayment",
      "code": "final response = await client.purchasePayments.deletePurchasePayment(\n  'PP-0001',\n);\nprint(response.map);"
    },
    "get_purchase_payment": {
      "function": "getPurchasePayment",
      "code": "final response = await client.purchasePayments.getPurchasePayment('PP-0001');\nprint(response.map);"
    },
    "update_purchase_payment": {
      "function": "updatePurchasePayment",
      "code": "final response = await client.purchasePayments.updatePurchasePayment(\n  'PP-0001',\n  {\n    'purchase_payment': {'payment_note': 'Paid by bank transfer.'},\n  },\n);\nprint(response.map);"
    },
    "create_purchase_invoice_purchase_payment": {
      "function": "createPurchaseInvoicePurchasePayment",
      "code": "final response = await client.purchasePayments\n    .createPurchaseInvoicePurchasePayment('PI-0001', {\n      'purchase_payment': {\n        'payment_method_applications': [\n          {'amount': '1.00', 'payment_processor': 'PROC-0001'},\n        ],\n      },\n    });\nprint(response.map);"
    },
    "get_purchase_payment_notes": {
      "function": "getPurchasePaymentNotes",
      "code": "final response = await client.purchasePayments.getPurchasePaymentNotes(\n  'PP-0001',\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "create_purchase_payment_note": {
      "function": "createPurchasePaymentNote",
      "code": "import 'dart:io';\n\nfinal response = await client.purchasePayments.createPurchasePaymentNote(\n  'PP-0001',\n  '<p>Goods received in full.</p>',\n  files: {\n    'file': [\n      'delivery-note.pdf',\n      File('delivery-note.pdf').readAsBytesSync(),\n    ],\n  },\n);\nprint(response.map);"
    },
    "get_purchase_payment_note": {
      "function": "getPurchasePaymentNote",
      "code": "final response = await client.purchasePayments.getPurchasePaymentNote(\n  'PP-0001',\n  'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n);\nprint(response.map);"
    },
    "delete_purchase_payment_note": {
      "function": "deletePurchasePaymentNote",
      "code": "final response = await client.purchasePayments.deletePurchasePaymentNote(\n  'PP-0001',\n  'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n);\nprint(response.map);"
    },
    "get_purchase_payment_note_files": {
      "function": "getPurchasePaymentNoteFiles",
      "code": "final response = await client.purchasePayments.getPurchasePaymentNoteFiles(\n  'PP-0001',\n  'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "get_purchase_payment_note_file": {
      "function": "getPurchasePaymentNoteFile",
      "code": "final response = await client.purchasePayments.getPurchasePaymentNoteFile(\n  'PP-0001',\n  'note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a',\n  '6b2c1d0e-4f3a-4b5c-8d9e-0f1a2b3c4d5e',\n);\nprint(response.map);"
    },
    "get_purchase_payment_purchase_credit_notes": {
