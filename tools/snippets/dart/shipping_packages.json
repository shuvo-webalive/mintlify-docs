{
  "sdk": "dart",
  "module": "shipping_packages",
  "endpoints": {
    "get_settings_shipping_packages": {
      "function": "getSettingsShippingPackages",
      "code": "final response = await client.shippingPackages.getSettingsShippingPackages(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "create_settings_shipping_package": {
      "function": "createSettingsShippingPackage",
      "code": "final response = await client.shippingPackages.createSettingsShippingPackage({\n  'shipping_package': {'name': 'Small box', 'length': 10, 'weight': 1.5},\n});\nprint(response.map);"
    },
    "get_settings_shipping_package": {
      "function": "getSettingsShippingPackage",
      "code": "final response = await client.shippingPackages.getSettingsShippingPackage(\n  'sp_2b3c4d5e6f708192a3b4c5d6e7f8091a',\n);\nprint(response.map);"
    },
    "delete_settings_shipping_package": {
      "function": "deleteSettingsShippingPackage",
      "code": "final response = await client.shippingPackages.deleteSettingsShippingPackage(\n  'sp_2b3c4d5e6f708192a3b4c5d6e7f8091a',\n);\nprint(response.map);"
    },
    "update_settings_shipping_package": {
      "function": "updateSettingsShippingPackage",
      "code": "final response = await client.shippingPackages.updateSettingsShippingPackage(\n  'sp_2b3c4d5e6f708192a3b4c5d6e7f8091a',\n  {\n    'shipping_package': {\n      'display_name': 'Small box',\n      'description': 'Up to 2 kg',\n    },\n  },\n);\nprint(response.map);"
    }
  }
}
