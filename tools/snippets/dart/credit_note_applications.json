{
  "sdk": "dart",
  "module": "credit_note_applications",
  "endpoints": {
    "get_credit_note_applications": {
      "function": "getCreditNoteApplications",
      "code": "final response = await client.creditNoteApplications\n    .getCreditNoteApplications(queryParams: {'limit': 20});\nprint(response.map);"
    },
    "get_credit_note_application": {
      "function": "getCreditNoteApplication",
      "code": "final response = await client.creditNoteApplications.getCreditNoteApplication(\n  'CNA-0001',\n);\nprint(response.map);"
    },
    "get_invoice_credit_note_applications": {
      "function": "getInvoiceCreditNoteApplications",
      "code": "final response = await client.creditNoteApplications\n    .getInvoiceCreditNoteApplications('INV-0001', queryParams: {'limit': 20});\nprint(response.map);"
    }
  }
}
