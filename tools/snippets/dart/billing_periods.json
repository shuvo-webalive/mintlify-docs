{
  "sdk": "dart",
  "module": "billing_periods",
  "endpoints": {
    "get_settings_billing_periods": {
      "function": "getSettingsBillingPeriods",
      "code": "final response = await client.billingPeriods.getSettingsBillingPeriods(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "create_settings_billing_period": {
      "function": "createSettingsBillingPeriod",
      "code": "final response = await client.billingPeriods.createSettingsBillingPeriod({\n  'billing_period': {\n    'name': 'Monthly billing',\n    'time_period': '2b1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d',\n  },\n});\nprint(response.map);"
    },
    "get_settings_billing_period": {
      "function": "getSettingsBillingPeriod",
      "code": "final response = await client.billingPeriods.getSettingsBillingPeriod(\n  'bp_181b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint(response.map);"
    },
    "delete_settings_billing_period": {
      "function": "deleteSettingsBillingPeriod",
      "code": "final response = await client.billingPeriods.deleteSettingsBillingPeriod(\n  'bp_181b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint(response.map);"
    },
    "update_settings_billing_period": {
      "function": "updateSettingsBillingPeriod",
      "code": "final response = await client.billingPeriods.updateSettingsBillingPeriod(\n  'bp_181b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n  {\n    'billing_period': {\n      'display_name': 'Monthly billing (AU)',\n      'description': 'Bills once a month',\n    },\n  },\n);\nprint(response.map);"
    }
  }
}
