{
  "sdk": "dart",
  "module": "proforma_invoices",
  "endpoints": {
    "get_proforma_invoices": {
      "function": "getProformaInvoices",
      "code": "final response = await client.proformaInvoices.getProformaInvoices(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "get_proforma_invoice": {
      "function": "getProformaInvoice",
      "code": "final response = await client.proformaInvoices.getProformaInvoice('PF-0001');\nprint(response.map);"
    },
    "delete_proforma_invoice": {
      "function": "deleteProformaInvoice",
      "code": "final response = await client.proformaInvoices.deleteProformaInvoice(\n  'PF-0001',\n);\nprint(response.map);"
    },
    "create_proforma_invoice_payment": {
      "function": "createProformaInvoicePayment",
      "code": "final response = await client.proformaInvoices.createProformaInvoicePayment(\n  'PF-0001',\n  {'payment': {}},\n);\nprint(response.map);"
    }
  }
}
