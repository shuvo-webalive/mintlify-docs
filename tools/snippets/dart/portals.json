{
  "sdk": "dart",
  "module": "portals",
  "endpoints": {
    "activate_portal": {
      "function": "activatePortal",
      "code": "final response = await client.portals.activatePortal({\n  'portal': {'code': 'abc123def456'},\n});\nprint(response.map);"
    },
    "create_portal_change_password": {
      "function": "createPortalChangePassword",
      "code": "final response = await client.portals.createPortalChangePassword({\n  'portal': {\n    'email': 'jane@example.com',\n    'current_password': 'current-password',\n    'new_password': 'new-password',\n  },\n});\nprint(response.map);"
    },
    "create_portal_login": {
      "function": "createPortalLogin",
      "code": "final response = await client.portals.createPortalLogin({\n  'portal': {'email': 'jane@example.com', 'password': 'current-password'},\n});\nprint(response.map);"
    },
    "create_portal_reset": {
      "function": "createPortalReset",
      "code": "final response = await client.portals.createPortalReset({\n  'portal': {\n    'code': 'abc123def456',\n    'email': 'jane@example.com',\n    'password': 'new-password',\n  },\n});\nprint(response.map);"
    },
    "create_portal_reset_link": {
      "function": "createPortalResetLink",
      "code": "final response = await client.portals.createPortalResetLink({\n  'portal': {'email': 'jane@example.com'},\n});\nprint(response.map);"
    },
    "create_portal_validate": {
      "function": "createPortalValidate",
      "code": "final response = await client.portals.createPortalValidate({\n  'portal': {'code': 'abc123def456'},\n});\nprint(response.map);"
    },
    "set_portal_password": {
      "function": "setPortalPassword",
      "code": "final response = await client.portals.setPortalPassword({\n  'portal': {'email': 'jane@example.com', 'password': 'new-password'},\n});\nprint(response.map);"
    }
  }
}
