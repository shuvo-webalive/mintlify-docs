{
  "sdk": "dart",
  "module": "item_fulfillments",
  "endpoints": {
    "get_item_fulfillments": {
      "function": "getItemFulfillments",
      "code": "final response = await client.itemFulfillments.getItemFulfillments(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "create_item_fulfillment": {
      "function": "createItemFulfillment",
      "code": "final response = await client.itemFulfillments.createItemFulfillment({\n  'item_fulfillment': {\n    'invoice_id': 'INV-0001',\n    'fulfillments': [\n      {\n        'invoice_line': '8e7d6c5b-4a39-4281-9706-f5e4d3c2b1a0',\n        'fulfillment_quantity': 1,\n      },\n    ],\n  },\n});\nprint(response.map);"
    },
    "get_item_fulfillment": {
      "function": "getItemFulfillment",
      "code": "final response = await client.itemFulfillments.getItemFulfillment(\n  'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n);\nprint(response.map);"
    },
    "update_item_fulfillment": {
      "function": "updateItemFulfillment",
      "code": "final response = await client.itemFulfillments.updateItemFulfillment(\n  'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n  {\n    'item_fulfillment': {'tracking_number': 'TRK-0001'},\n  },\n);\nprint(response.map);"
    },
    "create_item_fulfillment_note": {
      "function": "createItemFulfillmentNote",
      "code": "import 'dart:io';\n\nfinal response = await client.itemFulfillments.createItemFulfillmentNote(\n  'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n  '<p>Left with reception.</p>',\n  files: {\n    'file': [\n      'delivery-photo.jpg',\n      File('delivery-photo.jpg').readAsBytesSync(),\n    ],\n  },\n);\nprint(response.map);"
    },
    "delete_item_fulfillment": {
      "function": "deleteItemFulfillment",
      "code": "final response = await client.itemFulfillments.deleteItemFulfillment(\n  'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n);\nprint(response.map);"
    },
    "delete_item_fulfillment_note": {
      "function": "deleteItemFulfillmentNote",
      "code": "final response = await client.itemFulfillments.deleteItemFulfillmentNote(\n  'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n  'note_b1c2d3e4f5061728394a5b6c7d8e9f00',\n);\nprint(response.map);"
    },
    "get_item_fulfillment_notes": {
