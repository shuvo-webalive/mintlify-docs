    },
    "get_item_fulfillment_note": {
      "function": "getItemFulfillmentNote",
      "code": "final response = await client.itemFulfillments.getItemFulfillmentNote(\n  'ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9',\n  'note_b1c2d3e4f5061728394a5b6c7d8e9f00',\n);\nprint(response.map);"
    }
