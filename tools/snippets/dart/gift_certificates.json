{
  "sdk": "dart",
  "module": "gift_certificates",
  "endpoints": {
    "get_gift_certificates": {
      "function": "getGiftCertificates",
      "code": "final response = await client.giftCertificates.getGiftCertificates(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "create_gift_certificate": {
      "function": "createGiftCertificate",
      "code": "final response = await client.giftCertificates.createGiftCertificate({\n  'gift_certificate': {'amount': '5.00', 'expiry_date': '2027-10-01'},\n});\nprint(response.map);"
    },
    "delete_gift_certificate": {
      "function": "deleteGiftCertificate",
      "code": "final response = await client.giftCertificates.deleteGiftCertificate(\n  'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n);\nprint(response.map);"
    },
    "get_gift_certificate": {
      "function": "getGiftCertificate",
      "code": "final response = await client.giftCertificates.getGiftCertificate(\n  'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n);\nprint(response.map);"
    },
    "update_gift_certificate": {
      "function": "updateGiftCertificate",
      "code": "final response = await client.giftCertificates.updateGiftCertificate(\n  'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n  {\n    'gift_certificate': {'expiry_date': '2027-12-31'},\n  },\n);\nprint(response.map);"
    },
    "get_gift_certificate_allocations": {
      "function": "getGiftCertificateAllocations",
      "code": "final response = await client.giftCertificates.getGiftCertificateAllocations(\n  'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "get_gift_certificate_transactions": {
      "function": "getGiftCertificateTransactions",
      "code": "final response = await client.giftCertificates.getGiftCertificateTransactions(\n  'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "amend_gift_certificate": {
      "function": "amendGiftCertificate",
      "code": "final response = await client.giftCertificates.amendGiftCertificate(\n  'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n  {\n    'gift_certificate': {'new_balance': '7.00'},\n  },\n);\nprint(response.map);"
    },
    "allocate_gift_certificate": {
      "function": "allocateGiftCertificate",
      "code": "final response = await client.giftCertificates.allocateGiftCertificate(\n  'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n  {\n    'gift_certificate': {\n      'account': {'code': 'W13ZGY'},\n    },\n  },\n);\nprint(response.map);"
    },
    "deallocate_gift_certificate": {
      "function": "deallocateGiftCertificate",
      "code": "final response = await client.giftCertificates.deallocateGiftCertificate(\n  'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n  {\n    'gift_certificate': {\n      'account': {'code': 'W13ZGY'},\n    },\n  },\n);\nprint(response.map);"
    },
    "get_gift_certificate_allocation": {
      "function": "getGiftCertificateAllocation",
      "code": "final response = await client.giftCertificates.getGiftCertificateAllocation(\n  'gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f',\n  'gca_1d4f7a2c9e5b4083b6a1c2d3e4f5a6b7',\n);\nprint(response.map);"
    },
    "get_gift_certificate_transaction": {
