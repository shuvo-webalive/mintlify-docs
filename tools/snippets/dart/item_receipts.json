{
  "sdk": "dart",
  "module": "item_receipts",
  "endpoints": {
    "get_item_receipts": {
      "function": "getItemReceipts",
      "code": "final response = await client.itemReceipts.getItemReceipts(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "create_item_receipt": {
      "function": "createItemReceipt",
      "code": "final response = await client.itemReceipts.createItemReceipt({\n  'item_receipt': {\n    'purchase_order': 'PO-0001',\n    'receipt_status': 'STARTED',\n    'receipt_date': '2026-10-01',\n    'lines': [\n      {\n        'purchase_order_line': 'd4c3b2a1-0f9e-4d8c-b7a6-958473625140',\n        'receipt_quantity': 1,\n      },\n    ],\n  },\n});\nprint(response.map);"
    },
    "update_item_receipt": {
      "function": "updateItemReceipt",
      "code": "final response = await client.itemReceipts.updateItemReceipt(\n  'ir_4e5f60718293a4b5c6d7e8f90a1b2c3d',\n  {\n    'item_receipt': {'tracking_number': 'TRK-0001'},\n  },\n);\nprint(response.map);"
    },
    "get_item_receipt": {
      "function": "getItemReceipt",
      "code": "final response = await client.itemReceipts.getItemReceipt(\n  'ir_4e5f60718293a4b5c6d7e8f90a1b2c3d',\n);\nprint(response.map);"
    },
    "get_purchase_order_item_receipts": {
      "function": "getPurchaseOrderItemReceipts",
      "code": "final response = await client.itemReceipts.getPurchaseOrderItemReceipts(\n  'PO-0001',\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "delete_item_receipt": {
      "function": "deleteItemReceipt",
      "code": "final response = await client.itemReceipts.deleteItemReceipt(\n  'ir_4e5f60718293a4b5c6d7e8f90a1b2c3d',\n);\nprint(response.map);"
    },
    "delete_item_receipt_note": {
      "function": "deleteItemReceiptNote",
      "code": "final response = await client.itemReceipts.deleteItemReceiptNote(\n  'ir_4e5f60718293a4b5c6d7e8f90a1b2c3d',\n  'note_c2d3e4f5061728394a5b6c7d8e9f0011',\n);\nprint(response.map);"
    }
  }
}
