{
  "sdk": "dart",
  "module": "applications",
  "endpoints": {
    "get_settings_applications": {
      "function": "getSettingsApplications",
      "code": "final response = await client.applications.getSettingsApplications(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "create_settings_application": {
      "function": "createSettingsApplication",
      "code": "final response = await client.applications.createSettingsApplication({\n  'application': {\n    'name': 'Acme Integration',\n    'redirect_url': 'https://example.com/callback',\n  },\n});\nprint(response.map);"
    },
    "get_settings_application": {
      "function": "getSettingsApplication",
      "code": "final response = await client.applications.getSettingsApplication(\n  'app_0123456789abcdef',\n);\nprint(response.map);"
    },
    "delete_settings_application": {
      "function": "deleteSettingsApplication",
      "code": "final response = await client.applications.deleteSettingsApplication(\n  'app_0123456789abcdef',\n);\nprint(response.map);"
    },
    "update_settings_application": {
      "function": "updateSettingsApplication",
      "code": "final response = await client.applications.updateSettingsApplication(\n  'app_0123456789abcdef',\n  {\n    'application': {\n      'display_name': 'Acme Integration',\n      'description': 'Syncs orders with Acme',\n    },\n  },\n);\nprint(response.map);"
    }
  }
}
