{
  "sdk": "dart",
  "module": "countries",
  "endpoints": {
    "get_settings_countries": {
      "function": "getSettingsCountries",
      "code": "final response = await client.countries.getSettingsCountries(\n  queryParams: {'limit': 100},\n);\nprint(response.map);"
    },
    "get_settings_country": {
      "function": "getSettingsCountry",
      "code": "final response = await client.countries.getSettingsCountry(\n  'country_111b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint(response.map);"
    },
    "update_settings_country": {
      "function": "updateSettingsCountry",
      "code": "final response = await client.countries.updateSettingsCountry(\n  'country_111b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n  {\n    'country': {'description': 'Antarctica'},\n  },\n);\nprint(response.map);"
    }
  }
}
