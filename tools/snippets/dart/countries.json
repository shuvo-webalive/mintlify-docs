{
  "sdk": "dart",
  "module": "countries",
  "endpoints": {
    "get_settings_countries": {
      "function": "getSettingsCountries",
      "code": "final response = await client.countries.getSettingsCountries(\n  queryParams: {'limit': 100},\n);\nprint(response.map);"
    },
    "get_settings_country": {
      "function": "getSettingsCountry",
      "code": "final response = await client.countries.getSettingsCountry(\n  'country_e909c2d7067ea37437cf97fe11d91bd0',\n);\nprint(response.map);"
    },
    "update_settings_country": {
      "function": "updateSettingsCountry",
      "code": "final response = await client.countries.updateSettingsCountry(\n  'country_e909c2d7067ea37437cf97fe11d91bd0',\n  {\n    'country': {'description': 'Antarctica'},\n  },\n);\nprint(response.map);"
    }
  }
}
