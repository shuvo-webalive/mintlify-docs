{
  "sdk": "dart",
  "module": "accounting_codes",
  "endpoints": {
    "get_settings_accounting_codes": {
      "function": "getSettingsAccountingCodes",
      "code": "final response = await client.accountingCodes.getSettingsAccountingCodes(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "create_settings_accounting_code": {
      "function": "createSettingsAccountingCode",
      "code": "final response = await client.accountingCodes.createSettingsAccountingCode({\n  'accounting_code': {\n    'name': 'Consulting revenue',\n    'account_code_type': 'sales_revenue',\n    'gl_account_number': '940215',\n  },\n});\nprint(response.map);"
    },
    "get_settings_accounting_code": {
      "function": "getSettingsAccountingCode",
      "code": "final response = await client.accountingCodes.getSettingsAccountingCode(\n  '121b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint(response.map);"
    },
    "delete_settings_accounting_code": {
      "function": "deleteSettingsAccountingCode",
      "code": "final response = await client.accountingCodes.deleteSettingsAccountingCode(\n  '121b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n);\nprint(response.map);"
    },
    "update_settings_accounting_code": {
      "function": "updateSettingsAccountingCode",
      "code": "final response = await client.accountingCodes.updateSettingsAccountingCode(\n  '121b2c3d4e5f4a6b8c7d9e0f1a2b3c4d',\n  {\n    'accounting_code': {\n      'display_name': 'Consulting revenue (AU)',\n      'description': 'Revenue from consulting work',\n    },\n  },\n);\nprint(response.map);"
    }
  }
}
