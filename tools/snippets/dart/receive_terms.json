{
  "sdk": "dart",
  "module": "receive_terms",
  "endpoints": {
    "get_settings_receive_terms": {
      "function": "getSettingsReceiveTerms",
      "code": "final response = await client.receiveTerms.getSettingsReceiveTerms(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "create_settings_receive_term": {
      "function": "createSettingsReceiveTerm",
      "code": "final response = await client.receiveTerms.createSettingsReceiveTerm({\n  'receive_term': {\n    'name': 'net-30',\n    'display_name': 'Net 30',\n    'period': 'MONTHLY',\n    'duration': 1,\n  },\n});\nprint(response.map);"
    },
    "get_settings_receive_term": {
      "function": "getSettingsReceiveTerm",
      "code": "final response = await client.receiveTerms.getSettingsReceiveTerm('RT-0001');\nprint(response.map);"
    },
    "delete_settings_receive_term": {
      "function": "deleteSettingsReceiveTerm",
      "code": "final response = await client.receiveTerms.deleteSettingsReceiveTerm(\n  'RT-0001',\n);\nprint(response.map);"
    },
    "update_settings_receive_term": {
      "function": "updateSettingsReceiveTerm",
      "code": "final response = await client.receiveTerms.updateSettingsReceiveTerm(\n  'RT-0001',\n  {\n    'receive_term': {\n      'display_name': 'Net 30 days',\n      'description': 'Goods received within one month.',\n    },\n  },\n);\nprint(response.map);"
    }
  }
}
