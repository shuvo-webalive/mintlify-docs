{
  "sdk": "dart",
  "module": "custom_attributes",
  "endpoints": {
    "get_custom_attributes": {
      "function": "getCustomAttributes",
      "code": "final response = await client.customAttributes.getCustomAttributes(\n  queryParams: {'limit': 20},\n);\nprint(response.map);"
    },
    "create_custom_attribute": {
      "function": "createCustomAttribute",
      "code": "final response = await client.customAttributes.createCustomAttribute({\n  'custom_attribute': {\n    'name': 'contract_tier',\n    'display_name': 'Contract tier',\n    'type': 'STRING',\n  },\n});\nprint(response.map);"
    },
    "delete_custom_attribute": {
      "function": "deleteCustomAttribute",
      "code": "final response = await client.customAttributes.deleteCustomAttribute(\n  'f3a8c1d6e2b94a7c8d5e0f1a2b3c4d5e',\n);\nprint(response.map);"
    },
    "get_custom_attribute": {
      "function": "getCustomAttribute",
      "code": "final response = await client.customAttributes.getCustomAttribute(\n  'f3a8c1d6e2b94a7c8d5e0f1a2b3c4d5e',\n);\nprint(response.map);"
    },
    "update_custom_attribute": {
      "function": "updateCustomAttribute",
      "code": "final response = await client.customAttributes.updateCustomAttribute(\n  'f3a8c1d6e2b94a7c8d5e0f1a2b3c4d5e',\n  {\n    'custom_attribute': {\n      'display_name': 'Contract tier (updated)',\n      'description': 'The customer\\'s support contract tier',\n    },\n  },\n);\nprint(response.map);"
    }
  }
}
