{
  "sdk": "python",
  "module": "approval_profiles",
  "endpoints": {
    "get_settings_approval_profiles": {
      "function": "get_settings_approval_profiles",
      "code": "response = client.approval_profiles.get_settings_approval_profiles({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_approval_profile": {
      "function": "create_settings_approval_profile",
      "code": "response = client.approval_profiles.create_settings_approval_profile(\n    {\n        \"approval_profile\": {\n            \"name\": \"Large order approval\",\n            \"entity\": \"account\",\n            \"event\": \"<event name>\",\n            \"approver_type\": \"<approver type>\",\n            \"approver\": \"<approver>\",\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_settings_approval_profile": {
      "function": "get_settings_approval_profile",
      "code": "response = client.approval_profiles.get_settings_approval_profile(\n    \"ap_0c2e4a6b8d1f4c3e5a7b9d0f2a4c6e8b\"\n)\nprint(response.data)\n"
    },
    "delete_settings_approval_profile": {
      "function": "delete_settings_approval_profile",
      "code": "response = client.approval_profiles.delete_settings_approval_profile(\n    \"ap_0c2e4a6b8d1f4c3e5a7b9d0f2a4c6e8b\"\n)\nprint(response.data)\n"
    },
    "update_settings_approval_profile": {
      "function": "update_settings_approval_profile",
      "code": "response = client.approval_profiles.update_settings_approval_profile(\n    \"ap_0c2e4a6b8d1f4c3e5a7b9d0f2a4c6e8b\",\n    {\"approval_profile\": {\"display_name\": \"Large order approval (finance)\"}},\n)\nprint(response.data)\n"
    }
  }
}
