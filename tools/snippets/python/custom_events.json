{
  "sdk": "python",
  "module": "custom_events",
  "endpoints": {
    "get_settings_custom_events": {
      "function": "get_settings_custom_events",
      "code": "response = client.custom_events.get_settings_custom_events({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_custom_event": {
      "function": "create_settings_custom_event",
      "code": "response = client.custom_events.create_settings_custom_event(\n    {\n        \"custom_event\": {\n            \"name\": \"Order approved by finance\",\n            \"base_event\": \"se_1d3f5a7c9e2b4d6f8a0c2e4b6d8f0a2c\",\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_settings_custom_event": {
      "function": "get_settings_custom_event",
      "code": "response = client.custom_events.get_settings_custom_event(\n    \"ce_8b0d2f4a6c8e4b1d3f5a7c9e1b3d5f7a\"\n)\nprint(response.data)\n"
    },
    "delete_settings_custom_event": {
      "function": "delete_settings_custom_event",
      "code": "response = client.custom_events.delete_settings_custom_event(\n    \"ce_8b0d2f4a6c8e4b1d3f5a7c9e1b3d5f7a\"\n)\nprint(response.data)\n"
    },
    "update_settings_custom_event": {
      "function": "update_settings_custom_event",
      "code": "response = client.custom_events.update_settings_custom_event(\n    \"ce_8b0d2f4a6c8e4b1d3f5a7c9e1b3d5f7a\",\n    {\"custom_event\": {\"display_name\": \"Order approved by finance team\"}},\n)\nprint(response.data)\n"
    }
  }
