{
  "sdk": "python",
  "module": "billing_periods",
  "endpoints": {
    "get_settings_billing_periods": {
      "function": "get_settings_billing_periods",
      "code": "response = client.billing_periods.get_settings_billing_periods({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_billing_period": {
      "function": "create_settings_billing_period",
      "code": "response = client.billing_periods.create_settings_billing_period(\n    {\n        \"billing_period\": {\n            \"name\": \"Monthly billing\",\n            \"time_period\": \"2b1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d\",\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_settings_billing_period": {
      "function": "get_settings_billing_period",
      "code": "response = client.billing_periods.get_settings_billing_period(\n    \"bp_181b2c3d4e5f4a6b8c7d9e0f1a2b3c4d\"\n)\nprint(response.data)\n"
    },
    "delete_settings_billing_period": {
      "function": "delete_settings_billing_period",
      "code": "response = client.billing_periods.delete_settings_billing_period(\n    \"bp_181b2c3d4e5f4a6b8c7d9e0f1a2b3c4d\"\n)\nprint(response.data)\n"
    },
    "update_settings_billing_period": {
      "function": "update_settings_billing_period",
      "code": "response = client.billing_periods.update_settings_billing_period(\n    \"bp_181b2c3d4e5f4a6b8c7d9e0f1a2b3c4d\",\n    {\n        \"billing_period\": {\n            \"display_name\": \"Monthly billing (AU)\",\n            \"description\": \"Bills once a month\",\n        }\n    },\n)\nprint(response.data)\n"
    }
  }
}
