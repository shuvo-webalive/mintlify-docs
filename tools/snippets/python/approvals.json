{
  "sdk": "python",
  "module": "approvals",
  "endpoints": {
    "get_approvals_account": {
      "function": "get_approvals_account",
      "code": "response = client.approvals.get_approvals_account({\"limit\": 20})\nprint(response.data)\n"
    },
    "get_approvals_saleorder": {
      "function": "get_approvals_saleorder",
      "code": "response = client.approvals.get_approvals_saleorder({\"limit\": 20})\nprint(response.data)\n"
    },
    "get_approvals_account_by_uuid": {
      "function": "get_approvals_account_by_uuid",
      "code": "response = client.approvals.get_approvals_account_by_uuid(\n    \"1a3c5e7b-9d2f-4b6d-8f0a-2c4e6b8d0f1a\"\n)\nprint(response.data)\n"
    },
    "approve_approval": {
      "function": "approve_approval",
      "code": "response = client.approvals.approve_approval(\n    {\n        \"approval\": {\n            \"entity\": \"account\",\n            \"resource_id\": \"W13ZGY\",\n            \"note\": \"Checked and approved.\",\n        }\n    }\n)\nprint(response.data)\n"
    },
    "reject_approval": {
      "function": "reject_approval",
      "code": "response = client.approvals.reject_approval(\n    {\n        \"approval\": {\n            \"entity\": \"account\",\n            \"resource_id\": \"W13ZGY\",\n            \"note\": \"Missing billing details.\",\n        }\n    }\n)\nprint(response.data)\n"
    }
  }
}
