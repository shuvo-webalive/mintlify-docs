{
  "sdk": "python",
  "module": "communication_profiles",
  "endpoints": {
    "get_settings_communication_profiles": {
      "function": "get_settings_communication_profiles",
      "code": "response = client.communication_profiles.get_settings_communication_profiles(\n    {\"limit\": 20}\n)\nprint(response.data)\n"
    },
    "create_settings_communication_profile": {
      "function": "create_settings_communication_profile",
      "code": "response = client.communication_profiles.create_settings_communication_profile(\n    {\"communication_profile\": {\"name\": \"Wholesale notices\"}}\n)\nprint(response.data)\n"
    },
    "get_settings_communication_profile": {
      "function": "get_settings_communication_profile",
      "code": "response = client.communication_profiles.get_settings_communication_profile(\n    \"cmp_7b2d9e4a1c6f4b8d9a3e5c1f2b4d6a8e\"\n)\nprint(response.data)\n"
    },
    "update_settings_communication_profile": {
      "function": "update_settings_communication_profile",
      "code": "response = client.communication_profiles.update_settings_communication_profile(\n    \"cmp_7b2d9e4a1c6f4b8d9a3e5c1f2b4d6a8e\",\n    {\n        \"communication_profile\": {\n            \"display_name\": \"Wholesale notices\",\n            \"description\": \"Messages for wholesale accounts\",\n        }\n    },\n)\nprint(response.data)\n"
    },
    "delete_settings_communication_profile": {
      "function": "delete_settings_communication_profile",
      "code": "response = client.communication_profiles.delete_settings_communication_profile(\n    \"cmp_7b2d9e4a1c6f4b8d9a3e5c1f2b4d6a8e\"\n)\nprint(response.data)\n"
    }
  }
}
