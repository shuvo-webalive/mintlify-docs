  "endpoints": {
    "get_settings_time_periods": {
      "function": "get_settings_time_periods",
      "code": "response = client.time_periods.get_settings_time_periods({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_time_period": {
      "function": "create_settings_time_period",
      "code": "response = client.time_periods.create_settings_time_period(\n    {\n        \"time_period\": {\n            \"name\": \"One month\",\n            \"display_name\": \"One month\",\n            \"period\": \"MONTHLY\",\n            \"duration\": 1,\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_settings_time_period": {
      "function": "get_settings_time_period",
      "code": "response = client.time_periods.get_settings_time_period(\n    \"tp_5d2e8f1a9b3c4d7e8f0a1b2c3d4e5f6a\"\n)\nprint(response.data)\n"
    },
    "delete_settings_time_period": {
      "function": "delete_settings_time_period",
      "code": "response = client.time_periods.delete_settings_time_period(\n    \"tp_5d2e8f1a9b3c4d7e8f0a1b2c3d4e5f6a\"\n)\nprint(response.data)\n"
    },
    "update_settings_time_period": {
      "function": "update_settings_time_period",
      "code": "response = client.time_periods.update_settings_time_period(\n    \"tp_5d2e8f1a9b3c4d7e8f0a1b2c3d4e5f6a\",\n    {\n        \"time_period\": {\n            \"display_name\": \"One calendar month\",\n            \"description\": \"Used for monthly billing\",\n        }\n    },\n)\nprint(response.data)\n"
    }
  }
}
