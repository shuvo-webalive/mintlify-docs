{
  "sdk": "python",
  "module": "fulfillment_terms",
  "endpoints": {
    "get_settings_fulfillment_terms": {
      "function": "get_settings_fulfillment_terms",
      "code": "response = client.fulfillment_terms.get_settings_fulfillment_terms({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_fulfillment_term": {
      "function": "create_settings_fulfillment_term",
      "code": "response = client.fulfillment_terms.create_settings_fulfillment_term(\n    {\n        \"fulfillment_term\": {\n            \"name\": \"One month\",\n            \"display_name\": \"One month\",\n            \"period\": \"MONTHLY\",\n            \"duration\": 1,\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_settings_fulfillment_term": {
      "function": "get_settings_fulfillment_term",
      "code": "response = client.fulfillment_terms.get_settings_fulfillment_term(\n    \"ft_6e7f8091a2b3c4d5e6f708192a3b4c5d\"\n)\nprint(response.data)\n"
    },
    "delete_settings_fulfillment_term": {
      "function": "delete_settings_fulfillment_term",
      "code": "response = client.fulfillment_terms.delete_settings_fulfillment_term(\n    \"ft_6e7f8091a2b3c4d5e6f708192a3b4c5d\"\n)\nprint(response.data)\n"
    },
    "update_settings_fulfillment_term": {
      "function": "update_settings_fulfillment_term",
      "code": "response = client.fulfillment_terms.update_settings_fulfillment_term(\n    \"ft_6e7f8091a2b3c4d5e6f708192a3b4c5d\",\n    {\n        \"fulfillment_term\": {\n            \"display_name\": \"One month\",\n            \"description\": \"Fulfill within a month\",\n        }\n    },\n)\nprint(response.data)\n"
    }
  }
}
