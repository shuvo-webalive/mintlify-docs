{
  "sdk": "python",
  "module": "external_databases",
  "endpoints": {
    "get_external_databases": {
      "function": "get_external_databases",
      "code": "response = client.external_databases.get_external_databases()\nprint(response.data)\n"
    },
    "create_external_database": {
      "function": "create_external_database",
      "code": "response = client.external_databases.create_external_database(\n    {\n        \"external_database\": {\n            \"name\": \"acmedb\",\n            \"tables\": [\n                {\n                    \"table_name\": \"contacts\",\n                    \"fields\": [\"company\"],\n                    \"records\": [\n                        {\"record\": [{\"field\": \"company\", \"value\": \"Acme Pty Ltd\"}]}\n                    ],\n                }\n            ],\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_external_database": {
      "function": "get_external_database",
      "code": "response = client.external_databases.get_external_database(\"acmedb\")\nprint(response.data)\n"
    },
    "create_external_database_insert_record": {
      "function": "create_external_database_insert_record",
      "code": "response = client.external_databases.create_external_database_insert_record(\n    \"acmedb\",\n    {\n        \"table_name\": \"contacts\",\n        \"records\": [{\"record\": [{\"field\": \"company\", \"value\": \"Example Holdings\"}]}],\n    },\n)\nprint(response.data)\n"
    },
    "create_external_database_search": {
      "function": "create_external_database_search",
      "code": "response = client.external_databases.create_external_database_search(\n    \"acmedb\", {\"table_name\": \"contacts\"}\n)\nprint(response.data)\n"
    },
    "update_external_database_update_records": {
      "function": "update_external_database_update_records",
      "code": "response = client.external_databases.update_external_database_update_records(\n    \"acmedb\",\n    {\n        \"table_name\": \"contacts\",\n        \"update_fields\": [{\"field_name\": \"company\", \"field_value\": \"Acme Group\"}],\n        \"where_condition\": {\n            \"field_name\": \"company\",\n            \"operator\": \"=\",\n            \"field_value\": \"Acme Pty Ltd\",\n        },\n    },\n)\nprint(response.data)\n"
    },
    "get_external_database_table": {
      "function": "get_external_database_table",
      "code": "response = client.external_databases.get_external_database_table(\"acmedb\", \"contacts\")\nprint(response.data)\n"
    }
  }
}
