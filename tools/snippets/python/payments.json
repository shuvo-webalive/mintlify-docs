      "code": "response = client.payments.get_payments({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_payment": {
      "function": "create_payment",
      "code": "response = client.payments.create_payment(\n    {\n        \"payment\": {\n            \"date\": \"2026-10-01\",\n            \"payment_note\": \"October invoice\",\n            \"payment_applied\": [\n                {\"processor\": \"Cash\", \"amount\": \"10.00\", \"reference\": \"RCPT-1001\"}\n            ],\n            \"invoices\": [{\"id\": \"INV-0001\", \"applied\": \"10.00\"}],\n        }\n    }\n)\nprint(response.data)\n"
    },
