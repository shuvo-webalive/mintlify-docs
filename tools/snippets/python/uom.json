{
  "sdk": "python",
  "module": "uom",
  "endpoints": {
    "get_settings_uoms": {
      "function": "get_settings_uoms",
      "code": "response = client.uom.get_settings_uoms({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_uom": {
      "function": "create_settings_uom",
      "code": "response = client.uom.create_settings_uom(\n    {\"uom\": {\"name\": \"Centimetre\", \"type\": \"LENGTH\"}}\n)\nprint(response.data)\n"
    },
    "get_settings_uom": {
      "function": "get_settings_uom",
      "code": "response = client.uom.get_settings_uom(\"uom_1a2b3c4d5e6f708192a3b4c5d6e7f809\")\nprint(response.data)\n"
    },
    "delete_settings_uom": {
      "function": "delete_settings_uom",
      "code": "response = client.uom.delete_settings_uom(\"uom_1a2b3c4d5e6f708192a3b4c5d6e7f809\")\nprint(response.data)\n"
    },
    "update_settings_uom": {
      "function": "update_settings_uom",
      "code": "response = client.uom.update_settings_uom(\n    \"uom_1a2b3c4d5e6f708192a3b4c5d6e7f809\",\n    {\"uom\": {\"display_name\": \"Centimetre\", \"description\": \"Metric length unit\"}},\n)\nprint(response.data)\n"
    }
  }
