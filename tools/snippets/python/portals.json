{
  "sdk": "python",
  "module": "portals",
  "endpoints": {
    "activate_portal": {
      "function": "activate_portal",
      "code": "response = client.portals.activate_portal({\"portal\": {\"code\": \"abc123def456\"}})\nprint(response.data)\n"
    },
    "create_portal_change_password": {
      "function": "create_portal_change_password",
      "code": "response = client.portals.create_portal_change_password(\n    {\n        \"portal\": {\n            \"email\": \"jane@example.com\",\n            \"current_password\": \"OldPassw0rd!\",\n            \"new_password\": \"NewPassw0rd!\",\n        }\n    }\n)\nprint(response.data)\n"
    },
    "create_portal_login": {
      "function": "create_portal_login",
      "code": "response = client.portals.create_portal_login(\n    {\"portal\": {\"email\": \"jane@example.com\", \"password\": \"Passw0rd!\"}}\n)\nprint(response.data)\n"
    },
    "create_portal_reset": {
      "function": "create_portal_reset",
      "code": "response = client.portals.create_portal_reset(\n    {\n        \"portal\": {\n            \"code\": \"abc123def456\",\n            \"email\": \"jane@example.com\",\n            \"password\": \"NewPassw0rd!\",\n        }\n    }\n)\nprint(response.data)\n"
    },
    "create_portal_reset_link": {
      "function": "create_portal_reset_link",
      "code": "response = client.portals.create_portal_reset_link(\n    {\"portal\": {\"email\": \"jane@example.com\"}}\n)\nprint(response.data)\n"
    },
    "create_portal_validate": {
      "function": "create_portal_validate",
      "code": "response = client.portals.create_portal_validate({\"portal\": {\"code\": \"abc123def456\"}})\nprint(response.data)\n"
    },
    "set_portal_password": {
      "function": "set_portal_password",
      "code": "response = client.portals.set_portal_password(\n    {\"portal\": {\"email\": \"jane@example.com\", \"password\": \"NewPassw0rd!\"}}\n)\nprint(response.data)\n"
    }
  }
}
