{
  "sdk": "python",
  "module": "credit_note_applications",
  "endpoints": {
    "get_credit_note_applications": {
      "function": "get_credit_note_applications",
      "code": "response = client.credit_note_applications.get_credit_note_applications({\"limit\": 20})\nprint(response.data)\n"
    },
    "get_credit_note_application": {
      "function": "get_credit_note_application",
      "code": "response = client.credit_note_applications.get_credit_note_application(\"CNA-0001\")\nprint(response.data)\n"
    },
    "get_invoice_credit_note_applications": {
      "function": "get_invoice_credit_note_applications",
      "code": "response = client.credit_note_applications.get_invoice_credit_note_applications(\n    \"INV-0001\", {\"limit\": 20}\n)\nprint(response.data)\n"
    }
  }
}
