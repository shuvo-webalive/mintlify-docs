      "code": "response = client.rental_assets.get_rental_assets({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_rental_asset": {
      "function": "create_rental_asset",
      "code": "response = client.rental_assets.create_rental_asset(\n    {\n        \"rental_asset\": {\n            \"name\": \"Projector 1\",\n            \"rental_asset_profile\": \"RENTAL_ASSET_PROFILE_ID\",\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_rental_asset_profile": {
      "function": "get_rental_asset_profile",
