      "code": "response = client.rental_assets.update_rental_asset_profile(\n    \"RENTAL_ASSET_PROFILE_ID\",\n    {\"rental_asset_profile\": {\"display_name\": \"Standard daily rate, weekdays\"}},\n)\nprint(response.data)\n"
    },
    "delete_rental_asset_profile": {
      "function": "delete_rental_asset_profile",
      "code": "response = client.rental_assets.delete_rental_asset_profile(\"RENTAL_ASSET_PROFILE_ID\")\nprint(response.data)\n"
    },
    "update_rental_asset": {
      "function": "update_rental_asset",
      "code": "response = client.rental_assets.update_rental_asset(\n    \"RENTAL_ASSET_ID\", {\"rental_asset\": {\"description\": \"Ceiling mounted projector\"}}\n)\nprint(response.data)\n"
