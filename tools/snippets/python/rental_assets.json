{
  "sdk": "python",
  "module": "rental_assets",
  "endpoints": {
    "get_rental_asset_availability": {
      "function": "get_rental_asset_availability",
      "code": "response = client.rental_assets.get_rental_asset_availability({\"limit\": 20})\nprint(response.data)\n"
    },
    "update_rental_asset_availability": {
      "function": "update_rental_asset_availability",
      "code": "response = client.rental_assets.update_rental_asset_availability(\n    {\n        \"rental_assets\": [\n            {\n                \"id\": \"RENTAL_ASSET_ID\",\n                \"rental_asset_custom_availability\": [\n                    {\n                        \"preferred_day\": \"Wednesday\",\n                        \"available\": True,\n                        \"start_time\": \"08:00\",\n                        \"end_time\": \"12:00\",\n                    }\n                ],\n            }\n        ]\n    }\n)\nprint(response.data)\n"
    },
    "get_rental_asset_profiles": {
      "function": "get_rental_asset_profiles",
      "code": "response = client.rental_assets.get_rental_asset_profiles({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_rental_asset_profile": {
      "function": "create_rental_asset_profile",
      "code": "response = client.rental_assets.create_rental_asset_profile(\n    {\n        \"rental_asset_profile\": {\n            \"name\": \"Standard daily rate\",\n            \"display_name\": \"Standard daily rate\",\n            \"currency\": \"AUD\",\n            \"rental_asset_profile_sessions\": [\n                {\n                    \"name\": \"Spring season\",\n                    \"start_date\": \"2026-10-05\",\n                    \"end_date\": \"2026-12-30\",\n                    \"rental_asset_profile_session_prices\": [\n                        {\"price\": 1.0, \"price_type\": \"DAILY\", \"enabled_pro_rata\": False}\n                    ],\n                    \"rental_asset_profile_session_availability\": [\n                        {\n                            \"preferred_day\": \"Monday\",\n                            \"available\": True,\n                            \"start_time\": \"09:00\",\n                            \"end_time\": \"17:00\",\n                        }\n                    ],\n                }\n            ],\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_rental_assets": {
