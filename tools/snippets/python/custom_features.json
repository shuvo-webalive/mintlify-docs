{
  "sdk": "python",
  "module": "custom_features",
  "endpoints": {
    "get_custom_features": {
      "function": "get_custom_features",
      "code": "response = client.custom_features.get_custom_features({\"limit\": 20})\nprint(response.data)\n"
    },
    "get_custom_feature_by_id": {
      "function": "get_custom_feature_by_id",
      "code": "response = client.custom_features.get_custom_feature_by_id(\n    \"cmp_4b7d2e9a1c3f4e8a9b6d5c2e1f0a3b7d\"\n)\nprint(response.data)\n"
    },
    "create_custom_feature": {
      "function": "create_custom_feature",
      "code": "response = client.custom_features.create_custom_feature(\n    {\n        \"component\": {\n            \"name\": \"service_contract\",\n            \"display_name\": \"Service contract\",\n            \"use_in\": \"account\",\n            \"relation\": \"ONE_TO_MANY\",\n        }\n    }\n)\nprint(response.data)\n"
    },
    "delete_custom_feature_by_id": {
      "function": "delete_custom_feature_by_id",
      "code": "response = client.custom_features.delete_custom_feature_by_id(\n    \"cmp_4b7d2e9a1c3f4e8a9b6d5c2e1f0a3b7d\"\n)\nprint(response.data)\n"
    },
    "update_custom_feature_by_id": {
      "function": "update_custom_feature_by_id",
      "code": "response = client.custom_features.update_custom_feature_by_id(\n    \"cmp_4b7d2e9a1c3f4e8a9b6d5c2e1f0a3b7d\",\n    {\n        \"component\": {\n            \"display_name\": \"Service contract (updated)\",\n            \"description\": \"Support contracts held by Acme Pty Ltd\",\n        }\n    },\n)\nprint(response.data)\n"
    },
    "create_custom_feature_by_id": {
      "function": "create_custom_feature_by_id",
      "code": "response = client.custom_features.create_custom_feature_by_id(\n    \"cmp_4b7d2e9a1c3f4e8a9b6d5c2e1f0a3b7d\",\n    {\n        \"configuration\": {\n            \"settings\": {\"form_layout\": \"TWO_COLS\"},\n            \"column_1\": {\n                \"attributes\": [\n                    {\n                        \"type\": \"ATTRIBUTE\",\n                        \"name\": \"contract_tier\",\n                        \"required\": \"false\",\n                        \"show_in_list_view\": \"true\",\n                    }\n                ]\n            },\n            \"column_2\": {\"attributes\": [{\"type\": \"LABEL\", \"name\": \"Contract details\"}]},\n        }\n    },\n)\nprint(response.data)\n"
    }
  }
}
