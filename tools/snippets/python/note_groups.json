{
  "sdk": "python",
  "module": "note_groups",
  "endpoints": {
    "get_note_groups": {
      "function": "get_note_groups",
      "code": "response = client.note_groups.get_note_groups({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_note_group": {
      "function": "create_note_group",
      "code": "response = client.note_groups.create_note_group(\n    {\n        \"note_group\": {\n            \"name\": \"Project team\",\n            \"note_users\": [\n                {\"name\": \"Jane Citizen\", \"email_address\": \"jane@example.com\"}\n            ],\n        }\n    }\n)\nprint(response.data)\n"
    },
    "delete_note_group": {
      "function": "delete_note_group",
      "code": "response = client.note_groups.delete_note_group(\"2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9\")\nprint(response.data)\n"
    },
    "get_note_group": {
      "function": "get_note_group",
      "code": "response = client.note_groups.get_note_group(\"2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9\")\nprint(response.data)\n"
    },
    "update_note_group": {
      "function": "update_note_group",
      "code": "response = client.note_groups.update_note_group(\n    \"2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9\",\n    {\n        \"note_group\": {\n            \"display_name\": \"Project team (Sydney)\",\n            \"description\": \"Notes for the Sydney project team.\",\n        }\n    },\n)\nprint(response.data)\n"
    },
    "get_note_group_notes": {
      "function": "get_note_group_notes",
      "code": "response = client.note_groups.get_note_group_notes(\n    \"2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9\", {\"limit\": 20}\n)\nprint(response.data)\n"
    },
    "get_note_group_notes_by_user": {
      "function": "get_note_group_notes_by_user",
      "code": "response = client.note_groups.get_note_group_notes_by_user(\n    \"2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9\", \"jane@example.com\", {\"limit\": 20}\n)\nprint(response.data)\n"
    }
  }
