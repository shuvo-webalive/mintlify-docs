{
  "sdk": "python",
  "module": "shipping_rules",
  "endpoints": {
    "get_settings_shipping_rules": {
      "function": "get_settings_shipping_rules",
      "code": "response = client.shipping_rules.get_settings_shipping_rules({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_shipping_rule": {
      "function": "create_settings_shipping_rule",
      "code": "response = client.shipping_rules.create_settings_shipping_rule(\n    {\"shipping_rule\": {\"name\": \"Standard shipping\"}}\n)\nprint(response.data)\n"
    },
    "get_settings_shipping_rule": {
      "function": "get_settings_shipping_rule",
      "code": "response = client.shipping_rules.get_settings_shipping_rule(\n    \"sr_7f8091a2b3c4d5e6f708192a3b4c5d6e\"\n)\nprint(response.data)\n"
    },
    "delete_settings_shipping_rule": {
      "function": "delete_settings_shipping_rule",
      "code": "response = client.shipping_rules.delete_settings_shipping_rule(\n    \"sr_7f8091a2b3c4d5e6f708192a3b4c5d6e\"\n)\nprint(response.data)\n"
    },
    "update_settings_shipping_rule": {
      "function": "update_settings_shipping_rule",
      "code": "response = client.shipping_rules.update_settings_shipping_rule(\n    \"sr_7f8091a2b3c4d5e6f708192a3b4c5d6e\",\n    {\n        \"shipping_rule\": {\n            \"name\": \"Standard shipping\",\n            \"description\": \"Flat rate within Australia\",\n        }\n    },\n)\nprint(response.data)\n"
    },
    "create_settings_shipping_rule_configuration": {
      "function": "create_settings_shipping_rule_configuration",
      "code": "response = client.shipping_rules.create_settings_shipping_rule_configuration(\n    \"sr_7f8091a2b3c4d5e6f708192a3b4c5d6e\",\n    {\n        \"configuration\": {\n            \"zones\": [{\"zone\": \"0a1b2c3d-4e5f-6071-8293-a4b5c6d7e8f9\"}],\n            \"rate\": {\n                \"name\": \"Flat rate\",\n                \"method\": \"FLAT_RATE\",\n                \"handling_cost\": 1,\n                \"shipping_cost\": 5,\n            },\n        }\n    },\n)\nprint(response.data)\n"
    }
  }
}
