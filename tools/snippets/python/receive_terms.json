{
  "sdk": "python",
  "module": "receive_terms",
  "endpoints": {
    "get_settings_receive_terms": {
      "function": "get_settings_receive_terms",
      "code": "response = client.receive_terms.get_settings_receive_terms({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_receive_term": {
      "function": "create_settings_receive_term",
      "code": "response = client.receive_terms.create_settings_receive_term(\n    {\n        \"receive_term\": {\n            \"name\": \"net-30\",\n            \"display_name\": \"Net 30\",\n            \"period\": \"MONTHLY\",\n            \"duration\": 1,\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_settings_receive_term": {
      "function": "get_settings_receive_term",
      "code": "response = client.receive_terms.get_settings_receive_term(\"RT-0001\")\nprint(response.data)\n"
    },
    "delete_settings_receive_term": {
      "function": "delete_settings_receive_term",
      "code": "response = client.receive_terms.delete_settings_receive_term(\"RT-0001\")\nprint(response.data)\n"
    },
    "update_settings_receive_term": {
      "function": "update_settings_receive_term",
      "code": "response = client.receive_terms.update_settings_receive_term(\n    \"RT-0001\",\n    {\n        \"receive_term\": {\n            \"display_name\": \"Net 30 days\",\n            \"description\": \"Updated description.\",\n        }\n    },\n)\nprint(response.data)\n"
    }
  }
}
