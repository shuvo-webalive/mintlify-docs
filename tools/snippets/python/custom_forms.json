{
  "sdk": "python",
  "module": "custom_forms",
  "endpoints": {
    "get_settings_custom_forms": {
      "function": "get_settings_custom_forms",
      "code": "response = client.custom_forms.get_settings_custom_forms({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_custom_form": {
      "function": "create_settings_custom_form",
      "code": "response = client.custom_forms.create_settings_custom_form(\n    {\"custom_form\": {\"name\": \"acme-account-form\", \"setting_group\": \"ACCOUNT\"}}\n)\nprint(response.data)\n"
    },
    "get_settings_custom_form": {
      "function": "get_settings_custom_form",
      "code": "response = client.custom_forms.get_settings_custom_form(\n    \"cf_8d2a4c6e0b1f4d3a9c7e5b2d1f0a8c6e\"\n)\nprint(response.data)\n"
    },
    "delete_settings_custom_form": {
      "function": "delete_settings_custom_form",
      "code": "response = client.custom_forms.delete_settings_custom_form(\n    \"cf_8d2a4c6e0b1f4d3a9c7e5b2d1f0a8c6e\"\n)\nprint(response.data)\n"
    },
    "update_settings_custom_form": {
      "function": "update_settings_custom_form",
      "code": "response = client.custom_forms.update_settings_custom_form(\n    \"cf_8d2a4c6e0b1f4d3a9c7e5b2d1f0a8c6e\",\n    {\n        \"custom_form\": {\n            \"display_name\": \"Acme account form\",\n            \"description\": \"The form Acme Pty Ltd uses for new accounts\",\n        }\n    },\n)\nprint(response.data)\n"
    }
  }
}
