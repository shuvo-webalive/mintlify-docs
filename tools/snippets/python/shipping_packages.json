{
  "sdk": "python",
  "module": "shipping_packages",
  "endpoints": {
    "get_settings_shipping_packages": {
      "function": "get_settings_shipping_packages",
      "code": "response = client.shipping_packages.get_settings_shipping_packages({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_shipping_package": {
      "function": "create_settings_shipping_package",
      "code": "response = client.shipping_packages.create_settings_shipping_package(\n    {\"shipping_package\": {\"name\": \"Small box\", \"length\": 10, \"weight\": 1.5}}\n)\nprint(response.data)\n"
    },
    "get_settings_shipping_package": {
      "function": "get_settings_shipping_package",
      "code": "response = client.shipping_packages.get_settings_shipping_package(\n    \"sp_2b3c4d5e6f708192a3b4c5d6e7f8091a\"\n)\nprint(response.data)\n"
    },
    "delete_settings_shipping_package": {
      "function": "delete_settings_shipping_package",
      "code": "response = client.shipping_packages.delete_settings_shipping_package(\n    \"sp_2b3c4d5e6f708192a3b4c5d6e7f8091a\"\n)\nprint(response.data)\n"
    },
    "update_settings_shipping_package": {
      "function": "update_settings_shipping_package",
      "code": "response = client.shipping_packages.update_settings_shipping_package(\n    \"sp_2b3c4d5e6f708192a3b4c5d6e7f8091a\",\n    {\"shipping_package\": {\"display_name\": \"Small box\", \"description\": \"Up to 2 kg\"}},\n)\nprint(response.data)\n"
    }
  }
}
