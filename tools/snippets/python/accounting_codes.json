{
  "sdk": "python",
  "module": "accounting_codes",
  "endpoints": {
    "get_settings_accounting_codes": {
      "function": "get_settings_accounting_codes",
      "code": "response = client.accounting_codes.get_settings_accounting_codes({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_accounting_code": {
      "function": "create_settings_accounting_code",
      "code": "response = client.accounting_codes.create_settings_accounting_code(\n    {\n        \"accounting_code\": {\n            \"name\": \"Consulting revenue\",\n            \"account_code_type\": \"sales_revenue\",\n            \"gl_account_number\": \"940215\",\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_settings_accounting_code": {
      "function": "get_settings_accounting_code",
      "code": "response = client.accounting_codes.get_settings_accounting_code(\n    \"564372d513f207a3d8437811207203c1\"\n)\nprint(response.data)\n"
    },
    "delete_settings_accounting_code": {
      "function": "delete_settings_accounting_code",
      "code": "response = client.accounting_codes.delete_settings_accounting_code(\n    \"564372d513f207a3d8437811207203c1\"\n)\nprint(response.data)\n"
    },
    "update_settings_accounting_code": {
      "function": "update_settings_accounting_code",
      "code": "response = client.accounting_codes.update_settings_accounting_code(\n    \"564372d513f207a3d8437811207203c1\",\n    {\n        \"accounting_code\": {\n            \"display_name\": \"Consulting revenue (AU)\",\n            \"description\": \"Revenue from consulting work\",\n        }\n    },\n)\nprint(response.data)\n"
    }
  }
}
