      "function": "create_settings_document_template",
      "code": "response = client.document_templates.create_settings_document_template(\n    {\n        \"document_template\": {\n            \"name\": \"Invoice layout\",\n            \"document_template_type\": \"PDF_DOCUMENT\",\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_settings_document_template": {
      "function": "get_settings_document_template",
      "code": "response = client.document_templates.get_settings_document_template(\n    \"dt_a9df2cf857f5eadf952194e93c27c13e\"\n)\nprint(response.data)\n"
    },
    "delete_settings_document_template": {
      "function": "delete_settings_document_template",
      "code": "response = client.document_templates.delete_settings_document_template(\n    \"dt_a9df2cf857f5eadf952194e93c27c13e\"\n)\nprint(response.data)\n"
    },
    "update_settings_document_template": {
      "function": "update_settings_document_template",
