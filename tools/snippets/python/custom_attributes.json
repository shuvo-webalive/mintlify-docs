{
  "sdk": "python",
  "module": "custom_attributes",
  "endpoints": {
    "get_custom_attributes": {
      "function": "get_custom_attributes",
      "code": "response = client.custom_attributes.get_custom_attributes({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_custom_attribute": {
      "function": "create_custom_attribute",
      "code": "response = client.custom_attributes.create_custom_attribute(\n    {\n        \"custom_attribute\": {\n            \"name\": \"contract_tier\",\n            \"display_name\": \"Contract tier\",\n            \"type\": \"STRING\",\n        }\n    }\n)\nprint(response.data)\n"
    },
    "delete_custom_attribute": {
      "function": "delete_custom_attribute",
      "code": "response = client.custom_attributes.delete_custom_attribute(\n    \"f3a8c1d6e2b94a7c8d5e0f1a2b3c4d5e\"\n)\nprint(response.data)\n"
    },
    "get_custom_attribute": {
      "function": "get_custom_attribute",
      "code": "response = client.custom_attributes.get_custom_attribute(\n    \"f3a8c1d6e2b94a7c8d5e0f1a2b3c4d5e\"\n)\nprint(response.data)\n"
    },
    "update_custom_attribute": {
      "function": "update_custom_attribute",
      "code": "response = client.custom_attributes.update_custom_attribute(\n    \"f3a8c1d6e2b94a7c8d5e0f1a2b3c4d5e\",\n    {\n        \"custom_attribute\": {\n            \"display_name\": \"Contract tier (updated)\",\n            \"description\": \"The customer's support contract tier\",\n        }\n    },\n)\nprint(response.data)\n"
    }
  }
}
