{
  "sdk": "python",
  "module": "applications",
  "endpoints": {
    "get_settings_applications": {
      "function": "get_settings_applications",
      "code": "response = client.applications.get_settings_applications({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_application": {
      "function": "create_settings_application",
      "code": "response = client.applications.create_settings_application(\n    {\n        \"application\": {\n            \"name\": \"Acme Integration\",\n            \"redirect_url\": \"https://example.com/callback\",\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_settings_application": {
      "function": "get_settings_application",
      "code": "response = client.applications.get_settings_application(\"app_0123456789abcdef\")\nprint(response.data)\n"
    },
    "delete_settings_application": {
      "function": "delete_settings_application",
      "code": "response = client.applications.delete_settings_application(\"app_0123456789abcdef\")\nprint(response.data)\n"
    },
    "update_settings_application": {
      "function": "update_settings_application",
      "code": "response = client.applications.update_settings_application(\n    \"app_0123456789abcdef\",\n    {\n        \"application\": {\n            \"display_name\": \"Acme Integration\",\n            \"description\": \"Syncs orders with Acme\",\n        }\n    },\n)\nprint(response.data)\n"
    }
  }
}
