{
  "sdk": "python",
  "module": "fulfillment_profiles",
  "endpoints": {
    "get_settings_fulfillment_profiles": {
      "function": "get_settings_fulfillment_profiles",
      "code": "response = client.fulfillment_profiles.get_settings_fulfillment_profiles({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_fulfillment_profile": {
      "function": "create_settings_fulfillment_profile",
      "code": "response = client.fulfillment_profiles.create_settings_fulfillment_profile(\n    {\n        \"fulfillment_profile\": {\n            \"name\": \"Standard fulfillment\",\n            \"statuses\": [{\"name\": \"Open\", \"status_index\": 0}],\n        }\n    }\n)\nprint(response.data)\n"
    },
    "get_settings_fulfillment_profile": {
      "function": "get_settings_fulfillment_profile",
      "code": "response = client.fulfillment_profiles.get_settings_fulfillment_profile(\n    \"fp_5d6e7f8091a2b3c4d5e6f708192a3b4c\"\n)\nprint(response.data)\n"
    },
    "delete_settings_fulfillment_profile": {
      "function": "delete_settings_fulfillment_profile",
      "code": "response = client.fulfillment_profiles.delete_settings_fulfillment_profile(\n    \"fp_5d6e7f8091a2b3c4d5e6f708192a3b4c\"\n)\nprint(response.data)\n"
    },
    "update_settings_fulfillment_profile": {
      "function": "update_settings_fulfillment_profile",
      "code": "response = client.fulfillment_profiles.update_settings_fulfillment_profile(\n    \"fp_5d6e7f8091a2b3c4d5e6f708192a3b4c\",\n    {\n        \"fulfillment_profile\": {\n            \"display_name\": \"Standard fulfillment\",\n            \"description\": \"Open, packed and sent\",\n        }\n    },\n)\nprint(response.data)\n"
    }
  }
}
