{
  "sdk": "python",
  "module": "teams",
  "endpoints": {
    "get_settings_teams": {
      "function": "get_settings_teams",
      "code": "response = client.teams.get_settings_teams({\"limit\": 20})\nprint(response.data)\n"
    },
    "create_settings_team": {
      "function": "create_settings_team",
      "code": "response = client.teams.create_settings_team({\"team\": {\"name\": \"Field Services\"}})\nprint(response.data)\n"
    },
    "get_settings_team": {
      "function": "get_settings_team",
      "code": "response = client.teams.get_settings_team(\"team_00000000000000010000000000000006\")\nprint(response.data)\n"
    },
    "delete_settings_team": {
      "function": "delete_settings_team",
      "code": "response = client.teams.delete_settings_team(\"team_00000000000000010000000000000006\")\nprint(response.data)\n"
    },
    "update_settings_team": {
      "function": "update_settings_team",
      "code": "response = client.teams.update_settings_team(\n    \"team_00000000000000010000000000000006\",\n    {\n        \"team\": {\n            \"display_name\": \"Field Services North\",\n            \"description\": \"Northern region crew\",\n        }\n    },\n)\nprint(response.data)\n"
    }
  }
}
