    {
      "key": "create_purchase_credit_note",
      "method": "POST",
      "path": "/purchase_credit_notes",
      "slug": "create-a-purchase-credit-note",
      "title": "Create a purchase credit note",
      "summary": "Credits a purchase invoice and returns the new credit note under `purchase_credit_note`.",
      "description": "Creates a purchase credit note against a purchase invoice, wrapped in `purchase_credit_note` with the invoice's `purchase_invoice_id` and the `amount`. The credit is drawn from the invoice's payments. The response is shorter than a read, and its `status` is an object with `key` and `value`.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "purchase_credit_note": {
              "type": "object",
              "properties": {
                "purchase_invoice_id": {
                  "type": "string",
                  "description": "The `id` of the purchase invoice to credit."
                },
                "amount": {
                  "type": "string",
                  "description": "The amount to credit, as a decimal string."
                }
              }
            }
          },
          "required": [
            "purchase_credit_note"
          ]
        },
        "example": {
          "purchase_credit_note": {
            "purchase_invoice_id": "PI-0001",
            "amount": "1.00"
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new purchase credit note, under `purchase_credit_note`.",
          "schema": {
            "$ref": "#/components/schemas/PurchaseCreditNoteCreatedResponse"
          }
        }
      },
      "example_call": {
        "path": {},
        "body": {
          "purchase_credit_note": {
            "purchase_invoice_id": "PI-0001",
            "amount": "1.00"
          }
        }
      }
    },
    {
      "key": "delete_purchase_credit_note",
      "method": "DELETE",
      "path": "/purchase_credit_notes/{purchase_credit_note_id}",
      "slug": "delete-a-purchase-credit-note",
      "title": "Delete a purchase credit note",
      "summary": "Deletes a purchase credit note. Nothing comes back.",
      "description": "Deletes the purchase credit note, addressed by its `pcn_` id only. The call returns `204` with no body. It needs the permission to delete purchase credit notes.",
      "parameters": [
        {
          "name": "purchase_credit_note_id",
          "in": "path",
          "required": true,
          "description": "The purchase credit note's `pcn_` id. A code returns `400`.",
          "schema": {
            "type": "string",
            "example": "pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The purchase credit note is deleted."
        },
        "403": {
          "description": "The client lacks the permission to delete purchase credit notes."
        }
      },
      "example_call": {
        "path": {
          "purchase_credit_note_id": "pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b"
        }
      }
    },
    {
      "key": "apply_purchase_credit_note",
      "method": "POST",
      "path": "/purchase_credit_notes/{purchase_credit_note_id}/apply",
      "slug": "apply-a-purchase-credit-note-to-purchase-invoices",
      "title": "Apply a purchase credit note to purchase invoices",
      "summary": "Spends a purchase credit note on one or more purchase invoices and returns the credit note under `purchase_credit_note`.",
      "description": "Applies the credit to purchase invoices, listed under `purchase_credit_note.purchase_invoices`. Each entry takes `purchase_invoice_id` and `amount` and nothing else. Applying the credit records a purchase payment. Address the credit note by its `pcn_` id.",
      "parameters": [
        {
          "name": "purchase_credit_note_id",
          "in": "path",
          "required": true,
          "description": "The purchase credit note's `pcn_` id. A code returns `400`.",
          "schema": {
            "type": "string",
            "example": "pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "purchase_credit_note": {
              "type": "object",
              "properties": {
                "purchase_invoices": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "purchase_invoice_id": {
                        "type": "string"
                      },
                      "amount": {
                        "type": "string",
                        "description": "The amount to apply, as a decimal string."
                      }
                    }
                  },
                  "description": "The purchase invoices to apply the credit to."
                }
              },
              "required": [
                "purchase_invoices"
              ]
            }
          },
          "required": [
            "purchase_credit_note"
          ]
        },
        "example": {
          "purchase_credit_note": {
            "purchase_invoices": [
              {
                "purchase_invoice_id": "PI-0001",
                "amount": "1.00"
              }
            ]
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The purchase credit note, under `purchase_credit_note`.",
          "schema": {
            "$ref": "#/components/schemas/PurchaseCreditNoteCreatedResponse"
          }
        },
        "400": {
          "description": "The credit note is addressed by its code rather than its `pcn_` id."
        }
      },
      "example_call": {
        "path": {
          "purchase_credit_note_id": "pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b"
        },
        "body": {
          "purchase_credit_note": {
            "purchase_invoices": [
              {
                "purchase_invoice_id": "PI-0001",
                "amount": "1.00"
              }
            ]
          }
        }
      }
    },
    {
      "key": "create_purchase_credit_note_note",
      "method": "POST",
      "path": "/purchase_credit_notes/{purchase_credit_note_id}/notes",
      "slug": "create-a-purchase-credit-note-note",
      "title": "Create a purchase credit note note",
      "summary": "Attaches a note, with an optional file, to a purchase credit note.",
      "description": "Adds a note to the purchase credit note. Send a multipart form with the text as the `note` field and, optionally, a file to attach. Address the credit note by its `pcn_` id. It needs the permission to create purchase credit note notes.",
      "parameters": [
        {
          "name": "purchase_credit_note_id",
          "in": "path",
          "required": true,
          "description": "The purchase credit note's `pcn_` id. A code returns `400`.",
          "schema": {
            "type": "string",
            "example": "pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "required": [
            "note"
          ],
          "properties": {
            "note": {
              "type": "string",
              "description": "The note text. HTML is accepted."
            },
            "file": {
              "type": "string",
              "format": "binary",
              "description": "An optional file to attach to the note."
            }
          }
        },
        "example": {
          "note": "<p>Goods received in full.</p>",
          "file": "delivery-note.pdf"
        }
      },
      "multipart": true,
      "responses": {
        "201": {
          "description": "The note is created."
        },
        "400": {
          "description": "The credit note is addressed by its code rather than its `pcn_` id."
        },
        "403": {
          "description": "The client lacks the permission to create purchase credit note notes."
        }
      },
      "example_call": {
        "path": {
          "purchase_credit_note_id": "pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b"
        },
        "note": "<p>Goods received in full.</p>",
        "file": "delivery-note.pdf"
      }
    },
    {
      "key": "delete_purchase_credit_note_note",
      "method": "DELETE",
      "path": "/purchase_credit_notes/{purchase_credit_note_id}/notes/{note_id}",
      "slug": "delete-a-purchase-credit-note-note",
      "title": "Delete a purchase credit note note",
      "summary": "Deletes one note from a purchase credit note. Nothing comes back.",
      "description": "Deletes the note, addressed by the credit note's `pcn_` id and the note's `note_` id. The call returns `204` with no body.",
      "parameters": [
        {
          "name": "purchase_credit_note_id",
          "in": "path",
          "required": true,
          "description": "The purchase credit note's `pcn_` id. A code returns `400`.",
          "schema": {
            "type": "string",
            "example": "pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b"
          }
        },
        {
          "name": "note_id",
          "in": "path",
          "required": true,
          "description": "The note's `note_` id.",
          "schema": {
            "type": "string",
            "example": "note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The note is deleted."
        },
        "400": {
          "description": "The credit note is addressed by its code rather than its `pcn_` id."
        }
      },
      "example_call": {
        "path": {
          "purchase_credit_note_id": "pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b",
          "note_id": "note_8d1e2f3a4b5c4d6e8f9a0b1c2d3e4f5a"
        }
      }
    }
