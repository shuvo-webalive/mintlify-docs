{
  "family": "purchase_credit_notes",
  "tag": "Purchase credit notes",
  "slug": "purchase-credit-notes",
  "icon": "file-circle-minus",
  "base": "/purchase_credit_notes",
  "overview_description": "Create, read, update, apply and delete purchase credit notes, the credit a supplier owes you, and add or remove their notes.",
  "intro": "A purchase credit note is credit a supplier owes you, raised when a payment exceeds its invoices or created against a purchase invoice. These endpoints create, read, update, apply and delete purchase credit notes and add or remove their notes. There are 8 endpoints, and all seven SDKs call every one.",
  "warning": "**Applying a purchase credit note records a purchase payment, and deleting one cannot be undone.**",
  "notes": [
    "**Every write body is wrapped in `purchase_credit_note`.** The note create is a multipart form instead.",
    "**The create takes `purchase_invoice_id` and `amount`.** The credit is drawn from that invoice's payments.",
    "**The apply, note and delete calls take the `pcn_` id only.** A code returns `400` there, while the reads accept either.",
    "**The create and apply responses are shorter than a read.** Their `status` is an object with `key` and `value`, where a read sends a string.",
    "**The delete and the note create need extra permissions.** A client without them gets `403`.",
    "**Listings page by cursor.** Records are under `data`; pass `pagination.next_cursor` as `cursor` while `pagination.has_more` is `true`."
  ],
  "endpoints": [
    {
      "key": "get_purchase_credit_notes",
      "method": "GET",
      "path": "/purchase_credit_notes",
      "slug": "list-purchase-credit-notes",
      "title": "List purchase credit notes",
      "summary": "Returns one page of purchase credit notes.",
      "description": "Lists the purchase credit notes, one page at a time, under `data`. Each shows the payment that raised it and the amounts left to spend or refund. Other fields filter the list as `filter_<field>` or `filter_<field>_<operator>`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "The most records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` value from the previous page, to read the next one.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Prefix it with `-` for descending order, such as `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "One page of purchase credit notes.",
          "schema": {
            "$ref": "#/components/schemas/PurchaseCreditNoteList"
          }
        }
      },
      "example_call": {
        "path": {},
        "query": {
          "limit": 20
        }
      }
    },
