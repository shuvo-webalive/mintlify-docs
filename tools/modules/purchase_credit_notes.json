          "in": "path",
          "required": true,
          "description": "The purchase credit note's `id`, such as `pcn_...`. The reads also accept its code.",
          "schema": {
            "type": "string",
            "example": "pcn_5e4d3c2b1a0f4e9d8c7b6a5f4e3d2c1b"
