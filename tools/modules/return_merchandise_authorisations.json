      "warning": "**Deleting an RMA currently fails.** This call currently returns `500`, even for a draft RMA, and no endpoint creates an RMA as a draft.",
      "parameters": [
        {
          "name": "rma_id",
          "in": "path",
          "required": true,
          "description": "The RMA's `id`, which starts with `rma_`. Its `code` is refused.",
          "schema": {
            "type": "string",
            "example": "RMA_ID"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The RMA is deleted. There is no body."
        },
        "400": {
          "description": "The RMA is not a draft (`stock_committed`)."
        },
        "500": {
          "description": "Deleting an RMA currently fails, even for a draft RMA."
        }
      },
      "example_call": {
        "path": {
          "rma_id": "RMA_ID"
        }
      }
    },
