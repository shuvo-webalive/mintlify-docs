{
  "family": "return_merchandise_authorisations",
  "tag": "Return merchandise authorisations",
  "slug": "return-merchandise-authorisations",
  "icon": "rotate-left",
  "base": "/return_merchandise_authorisations",
  "overview_description": "Authorise customer returns against fulfilled invoices, approve or reject them, receive returned stock and keep notes.",
  "intro": "A return merchandise authorisation (RMA) records the goods a customer may return from a fulfilled invoice. These endpoints create, update, approve, reject and delete RMAs, receive the returned stock, and manage the RMA's notes. This area has 19 endpoints, each available in all seven SDKs.",
  "warning": "**Receiving returned stock commits it, and a received RMA cannot be deleted.** Updating or deleting an RMA currently returns `500`, even for a draft RMA, and a new RMA is created as `active`, not as a draft.",
  "notes": [
    "**Writes take the RMA's `id`; the reads under it take its `code`.** Update, delete, approve, reject, receive and the note writes need the `rma_` `id` and refuse a code. The note and receipt reads resolve the RMA by `code` and return `404` for an `rma_` `id`.",
    "**An RMA needs a fulfilled invoice.** The create body names the invoice by its internal id, `inv_` followed by the invoice's `uuid` without hyphens, and each return line by a fulfilled invoice line's `id`.",
    "**A new RMA has `status` `active` and `return_status` `pending`.** The create call returns a short record (`id`, `code`, `status`, `version`); read the RMA for the rest.",
    "**Approve and reject take no body and can notify approvers.** Both are refused with `422` when the RMA has no pending approval.",
    "**Notes are JSON, not forms, and carry no file.** Create an RMA note takes `{\"note\": {\"note\": \"...\"}}` and no attachment. No endpoint attaches a file to an RMA note, so the note file endpoints have not been confirmed to work.",
    "**Listings page by cursor.** Pass `limit` and the previous page's `pagination.next_cursor` as `cursor`, and stop when `has_more` is `false`."
  ],
  "endpoints": [
    {
      "key": "get_return_merchandise_authorisations",
      "method": "GET",
      "path": "/return_merchandise_authorisations",
      "slug": "list-rmas",
      "title": "List RMAs",
      "summary": "Lists return merchandise authorisations (RMAs), one page at a time.",
      "description": "Returns one page of RMAs under `data`. Each RMA carries its `code`, `status`, `return_status`, `item_count`, account and sale invoice. Other fields filter as `filter_<field>` for equality and `filter_<field>_<operator>` otherwise.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "How many records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` of the previous page, to read the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Prefix it with `-` for descending order, as in `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "A page of RMAs under `data`.",
          "schema": {
            "$ref": "#/components/schemas/ReturnMerchandiseAuthorisationList"
          }
        }
      },
      "example_call": {
        "path": {},
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "create_return_merchandise_authorisation",
      "method": "POST",
      "path": "/return_merchandise_authorisations",
      "slug": "create-an-rma",
      "title": "Create an RMA",
      "summary": "Creates an RMA against a fulfilled invoice.",
      "description": "Send `sale_invoice.id` and the `returns` lines under `return_merchandise_authorisation`. The invoice must have fulfilled stock, and each return names a fulfilled invoice line and a quantity. The new RMA has `status` `active` and `return_status` `pending`.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "required": [
            "return_merchandise_authorisation"
          ],
          "properties": {
            "return_merchandise_authorisation": {
              "type": "object",
              "properties": {
                "sale_invoice": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The invoice's internal id: `inv_` followed by the invoice's `uuid` with the hyphens removed."
                    }
                  }
                },
                "returns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sale_invoice_line": {
                        "type": "string",
                        "description": "The `id` of a fulfilled line of the invoice."
                      },
                      "rma_quantity": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "example": {
          "return_merchandise_authorisation": {
            "sale_invoice": {
              "id": "INVOICE_INTERNAL_ID"
            },
            "returns": [
              {
                "sale_invoice_line": "INVOICE_LINE_ID",
                "rma_quantity": 1
              }
            ]
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new RMA's `id`, `code`, `status` and `version`, under `return_merchandise_authorisation`.",
          "schema": {
            "$ref": "#/components/schemas/ReturnMerchandiseAuthorisationCreateResponse"
          }
        }
      },
      "example_call": {
        "path": {},
        "body": {
          "return_merchandise_authorisation": {
            "sale_invoice": {
              "id": "INVOICE_INTERNAL_ID"
            },
            "returns": [
              {
                "sale_invoice_line": "INVOICE_LINE_ID",
                "rma_quantity": 1
              }
            ]
          }
        }
      }
    },
