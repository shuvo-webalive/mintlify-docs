{
  "family": "shipping_rules",
  "tag": "Shipping rules",
  "slug": "shipping-rules",
  "icon": "truck-fast",
  "base": "/settings/shipping_rules",
  "overview_description": "List, read, create, update and delete shipping rules, and set the zones and rate each rule charges.",
  "intro": "A shipping rule sets how shipping is charged: the zones it applies to and the rate it charges there. These endpoints list, read, create, update and delete rules, and set a rule's configuration. This area has 6 endpoints, and all seven SDKs call every one.",
  "warning": null,
  "notes": [
    "**Writes are wrapped in `shipping_rule`, and one rule comes back under `shipping_rule`.** A create can send just a `name`.",
    "**A rule's zones and rate are set through the configuration endpoint.** That body sits under `configuration`, not `shipping_rule`.",
    "**The configuration names each zone by its dashed uuid.** Take the 32 hex digits after `zn_` in the zone's `id` and group them 8-4-4-4-12; the prefixed `id` itself is refused.",
    "**The listing pages by cursor.** Pass `limit`, then send the `next_cursor` from `pagination` as `cursor` until `has_more` is `false`."
  ],
  "endpoints": [
    {
      "key": "get_settings_shipping_rules",
      "method": "GET",
      "path": "/settings/shipping_rules",
      "slug": "list-shipping-rules",
      "title": "List shipping rules",
      "summary": "Returns a page of shipping rules.",
      "description": "Returns rules under `data`, each with its `name`, `description`, `status` and `configuration`. Set the page size with `limit` and fetch the next page with `cursor`. Other fields filter as `filter_<field>`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "How many records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` from the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Prefix it with `-` to sort descending, as in `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "A page of shipping rules, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/ShippingRuleList"
          }
        }
      },
      "example_call": {
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "create_settings_shipping_rule",
      "method": "POST",
      "path": "/settings/shipping_rules",
      "slug": "create-a-shipping-rule",
      "title": "Create a shipping rule",
      "summary": "Creates a shipping rule and returns it under `shipping_rule`.",
      "description": "Send the rule under `shipping_rule` with its `name`. Set its zones and rate afterwards with the configuration endpoint.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "shipping_rule": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "shipping_rule"
          ]
        },
        "example": {
          "shipping_rule": {
            "name": "Standard shipping"
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new shipping rule, under `shipping_rule`.",
          "schema": {
            "$ref": "#/components/schemas/ShippingRuleResponse"
          }
        }
      },
      "example_call": {
        "body": {
          "shipping_rule": {
            "name": "Standard shipping"
          }
        }
      }
    },
    {
      "key": "get_settings_shipping_rule",
      "method": "GET",
      "path": "/settings/shipping_rules/{shipping_rule_id}",
      "slug": "retrieve-a-shipping-rule",
      "title": "Retrieve a shipping rule",
      "summary": "Returns one shipping rule by its `id`, with its configuration.",
      "description": "Returns the rule under `shipping_rule`, with its `name`, `description`, `status`, `version` and `configuration`.",
      "parameters": [
        {
          "name": "shipping_rule_id",
          "in": "path",
          "required": true,
          "description": "The shipping rule's `id`, from the listing.",
          "schema": {
            "type": "string",
            "example": "sr_7f8091a2b3c4d5e6f708192a3b4c5d6e"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The shipping rule, under `shipping_rule`.",
          "schema": {
            "$ref": "#/components/schemas/ShippingRuleResponse"
          }
        },
        "404": {
          "description": "No shipping rule has that `id`."
        }
      },
      "example_call": {
        "path": {
          "shipping_rule_id": "sr_7f8091a2b3c4d5e6f708192a3b4c5d6e"
        }
      }
    },
    {
      "key": "delete_settings_shipping_rule",
      "method": "DELETE",
      "path": "/settings/shipping_rules/{shipping_rule_id}",
      "slug": "delete-a-shipping-rule",
      "title": "Delete a shipping rule",
      "summary": "Deletes a shipping rule. A successful call returns `204` with no body.",
      "description": "Deletes the rule with that `id`; a later read of it returns `404`.",
      "parameters": [
        {
          "name": "shipping_rule_id",
          "in": "path",
          "required": true,
          "description": "The shipping rule's `id`, from the listing.",
          "schema": {
            "type": "string",
            "example": "sr_7f8091a2b3c4d5e6f708192a3b4c5d6e"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The shipping rule is deleted. No body."
        }
      },
      "example_call": {
        "path": {
          "shipping_rule_id": "sr_7f8091a2b3c4d5e6f708192a3b4c5d6e"
        }
      }
    },
    {
      "key": "update_settings_shipping_rule",
      "method": "PATCH",
      "path": "/settings/shipping_rules/{shipping_rule_id}",
      "slug": "update-a-shipping-rule",
      "title": "Update a shipping rule",
      "summary": "Changes a shipping rule's name or description and returns the rule.",
      "description": "Send the changes under `shipping_rule`, such as a new `name` or `description`.",
      "parameters": [
        {
          "name": "shipping_rule_id",
          "in": "path",
          "required": true,
          "description": "The shipping rule's `id`, from the listing.",
          "schema": {
            "type": "string",
            "example": "sr_7f8091a2b3c4d5e6f708192a3b4c5d6e"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "shipping_rule": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "shipping_rule"
          ]
        },
        "example": {
          "shipping_rule": {
            "name": "Standard shipping",
            "description": "Flat rate within Australia"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The updated shipping rule, under `shipping_rule`.",
          "schema": {
            "$ref": "#/components/schemas/ShippingRuleResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "shipping_rule_id": "sr_7f8091a2b3c4d5e6f708192a3b4c5d6e"
        },
        "body": {
          "shipping_rule": {
            "name": "Standard shipping",
            "description": "Flat rate within Australia"
          }
        }
      }
    },
    {
      "key": "create_settings_shipping_rule_configuration",
      "method": "POST",
      "path": "/settings/shipping_rules/{shipping_rule_id}/configuration",
      "slug": "set-a-shipping-rules-configuration",
      "title": "Set a shipping rule's configuration",
      "summary": "Sets the zones, rate and tiers of a shipping rule and returns the rule.",
      "description": "Send the configuration under `configuration`: `zones` lists each zone by its dashed uuid in `zone`, and `rate` gives the rate's `name`, `method` such as `FLAT_RATE`, `handling_cost` and `shipping_cost`.",
      "parameters": [
        {
          "name": "shipping_rule_id",
          "in": "path",
          "required": true,
          "description": "The shipping rule's `id`, from the listing.",
          "schema": {
            "type": "string",
            "example": "sr_7f8091a2b3c4d5e6f708192a3b4c5d6e"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "configuration": {
              "type": "object",
              "properties": {
                "zones": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "zone": {
                        "type": "string",
                        "description": "The zone's dashed uuid, not its `zn_` id."
                      }
                    },
                    "required": [
                      "zone"
                    ]
                  }
                },
                "rate": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "method": {
                      "type": "string",
                      "description": "Such as `FLAT_RATE`."
                    },
                    "handling_cost": {
                      "type": "number"
                    },
                    "shipping_cost": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "required": [
            "configuration"
          ]
        },
        "example": {
          "configuration": {
            "zones": [
              {
                "zone": "0a1b2c3d-4e5f-6071-8293-a4b5c6d7e8f9"
              }
            ],
            "rate": {
              "name": "Flat rate",
              "method": "FLAT_RATE",
              "handling_cost": 1,
              "shipping_cost": 5
            }
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The shipping rule with its configuration, under `shipping_rule`.",
          "schema": {
            "$ref": "#/components/schemas/ShippingRuleResponse"
          }
        },
        "400": {
          "description": "A zone is given by its `zn_` id or as bare hex: `zone not found`."
        }
      },
      "example_call": {
        "path": {
          "shipping_rule_id": "sr_7f8091a2b3c4d5e6f708192a3b4c5d6e"
        },
        "body": {
          "configuration": {
            "zones": [
              {
                "zone": "0a1b2c3d-4e5f-6071-8293-a4b5c6d7e8f9"
              }
            ],
            "rate": {
              "name": "Flat rate",
              "method": "FLAT_RATE",
              "handling_cost": 1,
              "shipping_cost": 5
            }
          }
        }
      }
    }
  ],
  "schemas": {
    "ShippingRuleList": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ShippingRule"
          }
        },
        "object": {
          "type": "string"
        },
        "pagination": {
          "$ref": "#/components/schemas/ShippingRulePagination"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "ShippingRule": {
      "type": "object",
      "properties": {
        "configuration": {
          "$ref": "#/components/schemas/ShippingRuleConfiguration"
        },
        "created_by": {},
        "created_on": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "last_updated_by": {},
        "last_updated_on": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "shipping_class": {},
        "status": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      }
    },
    "ShippingRuleConfiguration": {
      "type": "object",
      "properties": {
        "rate": {
          "description": "The rate the rule charges."
        },
        "zones": {
          "type": "array",
          "description": "The zones the rule applies to."
        }
      }
    },
    "ShippingRulePagination": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "description": "The page size the API applied."
        },
        "has_more": {
          "type": "boolean",
          "description": "Whether another page follows. Trust it over `next_cursor`, which can be stale on the last page."
        },
        "next_cursor": {
          "type": "string",
          "description": "Pass as `cursor` to fetch the next page."
        },
        "prev_cursor": {
          "type": "string"
        },
        "links": {
          "type": "object",
          "properties": {
            "next": {
              "type": "string"
            },
            "prev": {
              "type": "string"
            }
          }
        }
      }
    },
    "ShippingRuleResponse": {
      "type": "object",
      "properties": {
        "shipping_rule": {
          "$ref": "#/components/schemas/ShippingRule"
        }
      }
    }
  }
}
