{
  "family": "salutations",
  "tag": "Salutations",
  "slug": "salutations",
  "icon": "user-tag",
  "base": "/settings/salutations",
  "overview_description": "List, create, read, update and delete the salutations, such as Dr or Ms, used on contacts.",
  "intro": "Salutations are the settings records for forms of address. You can list, create, read, update and delete them. This area has 5 endpoints, and all seven SDKs call every one.",
  "warning": null,
  "notes": [
    "**Requests and responses wrap the record in `salutation`.** A create sends `{\"salutation\": {...}}`.",
    "**A create needs only a `name`.** The new salutation's `display_name` takes the same value.",
    "**Listings page by cursor.** Records sit under `data`; pass `pagination.next_cursor` as `cursor` to read the next page, and stop when `pagination.has_more` is `false`.",
    "**A delete returns `204` with no body.** Reading the salutation afterwards returns `404`."
  ],
  "endpoints": [
    {
      "key": "get_settings_salutations",
      "method": "GET",
      "path": "/settings/salutations",
      "slug": "list-salutations",
      "title": "List salutations",
      "summary": "Returns a page of salutations under `data`, with paging details under `pagination`.",
      "description": "Lists the salutations on the instance. Pass `limit` to set the page size, and while `pagination.has_more` is true pass `pagination.next_cursor` back as `cursor` to read the next page. Other fields filter as `filter_<field>` or `filter_<field>_<operator>`, and `sort` orders the results.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "How many records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `pagination.next_cursor` of the previous page, to read the next one.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Prefix it with `-` for descending order, such as `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "A page of salutations, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/SalutationList"
          }
        }
      },
      "example_call": {
        "path": {},
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "create_settings_salutation",
      "method": "POST",
      "path": "/settings/salutations",
      "slug": "create-a-salutation",
      "title": "Create a salutation",
      "summary": "Creates a salutation and returns it under `salutation`.",
      "description": "Send the new salutation under `salutation`. A `name` is enough, and the new salutation's `display_name` takes the same value.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "salutation": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The salutation's name."
                }
              }
            }
          },
          "required": [
            "salutation"
          ]
        },
        "example": {
          "salutation": {
            "name": "Dr"
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new salutation, under `salutation`.",
          "schema": {
            "$ref": "#/components/schemas/SalutationResponse"
          }
        }
      },
      "example_call": {
        "path": {},
        "body": {
          "salutation": {
            "name": "Dr"
          }
        }
      }
    },
    {
      "key": "get_settings_salutation",
      "method": "GET",
      "path": "/settings/salutations/{salutation_id}",
      "slug": "retrieve-a-salutation",
      "title": "Retrieve a salutation",
      "summary": "Returns one salutation by its `id`, under `salutation`.",
      "description": "Reads the salutation with this `id`.",
      "parameters": [
        {
          "name": "salutation_id",
          "in": "path",
          "required": true,
          "description": "The salutation's `id`, as a listing or a create returns it.",
          "schema": {
            "type": "string",
            "example": "7a6efb02514153b5aa9a8f40c6f8bcc3"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The salutation, under `salutation`.",
          "schema": {
            "$ref": "#/components/schemas/SalutationResponse"
          }
        },
        "404": {
          "description": "No salutation has that `id`."
        }
      },
      "example_call": {
        "path": {
          "salutation_id": "7a6efb02514153b5aa9a8f40c6f8bcc3"
        }
      }
    },
    {
      "key": "delete_settings_salutation",
      "method": "DELETE",
      "path": "/settings/salutations/{salutation_id}",
      "slug": "delete-a-salutation",
      "title": "Delete a salutation",
      "summary": "Deletes a salutation. The response has no body.",
      "description": "Deletes the salutation with this `id`. Reading the same `id` afterwards returns `404`.",
      "parameters": [
        {
          "name": "salutation_id",
          "in": "path",
          "required": true,
          "description": "The salutation's `id`, as a listing or a create returns it.",
          "schema": {
            "type": "string",
            "example": "7a6efb02514153b5aa9a8f40c6f8bcc3"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The salutation is deleted. The response has no body."
        }
      },
      "example_call": {
        "path": {
          "salutation_id": "7a6efb02514153b5aa9a8f40c6f8bcc3"
        }
      }
    },
    {
      "key": "update_settings_salutation",
      "method": "PATCH",
      "path": "/settings/salutations/{salutation_id}",
      "slug": "update-a-salutation",
      "title": "Update a salutation",
      "summary": "Changes the fields you send on a salutation and returns it under `salutation`.",
      "description": "Send the fields to change under `salutation`.",
      "parameters": [
        {
          "name": "salutation_id",
          "in": "path",
          "required": true,
          "description": "The salutation's `id`, as a listing or a create returns it.",
          "schema": {
            "type": "string",
            "example": "7a6efb02514153b5aa9a8f40c6f8bcc3"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "salutation": {
              "type": "object",
              "properties": {
                "display_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "salutation"
          ]
        },
        "example": {
          "salutation": {
            "display_name": "Doctor",
            "description": "Medical or academic title"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The updated salutation, under `salutation`.",
          "schema": {
            "$ref": "#/components/schemas/SalutationResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "salutation_id": "7a6efb02514153b5aa9a8f40c6f8bcc3"
        },
        "body": {
          "salutation": {
            "display_name": "Doctor",
            "description": "Medical or academic title"
          }
        }
      }
    }
  ],
  "schemas": {
    "SalutationList": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Salutation"
          }
        },
        "object": {
          "type": "string"
        },
        "pagination": {
          "$ref": "#/components/schemas/SalutationPagination"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "Salutation": {
      "type": "object",
      "properties": {
        "created_by": {
          "description": "Can be null."
        },
        "created_on": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "last_updated_by": {
          "description": "Can be null."
        },
        "last_updated_on": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "SalutationPagination": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "description": "The page size applied to this page."
        },
        "has_more": {
          "type": "boolean",
          "description": "Whether another page follows. Trust this over `next_cursor`, which can still be set on the last page."
        },
        "next_cursor": {
          "type": "string",
          "description": "Pass this back as `cursor` to read the next page."
        },
        "prev_cursor": {
          "type": "string"
        },
        "links": {
          "$ref": "#/components/schemas/SalutationPaginationLinks"
        }
      }
    },
    "SalutationPaginationLinks": {
      "type": "object",
      "properties": {
        "next": {
          "type": "string"
        },
        "prev": {
          "type": "string"
        }
      }
    },
    "SalutationResponse": {
      "type": "object",
      "properties": {
