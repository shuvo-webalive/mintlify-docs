{
  "family": "express",
  "tag": "Express",
  "slug": "express",
  "icon": "bolt",
  "base": "/express",
  "overview_description": "Create an active order and its invoice for an existing account in a single Exsited API call.",
  "intro": "Express creates a complete order for an account in one request: the order, its lines and its invoice. This area has 1 endpoint, and all seven SDKs call it.",
  "warning": null,
  "notes": [
    "**The body sits under `account`.** Name the account by `id` and nest the order under `account.order`.",
    "**The order is created active.** The new order's `status` is `active`, and one invoice is raised for it straight away.",
    "**The response sits under `express`.** It holds the order as `get_order` reads it, including `lines`, `kpis` and `billing_preferences`.",
    "**Each line names an item by `item_id`.** `item_price_snapshot.pricing_rule.price` sets the line's price, and `tax_exempt_when_sold` removes tax from the line."
  ],
  "endpoints": [
    {
      "key": "create_express",
      "method": "POST",
      "path": "/express",
      "slug": "create-an-express-order",
      "title": "Create an express order",
      "summary": "Creates an active order for an existing account in one call and returns it under `express`.",
      "description": "Send the account's `id` and the order to create under `account.order`. The order is created as `active` and its invoice is raised in the same call. A line with `tax_exempt_when_sold` set to `true` adds no tax, so the order's `total` equals its `subtotal`.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "account": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The account's `id`, such as `W13ZGY`."
                },
                "order": {
                  "type": "object",
                  "properties": {
                    "price_tax_inclusive": {
                      "type": "boolean"
                    },
                    "properties": {
                      "type": "object",
                      "properties": {
                        "fulfillment_mode": {
                          "type": "string"
                        },
                        "fulfillment_term": {
                          "type": "string"
                        }
                      },
                      "description": "The order's billing and fulfillment settings."
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "item_id": {
                            "type": "string",
                            "description": "The item's `id`."
                          },
                          "item_order_quantity": {
                            "type": "integer"
                          },
                          "item_price_snapshot": {
                            "type": "object",
                            "properties": {
                              "pricing_rule": {
                                "type": "object",
                                "properties": {
                                  "price": {
                                    "type": "number"
                                  }
                                }
                              }
                            },
                            "description": "Overrides the item's price on this line."
                          },
                          "tax_exempt_when_sold": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  },
                  "description": "The order to create for the account."
                }
              },
              "required": [
                "id",
                "order"
              ]
            }
          },
          "required": [
            "account"
          ]
        },
        "example": {
          "account": {
            "id": "W13ZGY",
            "order": {
              "price_tax_inclusive": false,
              "properties": {
                "fulfillment_mode": "MANUAL",
                "fulfillment_term": "IMMEDIATELY"
              },
              "lines": [
                {
                  "item_id": "ITEM-0001",
                  "item_order_quantity": 2,
                  "item_price_snapshot": {
                    "pricing_rule": {
                      "price": 1.5
                    }
                  },
                  "tax_exempt_when_sold": true
                }
              ]
            }
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new order, under `express`.",
          "schema": {
            "$ref": "#/components/schemas/ExpressResponse"
          }
        }
      },
      "example_call": {
        "body": {
          "account": {
            "id": "W13ZGY",
            "order": {
              "price_tax_inclusive": false,
              "properties": {
                "fulfillment_mode": "MANUAL",
                "fulfillment_term": "IMMEDIATELY"
              },
              "lines": [
                {
                  "item_id": "ITEM-0001",
                  "item_order_quantity": 2,
                  "item_price_snapshot": {
                    "pricing_rule": {
                      "price": 1.5
                    }
                  },
                  "tax_exempt_when_sold": true
                }
              ]
            }
          }
        }
      }
    }
  ],
