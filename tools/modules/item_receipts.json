          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The receipt, under `item_receipt`.",
          "schema": {
            "$ref": "#/components/schemas/ItemReceiptResponse"
          }
        },
        "404": {
          "description": "No item receipt has that `id`."
        }
      },
      "example_call": {
        "path": {
          "item_receipt_id": "ir_4e5f60718293a4b5c6d7e8f90a1b2c3d"
        }
      }
    },
    {
      "key": "get_purchase_order_item_receipts",
      "method": "GET",
      "path": "/purchase_orders/{purchase_order_id}/item_receipts",
      "slug": "list-a-purchase-orders-item-receipts",
      "title": "List a purchase order's item receipts",
      "summary": "Returns the item receipts of one purchase order.",
      "description": "Returns the item receipts of one purchase order. The response is expected under `purchase_order`, with the receipts in `item_receipts` and a `pagination` block; this shape has not been confirmed.",
      "parameters": [
        {
          "name": "purchase_order_id",
          "in": "path",
          "required": true,
          "description": "The purchase order's `id`.",
          "schema": {
            "type": "string",
            "example": "PO-0001"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "How many records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The receipts, under `purchase_order.item_receipts`.",
          "schema": {
            "$ref": "#/components/schemas/ItemReceiptPurchaseOrderItemReceiptsResponse"
          }
        }
      },
      "example_call": {
        "path": {
