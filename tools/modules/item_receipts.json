      "description": "Returns the receipt under `item_receipt`, with its purchase order, status, dates, `tracking_number` and `lines`.",
      "parameters": [
        {
          "name": "item_receipt_id",
          "in": "path",
          "required": true,
          "description": "The receipt's `id`, which starts with `ir_`.",
