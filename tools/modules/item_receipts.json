{
  "family": "item_receipts",
  "tag": "Item receipts",
  "slug": "item-receipts",
  "icon": "dolly",
  "base": "/item_receipts",
  "overview_description": "Record items received against a purchase order's lines, then list, read, update and delete item receipts.",
  "intro": "An item receipt records items received against the lines of a purchase order. These endpoints create, list, read, update and delete receipts, list a purchase order's receipts, and delete a receipt's note. This area has 7 endpoints, each available in all seven SDKs.",
  "warning": "**A completed item receipt cannot be deleted.** The delete is refused with `400` `stock_committed`.",
  "notes": [
    "**Writes are wrapped in `item_receipt`.** A create names the `purchase_order`, a `receipt_status` such as `STARTED`, a `receipt_date`, and `lines`, each with a `purchase_order_line` id and a `receipt_quantity`. Reads return `receipt_status` in lower case, such as `started`.",
    "**Receipt ids start with `ir_`, and note ids with `note_`.** Pass them in the paths as they are.",
    "**The update changes a receipt's details.** It takes fields such as `tracking_number`, `receipt_note` and `receipt_date`, and raises the receipt's `version`.",
    "**No endpoint lists or creates a receipt's notes.** Only the note delete exists here.",
    "**The listing pages by cursor.** Pass `limit`, then send the `next_cursor` from `pagination` as `cursor` until `has_more` is `false`."
  ],
  "endpoints": [
    {
      "key": "get_item_receipts",
      "method": "GET",
      "path": "/item_receipts",
      "slug": "list-item-receipts",
      "title": "List item receipts",
      "summary": "Returns a page of item receipts.",
      "description": "Returns receipts under `data`, each with its purchase order, `receipt_status`, `receipt_date`, `tracking_number` and `lines`. Set the page size with `limit` and fetch the next page with `cursor`. Filter with `filter_<field>`, or `filter_<field>_<operator>` for other comparisons.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "How many records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` from the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Prefix it with `-` to sort descending, as in `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "A page of item receipts, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/ItemReceiptList"
          }
        }
      },
      "example_call": {
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "create_item_receipt",
      "method": "POST",
      "path": "/item_receipts",
      "slug": "create-an-item-receipt",
      "title": "Create an item receipt",
      "summary": "Records items received against a purchase order's lines and returns the receipt.",
      "description": "Send the receipt under `item_receipt`: the `purchase_order` id, a `receipt_status` such as `STARTED`, the `receipt_date`, and `lines` listing each purchase order line by its id with the `receipt_quantity` received.",
      "warning": "**Creating an item receipt currently fails.** This call currently returns `400` for a body like the example, so no receipt can be created through the API yet. Its success status is documented as both `200` and `201`.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "item_receipt": {
              "type": "object",
              "properties": {
                "purchase_order": {
                  "type": "string",
                  "description": "The purchase order's `id`."
                },
                "receipt_status": {
                  "type": "string",
                  "description": "Such as `STARTED`."
                },
                "receipt_date": {
                  "type": "string",
                  "description": "The date received, as `YYYY-MM-DD`."
                },
                "tracking_number": {
                  "type": "string"
                },
                "receipt_note": {
                  "type": "string"
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "purchase_order_line": {
                        "type": "string",
                        "description": "The purchase order line's `id`."
                      },
                      "receipt_quantity": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "purchase_order_line",
                      "receipt_quantity"
                    ]
                  }
                }
              },
              "required": [
                "purchase_order",
                "lines"
              ]
            }
          },
          "required": [
            "item_receipt"
          ]
        },
        "example": {
          "item_receipt": {
            "purchase_order": "PO-0001",
            "receipt_status": "STARTED",
            "receipt_date": "2026-10-01",
            "lines": [
              {
                "purchase_order_line": "d4c3b2a1-0f9e-4d8c-b7a6-958473625140",
                "receipt_quantity": 1
              }
            ]
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The new receipt, under `item_receipt`.",
          "schema": {
            "$ref": "#/components/schemas/ItemReceiptsResponse"
          }
        },
        "400": {
          "description": "Currently returned for a body like the example."
        }
      },
      "example_call": {
        "body": {
          "item_receipt": {
            "purchase_order": "PO-0001",
            "receipt_status": "STARTED",
            "receipt_date": "2026-10-01",
            "lines": [
              {
                "purchase_order_line": "d4c3b2a1-0f9e-4d8c-b7a6-958473625140",
                "receipt_quantity": 1
              }
            ]
          }
        }
      }
    },
    {
      "key": "update_item_receipt",
      "method": "PATCH",
      "path": "/item_receipts/{item_receipt_id}",
      "slug": "update-an-item-receipt",
      "title": "Update an item receipt",
      "summary": "Changes an item receipt's details and returns the receipt.",
      "description": "Send the changes under `item_receipt`, such as a new `tracking_number`, `receipt_note` or `receipt_date`. The receipt comes back under `item_receipt` with a higher `version`.",
      "parameters": [
        {
          "name": "item_receipt_id",
          "in": "path",
          "required": true,
          "description": "The receipt's `id`, which starts with `ir_`.",
          "schema": {
            "type": "string",
            "example": "ir_4e5f60718293a4b5c6d7e8f90a1b2c3d"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "item_receipt": {
              "type": "object",
              "properties": {
                "tracking_number": {
                  "type": "string"
                },
                "receipt_note": {
                  "type": "string"
                },
                "receipt_date": {
                  "type": "string",
                  "description": "As `YYYY-MM-DD`."
                }
              }
            }
          },
          "required": [
            "item_receipt"
          ]
        },
        "example": {
          "item_receipt": {
            "tracking_number": "TRK-0001"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The updated receipt, under `item_receipt`.",
          "schema": {
            "$ref": "#/components/schemas/ItemReceiptResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "item_receipt_id": "ir_4e5f60718293a4b5c6d7e8f90a1b2c3d"
        },
        "body": {
          "item_receipt": {
            "tracking_number": "TRK-0001"
          }
        }
      }
    },
    {
      "key": "get_item_receipt",
      "method": "GET",
      "path": "/item_receipts/{item_receipt_id}",
      "slug": "retrieve-an-item-receipt",
      "title": "Retrieve an item receipt",
