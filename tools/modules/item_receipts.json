          "limit": 20
        }
      }
    },
    {
      "key": "delete_item_receipt",
      "method": "DELETE",
      "path": "/item_receipts/{item_receipt_id}",
      "slug": "delete-an-item-receipt",
      "title": "Delete an item receipt",
      "summary": "Deletes an item receipt. A successful call returns `204` with no body.",
      "description": "Deletes the receipt with that `ir_` id; a later read of it returns `404`. A completed receipt cannot be deleted.",
      "warning": "**This call has not been confirmed to work.** Creating an item receipt currently fails; see [Create an item receipt](/api-reference/item-receipts/create-an-item-receipt).",
      "parameters": [
        {
          "name": "item_receipt_id",
          "in": "path",
          "required": true,
          "description": "The receipt's `id`, which starts with `ir_`.",
          "schema": {
            "type": "string",
            "example": "ir_4e5f60718293a4b5c6d7e8f90a1b2c3d"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The receipt is deleted. No body."
        },
        "400": {
          "description": "The receipt is completed (`stock_committed`)."
        }
      },
      "example_call": {
        "path": {
          "item_receipt_id": "ir_4e5f60718293a4b5c6d7e8f90a1b2c3d"
        }
      }
    },
    {
      "key": "delete_item_receipt_note",
      "method": "DELETE",
      "path": "/item_receipts/{item_receipt_id}/notes/{note_id}",
      "slug": "delete-an-item-receipt-note",
      "title": "Delete an item receipt note",
      "summary": "Deletes a note from an item receipt. A successful call returns `204` with no body.",
      "description": "Pass the receipt's `ir_` id and the note's `note_` id. No endpoint lists or creates a receipt's notes.",
      "parameters": [
        {
          "name": "item_receipt_id",
          "in": "path",
          "required": true,
          "description": "The receipt's `id`, which starts with `ir_`.",
          "schema": {
            "type": "string",
            "example": "ir_4e5f60718293a4b5c6d7e8f90a1b2c3d"
          }
        },
        {
          "name": "note_id",
          "in": "path",
          "required": true,
          "description": "The note's `id`, which starts with `note_`.",
          "schema": {
            "type": "string",
            "example": "note_c2d3e4f5061728394a5b6c7d8e9f0011"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The note is deleted. No body."
        }
      },
      "example_call": {
        "path": {
          "item_receipt_id": "ir_4e5f60718293a4b5c6d7e8f90a1b2c3d",
          "note_id": "note_c2d3e4f5061728394a5b6c7d8e9f0011"
        }
      }
    }
