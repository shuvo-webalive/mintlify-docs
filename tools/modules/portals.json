{
  "family": "portals",
  "tag": "Portal",
  "slug": "portal",
  "icon": "door-open",
  "base": "/portal",
  "overview_description": "Log portal users in, change, set and reset their passwords, and activate or validate portal accounts.",
  "intro": "The portal endpoints act for the people who sign in to your customer portal. You can log a portal user in, change or set their password, request a reset link, reset a password with a code, and activate or validate an account with a code. This area has 7 endpoints, and all seven SDKs call every one.",
  "warning": "**Setting a portal password by email does not ask for the current password, and the old password cannot be put back.**",
  "notes": [
    "**Every request body sits under a `portal` key.** A login, for example, sends `{\"portal\": {\"email\": \"jane@example.com\", \"password\": \"current-password\"}}`.",
    "**A portal user is an account with portal access.** Create the account with `grant_portal_access` set to `true` and a `grant_portal_password`, then log in with its `email_address` and that password.",
    "**A wrong password returns `400`.** After a password change, a login with the old password is refused.",
    "**A reset link request for an unknown email returns `202`.** The call does not fail when no portal user has that email.",
    "**Setting a password by email returns `202`.** `POST /portal/change` sends `email` and `password` under `portal`."
  ],
  "endpoints": [
    {
      "key": "activate_portal",
      "method": "POST",
      "path": "/portal/activate",
      "slug": "activate-a-portal-account",
      "title": "Activate a portal account",
      "summary": "Activates a portal account with an activation code.",
      "description": "Send the activation `code` under `portal`. The response for a valid code is not documented yet.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "portal": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "description": "The code to check."
                }
              }
            }
          },
          "required": [
            "portal"
          ]
        },
        "example": {
          "portal": {
            "code": "abc123def456"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The code is accepted."
        }
      },
      "example_call": {
        "body": {
          "portal": {
            "code": "abc123def456"
          }
        }
      },
      "warning": "**This call has not been confirmed with a valid code.**"
    },
    {
      "key": "create_portal_change_password",
      "method": "POST",
      "path": "/portal/change_password",
      "slug": "change-a-portal-password",
      "title": "Change a portal password",
      "summary": "Changes a portal user's password when you send the current one, and returns a message.",
      "description": "Send the portal user's `email`, their `current_password` and the `new_password` under `portal`. After the change, a login with the old password returns `400`. The response holds a `message` under `portal`.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "portal": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "description": "The portal user's email address."
                },
                "current_password": {
                  "type": "string",
                  "description": "The portal user's current password."
                },
                "new_password": {
                  "type": "string",
                  "description": "The new password."
                }
              }
            }
          },
          "required": [
            "portal"
          ]
        },
        "example": {
          "portal": {
            "email": "jane@example.com",
            "current_password": "current-password",
            "new_password": "new-password"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The password is changed; a `message` under `portal`.",
          "schema": {
            "$ref": "#/components/schemas/PortalChangePasswordResponse"
          }
        }
      },
      "example_call": {
        "body": {
          "portal": {
            "email": "jane@example.com",
            "current_password": "current-password",
            "new_password": "new-password"
          }
        }
      }
    },
    {
      "key": "create_portal_login",
      "method": "POST",
      "path": "/portal/login",
      "slug": "log-in-a-portal-user",
      "title": "Log in a portal user",
      "summary": "Checks a portal user's email and password and returns the user with the portals they can open.",
      "description": "Send the portal user's `email` and `password` under `portal`. The response holds the `user` under `portal`, with their name, email address and a `portals` list naming each account they can open. A password that is not the user's current one returns `400`.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "portal": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "description": "The portal user's email address."
                },
                "password": {
                  "type": "string",
                  "description": "The portal user's password."
                }
              }
            }
          },
          "required": [
            "portal"
          ]
        },
        "example": {
          "portal": {
            "email": "jane@example.com",
            "password": "current-password"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The portal user, under `portal.user`.",
          "schema": {
            "$ref": "#/components/schemas/PortalLoginResponse"
          }
        },
        "400": {
          "description": "The password is not the portal user's current password."
        }
      },
      "example_call": {
        "body": {
          "portal": {
            "email": "jane@example.com",
            "password": "current-password"
          }
        }
      }
    },
