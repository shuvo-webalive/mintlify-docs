{
  "family": "note_groups",
  "tag": "Note groups",
  "slug": "note-groups",
  "icon": "note-sticky",
  "base": "/note_groups",
  "overview_description": "Create, read, update and delete note groups, and list the notes each group holds.",
  "intro": "Note groups gather notes and the users who share them. You can list, create, read, update and delete groups, and list a group's notes overall or as one user sees them. This area has 7 endpoints, and all seven Exsited SDKs call every one.",
  "warning": null,
  "notes": [
    "**Writes are wrapped in `note_group`.** One group comes back under the same key.",
    "**Users can be added at create time.** Send `note_users` with a `name` and an `email_address` for each.",
    "**`version` counts changes.** After one update a new group reads `version` 2.",
    "**A user's view of the notes takes a uuid or an email address.** A user the group does not hold returns `404`.",
    "**Listings page by cursor.** Records sit under `data`; pass `pagination.next_cursor` as `cursor` to read the next page, and stop when `pagination.has_more` is `false`."
  ],
  "endpoints": [
    {
      "key": "get_note_groups",
      "method": "GET",
      "path": "/note_groups",
      "slug": "list-note-groups",
      "title": "List note groups",
      "summary": "Lists the note groups on your instance, one page at a time.",
      "description": "Returns a page of note groups under `data`, with cursor `pagination`. Other fields filter as `filter_<field>` for equality or `filter_<field>_<operator>`, such as `filter_created_on_gte`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "The most records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `pagination.next_cursor` of the previous page, to read the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "A field to sort by. Prefix it with `-` for descending order, such as `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "A page of note groups.",
          "schema": {
            "$ref": "#/components/schemas/NoteGroupList"
          }
        }
      },
      "example_call": {
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "create_note_group",
      "method": "POST",
      "path": "/note_groups",
      "slug": "create-a-note-group",
      "title": "Create a note group",
      "summary": "Creates a note group and returns it.",
      "description": "Send the group wrapped in `note_group`, with a `name` and, optionally, `note_users` to add. The new group comes back under `note_group`, with its `activity_logs`.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "note_group": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The group's name."
                },
                "note_users": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "email_address": {
                        "type": "string"
                      }
                    }
                  },
                  "description": "Users to add to the group."
                }
              }
            }
          },
          "required": [
            "note_group"
          ]
        },
        "example": {
          "note_group": {
            "name": "Project team",
            "note_users": [
              {
                "name": "Jane Citizen",
                "email_address": "jane@example.com"
              }
            ]
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new note group, under `note_group`.",
          "schema": {
            "$ref": "#/components/schemas/NoteGroupResponse"
          }
        }
      },
      "example_call": {
        "body": {
          "note_group": {
            "name": "Project team",
            "note_users": [
              {
                "name": "Jane Citizen",
                "email_address": "jane@example.com"
              }
            ]
          }
        }
      }
    },
    {
      "key": "delete_note_group",
      "method": "DELETE",
      "path": "/note_groups/{note_group_id}",
      "slug": "delete-a-note-group",
      "title": "Delete a note group",
      "summary": "Deletes a note group. Nothing comes back.",
      "description": "Returns `204` with no body. A read of the group afterwards returns `404`.",
      "parameters": [
        {
          "name": "note_group_id",
          "in": "path",
          "required": true,
          "description": "The note group's `id`.",
          "schema": {
            "type": "string",
            "example": "2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The note group is deleted."
        }
      },
      "example_call": {
        "path": {
          "note_group_id": "2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9"
        }
      }
    },
    {
      "key": "get_note_group",
      "method": "GET",
      "path": "/note_groups/{note_group_id}",
      "slug": "retrieve-a-note-group",
      "title": "Retrieve a note group",
      "summary": "Retrieves one note group by its id.",
      "description": "Returns the note group under `note_group`. A deleted group returns `404`.",
      "parameters": [
        {
          "name": "note_group_id",
          "in": "path",
          "required": true,
          "description": "The note group's `id`.",
          "schema": {
            "type": "string",
            "example": "2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The note group, under `note_group`.",
          "schema": {
            "$ref": "#/components/schemas/NoteGroupResponse"
          }
        },
        "404": {
          "description": "No note group has that id, or the group is deleted."
        }
      },
      "example_call": {
        "path": {
          "note_group_id": "2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9"
        }
      }
    },
    {
      "key": "update_note_group",
      "method": "PATCH",
      "path": "/note_groups/{note_group_id}",
      "slug": "update-a-note-group",
      "title": "Update a note group",
      "summary": "Changes a note group and returns it.",
      "description": "Send the fields to change wrapped in `note_group`. The updated group comes back under `note_group`, and its `version` goes up.",
      "parameters": [
        {
          "name": "note_group_id",
          "in": "path",
          "required": true,
          "description": "The note group's `id`.",
          "schema": {
            "type": "string",
            "example": "2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "note_group": {
              "type": "object",
              "properties": {
                "display_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "description": "The fields to change."
            }
          },
          "required": [
            "note_group"
          ]
        },
        "example": {
          "note_group": {
            "display_name": "Project team (Sydney)",
            "description": "Notes for the Sydney project team."
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The updated note group, under `note_group`.",
          "schema": {
            "$ref": "#/components/schemas/NoteGroupResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "note_group_id": "2d4f6a8c-0e1b-4d3f-a5c7-e9b1d3f5a7c9"
        },
        "body": {
          "note_group": {
            "display_name": "Project team (Sydney)",
            "description": "Notes for the Sydney project team."
          }
        }
      }
    },
