{
  "family": "external_databases",
  "tag": "External databases",
  "slug": "external-databases",
  "icon": "database",
  "base": "/external_databases",
  "overview_description": "Create external databases with tables and records, then list, read, search, insert and update their records.",
  "intro": "External databases hold tables and records that you define through the API. You can create a database with its tables and first records, list and read databases and table columns, insert and update records, and search a table. This area has 7 endpoints, and all seven SDKs call every one.",
  "warning": "**An external database cannot be deleted through the API.** Every database you create stays; to put its tables back to a known state, create it again with `replace` set to `true`.",
  "notes": [
    "**Creating a database sends it under `external_database`.** The body has a `name` and a `tables` array; each table has `table_name`, `fields` and `records`.",
    "**Record writes and searches take the table at the top level.** Insert, update and search send `table_name` directly in the body with no wrapper key, and their responses come back under `external_database`.",
    "**Each record is a list of field and value pairs.** A record looks like `{\"record\": [{\"field\": \"company\", \"value\": \"Acme Pty Ltd\"}]}`.",
    "**Search results are grouped by table.** `list` holds one array per table name, each row maps column names to values, and `count` gives the number of rows.",
    "**Listings page with `has_next`, `has_prev` and `per_page`.** This differs from the cursor shape most other listings use; the entries are under `data`.",
    "**An unknown database name returns `404`.**"
  ],
  "endpoints": [
    {
      "key": "get_external_databases",
      "method": "GET",
      "path": "/external_databases",
      "slug": "list-external-databases",
      "title": "List external databases",
      "summary": "Returns the external databases on your instance, each with its `name`.",
      "description": "Records are under `data`, and each names a database by `name`. The `pagination` block uses `has_next`, `has_prev` and `per_page`.",
      "parameters": [],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The external databases, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/ExternalDatabaseList"
          }
        }
      },
      "example_call": {}
    },
    {
      "key": "create_external_database",
      "method": "POST",
      "path": "/external_databases",
      "slug": "create-an-external-database",
      "title": "Create an external database",
      "summary": "Creates a database with its tables and first records, and returns its name and a message.",
      "description": "Send the database under `external_database`: a `name` and a `tables` array, where each table has a `table_name`, its `fields` (column names) and its first `records`. Set `replace` to `true` to recreate a database that already exists with the tables in the body. The response holds the `name`, a `message` and `activity_logs` under `external_database`.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "external_database": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The database name."
                },
                "tables": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "table_name": {
                        "type": "string"
                      },
                      "fields": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "The column names."
                      },
                      "records": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "record": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "field": {
                                    "type": "string"
                                  },
                                  "value": {
                                    "type": "string"
                                  }
                                }
                              },
                              "description": "One `field` and `value` pair per column."
                            }
                          }
                        },
                        "description": "The first rows of the table."
                      }
                    }
                  }
                },
                "replace": {
                  "type": "boolean",
                  "description": "`true` recreates an existing database with the tables in this body."
                }
              }
            }
          },
          "required": [
            "external_database"
          ]
        },
        "example": {
          "external_database": {
            "name": "acmedb",
            "tables": [
              {
                "table_name": "contacts",
                "fields": [
                  "company"
                ],
                "records": [
                  {
                    "record": [
                      {
                        "field": "company",
                        "value": "Acme Pty Ltd"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The database is created; its `name` and a `message`, under `external_database`.",
          "schema": {
            "$ref": "#/components/schemas/ExternalDatabaseCreateResponse"
          }
        }
      },
      "example_call": {
        "body": {
          "external_database": {
            "name": "acmedb",
            "tables": [
              {
                "table_name": "contacts",
                "fields": [
                  "company"
                ],
                "records": [
                  {
                    "record": [
                      {
                        "field": "company",
                        "value": "Acme Pty Ltd"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "key": "get_external_database",
      "method": "GET",
      "path": "/external_databases/{db_name}",
      "slug": "retrieve-an-external-database",
      "title": "Retrieve an external database",
      "summary": "Returns one external database by name, as a list under `data`.",
      "description": "Pass the database `name` as `db_name`. The response has the same shape as the listing, with the database's entries under `data`. An unknown name returns `404`.",
      "parameters": [
        {
          "name": "db_name",
          "in": "path",
          "required": true,
          "description": "The database's `name`, as given when it is created, such as `acmedb`.",
          "schema": {
            "type": "string",
            "example": "acmedb"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The database, as a list under `data`.",
          "schema": {
            "$ref": "#/components/schemas/ExternalDatabaseList"
          }
        },
        "404": {
          "description": "No external database has that name."
        }
      },
      "example_call": {
        "path": {
          "db_name": "acmedb"
        }
      }
    },
    {
      "key": "create_external_database_insert_record",
      "method": "POST",
      "path": "/external_databases/{db_name}/insert_records",
      "slug": "insert-records-into-an-external-database-table",
      "title": "Insert records into an external database table",
      "summary": "Adds rows to one table of a database and returns the inserted data.",
      "description": "Send the `table_name` and a `records` array at the top level of the body, with no wrapper key. Each record is a list of `field` and `value` pairs. The response holds `success`, a `message` and `inserted_data` under `external_database`.",
      "parameters": [
        {
          "name": "db_name",
          "in": "path",
          "required": true,
          "description": "The database's `name`, as given when it is created, such as `acmedb`.",
          "schema": {
            "type": "string",
            "example": "acmedb"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "table_name": {
              "type": "string"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "record": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    },
                    "description": "One `field` and `value` pair per column."
                  }
                }
              },
              "description": "The rows to add."
            }
          }
        },
        "example": {
          "table_name": "contacts",
          "records": [
            {
              "record": [
                {
                  "field": "company",
                  "value": "Example Holdings"
                }
              ]
            }
          ]
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The rows are added; the result under `external_database`.",
          "schema": {
            "$ref": "#/components/schemas/ExternalDatabaseInsertResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "db_name": "acmedb"
        },
        "body": {
          "table_name": "contacts",
          "records": [
            {
              "record": [
                {
                  "field": "company",
                  "value": "Example Holdings"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "key": "create_external_database_search",
      "method": "POST",
      "path": "/external_databases/{db_name}/search",
      "slug": "search-an-external-database-table",
      "title": "Search an external database table",
      "summary": "Returns the rows of one table of a database, with a count.",
      "description": "Send the `table_name` at the top level of the body. The response, under `external_database`, holds `count`, `limit`, `offset` and a `list` object keyed by table name, where each row maps column names to values.",
      "parameters": [
        {
          "name": "db_name",
          "in": "path",
          "required": true,
          "description": "The database's `name`, as given when it is created, such as `acmedb`.",
          "schema": {
            "type": "string",
            "example": "acmedb"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "table_name": {
              "type": "string"
            }
          }
        },
        "example": {
          "table_name": "contacts"
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The matching rows, under `external_database.list`.",
          "schema": {
            "$ref": "#/components/schemas/ExternalDatabaseSearchResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "db_name": "acmedb"
        },
        "body": {
          "table_name": "contacts"
        }
      }
    },
    {
      "key": "update_external_database_update_records",
      "method": "PATCH",
      "path": "/external_databases/{db_name}/update_records",
      "slug": "update-records-in-an-external-database-table",
      "title": "Update records in an external database table",
      "summary": "Changes column values in the rows of a table that match a condition, and returns a message.",
      "description": "Send the `table_name`, an `update_fields` array of `field_name` and `field_value` pairs, and a `where_condition` with a `field_name`, an `operator` such as `=` and a `field_value`, all at the top level of the body. The response holds a `message` under `external_database`.",
      "parameters": [
        {
          "name": "db_name",
          "in": "path",
          "required": true,
          "description": "The database's `name`, as given when it is created, such as `acmedb`.",
          "schema": {
            "type": "string",
            "example": "acmedb"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "table_name": {
              "type": "string"
            },
            "update_fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field_name": {
                    "type": "string"
                  },
                  "field_value": {
                    "type": "string"
                  }
                }
              },
              "description": "The new value for each column to change."
            },
            "where_condition": {
              "type": "object",
              "properties": {
                "field_name": {
                  "type": "string"
                },
                "operator": {
                  "type": "string",
                  "example": "="
                },
                "field_value": {
                  "type": "string"
                }
              },
              "description": "Which rows to change."
            }
          }
        },
        "example": {
          "table_name": "contacts",
          "update_fields": [
            {
              "field_name": "company",
              "field_value": "Acme Group"
            }
          ],
          "where_condition": {
            "field_name": "company",
            "operator": "=",
            "field_value": "Acme Pty Ltd"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The rows are changed; a `message` under `external_database`.",
          "schema": {
            "$ref": "#/components/schemas/ExternalDatabaseUpdateResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "db_name": "acmedb"
        },
        "body": {
          "table_name": "contacts",
          "update_fields": [
            {
              "field_name": "company",
              "field_value": "Acme Group"
            }
          ],
          "where_condition": {
            "field_name": "company",
            "operator": "=",
            "field_value": "Acme Pty Ltd"
          }
        }
      }
    },
    {
      "key": "get_external_database_table",
      "method": "GET",
      "path": "/external_databases/{db_name}/tables/{table_name}",
      "slug": "retrieve-the-columns-of-an-external-database-table",
      "title": "Retrieve the columns of an external database table",
      "summary": "Returns the columns of one table of a database, as a list under `data`.",
      "description": "Pass the database `name` as `db_name` and the table's `table_name`. The response has the same shape as the database listing, with the table's columns under `data`.",
      "parameters": [
        {
          "name": "db_name",
          "in": "path",
          "required": true,
          "description": "The database's `name`, as given when it is created, such as `acmedb`.",
          "schema": {
            "type": "string",
            "example": "acmedb"
          }
        },
        {
          "name": "table_name",
          "in": "path",
          "required": true,
          "description": "The table's `table_name`, such as `contacts`.",
          "schema": {
            "type": "string",
            "example": "contacts"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The table's columns, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/ExternalDatabaseList"
          }
        }
      },
      "example_call": {
        "path": {
          "db_name": "acmedb",
          "table_name": "contacts"
        }
      }
    }
  ],
  "schemas": {
    "ExternalDatabaseList": {
      "type": "object",
      "properties": {
        "object": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "The entries on this page. In the database listing, each has a `name`."
        },
        "pagination": {
          "$ref": "#/components/schemas/ExternalDatabasePagination"
        }
      }
    },
    "ExternalDatabasePagination": {
      "type": "object",
      "properties": {
        "has_next": {
          "type": "boolean"
        },
        "has_prev": {
          "type": "boolean"
        },
        "per_page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "prev_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "links": {
          "$ref": "#/components/schemas/ExternalDatabasePaginationLinks"
        }
      }
    },
    "ExternalDatabasePaginationLinks": {
      "type": "object",
      "properties": {
        "next": {
          "type": "string"
        },
        "prev": {
          "type": "string"
        }
      }
    },
    "ExternalDatabaseCreateResponse": {
      "type": "object",
      "properties": {
        "external_database": {
          "$ref": "#/components/schemas/ExternalDatabaseCreated"
        }
      }
    },
    "ExternalDatabaseCreated": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "activity_logs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "ExternalDatabaseInsertResponse": {
      "type": "object",
      "properties": {
        "external_database": {
          "$ref": "#/components/schemas/ExternalDatabaseInsertResult"
        }
      }
    },
    "ExternalDatabaseInsertResult": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "inserted_data": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "ExternalDatabaseSearchResponse": {
      "type": "object",
      "properties": {
        "external_database": {
          "$ref": "#/components/schemas/ExternalDatabaseSearchResult"
        }
      }
    },
    "ExternalDatabaseSearchResult": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "description": "The number of rows found."
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "list": {
          "type": "object",
          "description": "One array of rows per table name; each row maps column names to values.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "ExternalDatabaseUpdateResponse": {
      "type": "object",
      "properties": {
        "external_database": {
          "$ref": "#/components/schemas/ExternalDatabaseUpdateResult"
        }
      }
    },
    "ExternalDatabaseUpdateResult": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    }
  }
}
