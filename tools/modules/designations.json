{
  "family": "designations",
  "tag": "Designations",
  "slug": "designations",
  "icon": "user-tie",
  "base": "/settings/designations",
  "overview_description": "Manage designations in Exsited: list, create, retrieve, update and delete the job titles you assign.",
  "intro": "Designations are the job titles configured in your Exsited settings. You can list, create, retrieve, update and delete them. This area has 5 endpoints, and all seven SDKs call every one.",
  "warning": "**Deleting a designation cannot be undone.** After a delete, reading the designation returns `404`.",
  "notes": [
    "**Request bodies go under `designation`.** Both the create and the update wrap their fields in a `designation` object, and the response returns the record under the same key.",
    "**`name` is required to create a designation.** `display_name` and `description` are optional.",
    "**Designation ids start with `des_`.** Pass that `id` as `designation_id`.",
    "**The list pages by cursor.** Records are under `data`; pass `pagination.next_cursor` as `cursor` while `pagination.has_more` is `true`."
  ],
  "endpoints": [
    {
      "key": "get_settings_designations",
      "method": "GET",
      "path": "/settings/designations",
      "slug": "list-designations",
      "title": "List designations",
      "summary": "Lists the designations (job titles) set up in Exsited, one page at a time.",
      "description": "Returns one page of designations under `data`, with `pagination` for the next page. Each designation carries its `id`, `name`, `display_name`, `description` and `status`. Any other field of the record filters the listing as `filter_<field>` or `filter_<field>_<operator>`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "How many records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` of the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by; prefix it with `-` for descending order, such as `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "One page of designations.",
          "schema": {
            "$ref": "#/components/schemas/DesignationList"
          }
        }
      },
      "example_call": {
        "path": {},
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "create_settings_designation",
      "method": "POST",
      "path": "/settings/designations",
      "slug": "create-a-designation",
      "title": "Create a designation",
      "summary": "Creates a designation and returns it under `designation`.",
      "description": "Send the new designation under `designation`. `name` is required. The new designation comes back under `designation`, with its `des_` id.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "designation": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The designation's name."
                },
                "display_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "designation"
          ]
        },
        "example": {
          "designation": {
            "name": "Site Supervisor"
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new designation, under `designation`.",
          "schema": {
            "$ref": "#/components/schemas/DesignationResponse"
          }
        }
      },
      "example_call": {
        "path": {},
        "body": {
          "designation": {
            "name": "Site Supervisor"
          }
        }
      }
    },
    {
      "key": "get_settings_designation",
      "method": "GET",
      "path": "/settings/designations/{designation_id}",
      "slug": "retrieve-a-designation",
      "title": "Retrieve a designation",
      "summary": "Retrieves one designation by its `des_` id.",
      "description": "Returns the designation under `designation`.",
      "parameters": [
        {
          "name": "designation_id",
          "in": "path",
          "required": true,
          "description": "The designation's `id`, which starts with `des_`.",
          "schema": {
            "type": "string",
            "example": "des_8a1b2c3d4e5f40718293a4b5c6d7e8f9"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The designation, under `designation`.",
          "schema": {
            "$ref": "#/components/schemas/DesignationResponse"
          }
        },
        "404": {
          "description": "No designation has that `id`, for example because it has been deleted."
        }
      },
      "example_call": {
        "path": {
          "designation_id": "des_8a1b2c3d4e5f40718293a4b5c6d7e8f9"
        }
      }
    },
    {
      "key": "delete_settings_designation",
      "method": "DELETE",
      "path": "/settings/designations/{designation_id}",
      "slug": "delete-a-designation",
      "title": "Delete a designation",
      "summary": "Deletes a designation; the response has no body.",
      "description": "Deletes the designation with this `id`. A successful delete returns `204` with no body, and reading the designation afterwards returns `404`.",
      "parameters": [
        {
          "name": "designation_id",
          "in": "path",
          "required": true,
          "description": "The designation's `id`, which starts with `des_`.",
          "schema": {
            "type": "string",
            "example": "des_8a1b2c3d4e5f40718293a4b5c6d7e8f9"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The designation is deleted. No body."
        }
      },
      "example_call": {
        "path": {
          "designation_id": "des_8a1b2c3d4e5f40718293a4b5c6d7e8f9"
        }
      }
    },
    {
      "key": "update_settings_designation",
      "method": "PATCH",
      "path": "/settings/designations/{designation_id}",
      "slug": "update-a-designation",
      "title": "Update a designation",
      "summary": "Changes a designation's name, display name or description.",
      "description": "Send the fields to change under `designation`: `name`, `display_name` or `description`. The updated designation comes back under `designation`.",
      "parameters": [
        {
          "name": "designation_id",
          "in": "path",
          "required": true,
          "description": "The designation's `id`, which starts with `des_`.",
          "schema": {
            "type": "string",
            "example": "des_8a1b2c3d4e5f40718293a4b5c6d7e8f9"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "designation": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "designation"
          ]
        },
        "example": {
          "designation": {
            "display_name": "Senior Site Supervisor",
            "description": "Leads the site crew"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The updated designation, under `designation`.",
          "schema": {
            "$ref": "#/components/schemas/DesignationResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "designation_id": "des_8a1b2c3d4e5f40718293a4b5c6d7e8f9"
        },
        "body": {
          "designation": {
            "display_name": "Senior Site Supervisor",
            "description": "Leads the site crew"
          }
        }
      }
    }
  ],
  "schemas": {
    "Designation": {
      "type": "object",
      "properties": {
        "created_by": {
          "type": "null"
        },
        "created_on": {
          "type": "string"
        },
        "description": {
          "type": "null"
        },
        "display_name": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "last_updated_by": {
          "type": "null"
        },
        "last_updated_on": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "DesignationResponse": {
      "type": "object",
      "properties": {
        "designation": {
          "$ref": "#/components/schemas/Designation"
        }
      }
    },
    "DesignationList": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Designation"
          }
        },
        "object": {
          "type": "string"
        },
        "pagination": {
          "$ref": "#/components/schemas/DesignationPagination"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "DesignationPagination": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "description": "The page size applied to this page."
        },
        "has_more": {
          "type": "boolean",
          "description": "Whether another page follows. Rely on this rather than on `next_cursor`, which can still hold a value on the last page."
        },
        "next_cursor": {
          "type": "string",
          "description": "Pass as `cursor` to fetch the next page."
        },
        "prev_cursor": {
          "type": "string"
        },
        "links": {
          "$ref": "#/components/schemas/DesignationPaginationLinks"
        }
      }
    },
    "DesignationPaginationLinks": {
      "type": "object",
      "properties": {
        "next": {
          "type": "string"
        },
        "prev": {
          "type": "string"
        }
      }
    }
  }
}
