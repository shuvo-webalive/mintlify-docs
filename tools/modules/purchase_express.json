{
  "family": "purchase_express",
  "tag": "Purchase express",
  "slug": "purchase-express",
  "icon": "bolt",
  "base": "/purchase_express",
  "overview_description": "Create a purchase order for a supplier in a single call.",
  "intro": "Purchase express creates a purchase order for a supplier in one call. The API also accepts a nested purchase invoice and payment, but their fields are not documented yet. This area has 1 endpoint, available in all seven SDKs.",
  "warning": null,
  "notes": [
    "**The body is wrapped in `account`.** The supplier goes in `account.id` and the order in `account.purchase_order`.",
    "**Without a nested purchase invoice, nothing is billed or paid.** Only the purchase order is created.",
    "**The new purchase order comes back under `purchase_express`.** Read or manage it afterwards through the purchase order endpoints."
  ],
  "endpoints": [
    {
      "key": "create_purchase_express",
      "method": "POST",
      "path": "/purchase_express",
      "slug": "create-an-express-purchase-order",
      "title": "Create an express purchase order",
      "summary": "Creates a purchase order for a supplier in one call and returns it under `purchase_express`.",
      "description": "Creates a purchase order for a supplier in one call, with the body under `account.purchase_order`. The API also accepts a nested purchase invoice and payment, but their fields are not documented yet; without them, only the purchase order is created and nothing is billed or paid. The new purchase order comes back under `purchase_express`.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "account": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The supplier account's `id`."
                },
                "purchase_order": {
                  "type": "object",
                  "properties": {
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "item_id": {
                            "type": "string"
                          },
                          "item_quantity": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  },
                  "description": "The purchase order to create, with its lines."
                }
              }
            }
          },
          "required": [
            "account"
          ]
        },
        "example": {
          "account": {
            "id": "W13ZGY",
            "purchase_order": {
              "lines": [
                {
                  "item_id": "ITEM-0001",
                  "item_quantity": 1
                }
              ]
            }
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new purchase order, under `purchase_express`.",
          "schema": {
            "$ref": "#/components/schemas/PurchaseExpressResponse"
          }
        }
      },
      "example_call": {
        "path": {},
        "body": {
          "account": {
            "id": "W13ZGY",
            "purchase_order": {
              "lines": [
                {
                  "item_id": "ITEM-0001",
                  "item_quantity": 1
                }
              ]
            }
          }
        }
      }
    }
  ],
