{
  "family": "applications",
  "tag": "Applications",
  "slug": "applications",
  "icon": "key",
  "base": "/settings/applications",
  "overview_description": "List, create, read, update and delete the OAuth applications registered on your Exsited instance.",
  "intro": "Applications are the OAuth applications registered on your Exsited instance. You can list, create, read, update and delete them. This area has 5 endpoints, and all seven SDKs call every one.",
  "warning": "**The client id and secret of a new application are generated by Exsited and never returned by the API.**",
  "notes": [
    "**`name` and `redirect_url` are required to create an application.** Send them under `application`.",
    "**Applications are identified by an `app_` id.** Use the `id` from a create or a listing as `application_id`.",
    "**Every single record comes back under `application`.** Create, read and update all return `{\"application\": {...}}`.",
    "**Delete returns `204` with no body.** A read of the deleted application then returns `404`.",
    "**The listing pages by cursor.** Records are under `data`, with `limit`, `has_more` and `next_cursor` in `pagination`."
  ],
  "endpoints": [
    {
      "key": "get_settings_applications",
      "method": "GET",
      "path": "/settings/applications",
      "slug": "list-applications",
      "title": "List applications",
      "summary": "Returns one page of the OAuth applications on your instance.",
      "description": "Records are under `data`, and the listing pages by cursor. Other fields filter as `filter_<field>`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "The number of records per page. A `limit` of `0` returns `400`.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` from the previous page, to read the next page.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by; prefix it with `-` for descending order.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "One page of applications, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/ApplicationList"
          }
        }
      },
      "example_call": {
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "create_settings_application",
      "method": "POST",
      "path": "/settings/applications",
      "slug": "create-an-application",
      "title": "Create an application",
      "summary": "Creates an OAuth application and returns it under `application`.",
      "description": "Send the application under `application` with a `name` and a `redirect_url`; both are required. Exsited generates the client id and secret, and the API never returns them.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "application": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "redirect_url": {
                  "type": "string",
                  "format": "uri"
                },
                "display_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "redirect_url"
              ]
            }
          },
          "required": [
            "application"
          ]
        },
        "example": {
          "application": {
            "name": "Acme Integration",
            "redirect_url": "https://example.com/callback"
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new application, under `application`.",
          "schema": {
            "$ref": "#/components/schemas/ApplicationResponse"
          }
        }
      },
      "example_call": {
        "body": {
          "application": {
            "name": "Acme Integration",
            "redirect_url": "https://example.com/callback"
          }
        }
      }
    },
    {
      "key": "get_settings_application",
      "method": "GET",
      "path": "/settings/applications/{application_id}",
      "slug": "retrieve-an-application",
      "title": "Retrieve an application",
      "summary": "Returns one OAuth application by its `app_` id.",
      "description": "Pass the application's `id` as `application_id`. The response holds the application under `application`.",
      "parameters": [
        {
          "name": "application_id",
          "in": "path",
          "required": true,
          "description": "The application's `id`, which starts with `app_`.",
          "schema": {
            "type": "string",
            "example": "app_0123456789abcdef"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The application, under `application`.",
          "schema": {
            "$ref": "#/components/schemas/ApplicationResponse"
          }
        },
        "404": {
          "description": "No application has that `id`, for example after it is deleted."
        }
      },
      "example_call": {
        "path": {
          "application_id": "app_0123456789abcdef"
        }
      }
    },
    {
      "key": "delete_settings_application",
      "method": "DELETE",
      "path": "/settings/applications/{application_id}",
      "slug": "delete-an-application",
      "title": "Delete an application",
      "summary": "Deletes an OAuth application and returns no body.",
      "description": "Pass the application's `id` as `application_id`. A successful call returns `204` with no body, and a read of the same `id` then returns `404`.",
      "parameters": [
        {
          "name": "application_id",
          "in": "path",
          "required": true,
          "description": "The application's `id`, which starts with `app_`.",
          "schema": {
            "type": "string",
            "example": "app_0123456789abcdef"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The application is deleted. No body."
        }
      },
      "example_call": {
        "path": {
          "application_id": "app_0123456789abcdef"
        }
      }
    },
    {
      "key": "update_settings_application",
      "method": "PATCH",
      "path": "/settings/applications/{application_id}",
      "slug": "update-an-application",
      "title": "Update an application",
      "summary": "Changes an OAuth application's fields or its status and returns it under `application`.",
      "description": "Send the fields to change under `application`, such as `display_name` and `description`, or a new `status`. The response holds the updated application under `application`.",
      "parameters": [
        {
          "name": "application_id",
          "in": "path",
          "required": true,
          "description": "The application's `id`, which starts with `app_`.",
          "schema": {
            "type": "string",
            "example": "app_0123456789abcdef"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "application": {
              "type": "object",
              "properties": {
                "display_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "application"
          ]
        },
        "example": {
          "application": {
            "display_name": "Acme Integration",
            "description": "Syncs orders with Acme"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The updated application, under `application`.",
          "schema": {
            "$ref": "#/components/schemas/ApplicationResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "application_id": "app_0123456789abcdef"
        },
        "body": {
          "application": {
            "display_name": "Acme Integration",
            "description": "Syncs orders with Acme"
          }
        }
      }
    }
  ],
  "schemas": {
    "Application": {
      "type": "object",
      "properties": {
        "object": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "description": "The application id, starting with `app_`."
        },
        "status": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "created_on": {
          "type": "string"
        },
        "last_updated_on": {
          "type": "string"
        },
        "created_by": {
          "type": "null",
          "description": "Returned as `null`."
        },
        "last_updated_by": {
          "type": "null",
          "description": "Returned as `null`."
        },
        "href": {
          "type": "string"
        }
      }
    },
    "ApplicationResponse": {
      "type": "object",
      "properties": {
        "application": {
          "$ref": "#/components/schemas/Application"
        }
      }
    },
    "ApplicationList": {
      "type": "object",
      "properties": {
        "object": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Application"
          }
        },
        "pagination": {
          "$ref": "#/components/schemas/ApplicationPagination"
        }
      }
    },
    "ApplicationPagination": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer"
        },
        "has_more": {
          "type": "boolean",
          "description": "`false` on the last page, even if `next_cursor` is set."
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "prev_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "links": {
          "$ref": "#/components/schemas/ApplicationPaginationLinks"
        }
      }
    },
    "ApplicationPaginationLinks": {
      "type": "object",
      "properties": {
        "next": {
          "type": "string"
        },
        "prev": {
          "type": "string"
        }
      }
    }
  }
}
