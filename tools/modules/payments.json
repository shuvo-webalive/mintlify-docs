    {
      "key": "create_payment_note",
      "method": "POST",
      "path": "/payments/{payment_id}/notes",
      "slug": "create-a-payment-note",
      "title": "Create a payment note",
      "summary": "Adds a note, and optionally a file, to a payment and returns the note.",
      "description": "Sends a multipart form: the text as the `note` field and any attachment as `file`. The text can contain HTML such as `<p>` tags. The new note comes back with its `id` and the `uuid` of each attachment.",
      "parameters": [
        {
          "name": "payment_id",
          "in": "path",
          "required": true,
          "description": "The payment's `id`.",
          "schema": {
            "type": "string",
            "example": "PAY-0001"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "required": [
            "note"
          ],
          "properties": {
            "note": {
              "type": "string",
              "description": "The note text. HTML such as `<p>` tags is kept."
            },
            "file": {
              "type": "string",
              "format": "binary",
              "description": "An optional file to attach to the note."
            }
          }
        },
        "example": {
          "note": "Customer asked for a copy by post."
        }
      },
      "multipart": true,
      "responses": {
        "201": {
          "description": "The new note, under `note`.",
          "schema": {
            "$ref": "#/components/schemas/PaymentNotesResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "payment_id": "PAY-0001"
        },
        "file": "receipt.pdf",
        "note": "Customer asked for a copy by post."
      }
