    {
      "key": "create_payment",
      "method": "POST",
      "path": "/payments",
      "slug": "create-a-payment",
      "title": "Create a payment",
      "summary": "Records a payment against one or more invoices and returns it.",
      "description": "Records a payment from the fields under `payment`. Only the keys shown are accepted; any other returns `400`. A `payment_applied` entry whose processor holds a card token charges the card.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "payment": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "origin": {
                  "type": "string"
                },
                "payment_note": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "invoices": {
                  "type": "array",
                  "description": "The invoices the payment is for.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The invoice's `id`."
                      },
                      "applied": {
                        "type": "string",
                        "description": "The amount applied to this invoice."
                      }
                    }
                  }
                },
                "payment_applied": {
                  "type": "array",
                  "description": "The money received, by processor.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "processor": {
                        "type": "string",
                        "description": "The payment processor, such as `Cash`."
                      },
                      "amount": {
                        "type": "string"
                      },
                      "reference": {
                        "type": "string"
                      }
                    }
                  }
                },
                "credit_applied": {
                  "type": "array",
                  "description": "Credit notes spent on the payment.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "description": "The credit note's `code`."
                      },
                      "amount": {
                        "type": "number"
                      }
                    }
                  }
                },
                "gift_certificates": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "custom_attributes": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "required": [
            "payment"
          ]
        },
        "example": {
          "payment": {
            "date": "2026-10-01",
            "payment_note": "October invoice",
            "payment_applied": [
              {
                "processor": "Cash",
                "amount": "10.00",
                "reference": "RCPT-1001"
              }
            ],
            "invoices": [
              {
                "id": "INV-0001",
                "applied": "10.00"
              }
            ]
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new payment, under `payment`.",
          "schema": {
            "$ref": "#/components/schemas/PaymentReadResponse"
          }
        },
        "400": {
          "description": "The body has a key the payment does not accept."
        }
      },
      "example_call": {
        "path": {},
        "body": {
          "payment": {
            "date": "2026-10-01",
            "payment_note": "October invoice",
            "payment_applied": [
              {
                "processor": "Cash",
                "amount": "10.00",
                "reference": "RCPT-1001"
              }
            ],
            "invoices": [
              {
                "id": "INV-0001",
