    {
      "key": "get_invoice_payment",
      "method": "GET",
      "path": "/invoices/{invoice_id}/payments/{payment_id}",
      "slug": "retrieve-a-payment-through-an-invoice",
      "title": "Retrieve a payment through an invoice",
      "summary": "Returns one payment by its `id`, reached through an invoice.",
      "description": "Fetches a payment under `payment`. The server checks only that the invoice exists, not that the payment belongs to it. Each entry of the payment's `invoices` names its invoice by the invoice's `inv_` uuid, not by its `id`.",
      "parameters": [
        {
          "name": "invoice_id",
          "in": "path",
          "required": true,
          "description": "The invoice's `id`, such as `INV-0001`. Not its `uuid`.",
          "schema": {
            "type": "string",
            "example": "INV-0001"
          }
        },
        {
          "name": "payment_id",
          "in": "path",
          "required": true,
          "description": "The payment's `id`.",
          "schema": {
            "type": "string",
            "example": "PAY-0001"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The payment, under `payment`.",
          "schema": {
            "$ref": "#/components/schemas/PaymentReadResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "invoice_id": "INV-0001",
          "payment_id": "PAY-0001"
        }
      }
    },
    {
      "key": "get_payment_note_files",
      "method": "GET",
      "path": "/payments/{payment_id}/notes/{payment_note_id}/files",
      "slug": "list-a-payment-notes-files",
      "title": "List a payment note's files",
      "summary": "Returns the files attached to a note on a payment.",
      "description": "Lists the note's attachments under `data`, each with its `uuid`, `filename`, `content_type`, `size` and `href`.",
      "parameters": [
        {
          "name": "payment_id",
          "in": "path",
          "required": true,
          "description": "The payment's `id`.",
          "schema": {
            "type": "string",
            "example": "PAY-0001"
          }
        },
        {
          "name": "payment_note_id",
          "in": "path",
          "required": true,
          "description": "The note's `id`, as the payment's notes listing returns it.",
          "schema": {
            "type": "string",
            "example": "note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The note's files, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/PaymentNoteFileList"
          }
        }
      },
      "example_call": {
        "path": {
          "payment_id": "PAY-0001",
          "payment_note_id": "note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d"
        }
      }
    }
