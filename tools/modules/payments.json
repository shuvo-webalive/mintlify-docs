{
  "family": "payments",
  "tag": "Payments",
  "slug": "payments",
  "icon": "credit-card",
  "base": "/payments",
  "overview_description": "Record, read, update and delete payments against invoices, and manage the notes and files on them.",
  "intro": "A payment records money received against one or more invoices, by processor, credit note or gift certificate. This area has 15 endpoints: create, read, update and delete payments, list them by invoice or order, and manage their notes and files. All seven SDKs call every one.",
  "warning": "**Creating a payment with a `payment_applied` entry whose processor holds a card token charges the card.**",
  "notes": [
    "**Write bodies go under a `payment` key.** Creating a payment accepts only `id`, `date`, `origin`, `payment_note`, `note`, `invoices`, `payment_applied`, `credit_applied`, `gift_certificates` and `custom_attributes`; any other key returns `400`.",
    "**Listings page by cursor.** Records are under `data`. Pass `pagination.next_cursor` back as `cursor` while `pagination.has_more` is `true`.",
    "**Deleting a note takes its uuid, not its `id`.** Reads take the note's `id`; the delete takes the hex part of that `id` as a dashed uuid.",
    "**Reading a payment through an invoice does not check the invoice.** Any payment is returned under any invoice that exists.",
    "**Note text goes in a form field.** Creating a note sends a multipart form with the text as `note` and any attachment as `file`."
  ],
  "endpoints": [
    {
      "key": "get_payments",
      "method": "GET",
      "path": "/payments",
      "slug": "list-payments",
      "title": "List payments",
      "summary": "Returns one page of payments.",
      "description": "Lists every payment, one page at a time, under `data`. Each record carries its `status`, `reconcile_status`, the money received under `payment_applied`, any credit or gift certificate spent, and the `invoices` it paid. Other fields filter as `filter_<field>`, or `filter_<field>_<operator>` with an operator such as `gte` or `contains`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "The most records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` value from the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Put `-` in front for descending order, such as `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "One page of payments, under `data`, with `pagination`.",
          "schema": {
            "$ref": "#/components/schemas/PaymentList"
          }
        }
      },
      "example_call": {
        "path": {},
        "query": {
          "limit": 20
        }
      }
    },
