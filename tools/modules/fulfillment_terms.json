{
  "family": "fulfillment_terms",
  "tag": "Fulfillment terms",
  "slug": "fulfillment-terms",
  "icon": "calendar-days",
  "base": "/settings/fulfillment_terms",
  "overview_description": "List, read, create, update and delete fulfillment terms, each a named period and duration.",
  "intro": "A fulfillment term is a named length of time, given as a `period` such as monthly and a `duration` counting those periods. These endpoints list, read, create, update and delete terms. This area has 5 endpoints, and all seven SDKs call every one.",
  "warning": null,
  "notes": [
    "**`period` is sent in upper case and returned in lower case.** Send `MONTHLY`; the term comes back with `monthly`.",
    "**`duration` is an integer.** It counts the periods, so `period: MONTHLY` with `duration: 1` is one month.",
    "**`status` takes `active` or `inactive`.** Send it on the update to turn a term on or off.",
    "**Writes are wrapped in `fulfillment_term`, and one term comes back under `fulfillment_term`.**",
    "**The listing pages by cursor.** Pass `limit`, then send the `next_cursor` from `pagination` as `cursor` until `has_more` is `false`."
  ],
  "endpoints": [
    {
      "key": "get_settings_fulfillment_terms",
      "method": "GET",
      "path": "/settings/fulfillment_terms",
      "slug": "list-fulfillment-terms",
      "title": "List fulfillment terms",
      "summary": "Returns a page of fulfillment terms.",
      "description": "Returns terms under `data`, each with its `name`, `period`, `duration` and `status`. Set the page size with `limit` and fetch the next page with `cursor`. Other fields filter as `filter_<field>`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "How many records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` from the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Prefix it with `-` to sort descending, as in `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "A page of fulfillment terms, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/FulfillmentTermList"
          }
        }
      },
      "example_call": {
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "create_settings_fulfillment_term",
      "method": "POST",
      "path": "/settings/fulfillment_terms",
      "slug": "create-a-fulfillment-term",
      "title": "Create a fulfillment term",
      "summary": "Creates a fulfillment term and returns it under `fulfillment_term`.",
      "description": "Send the term under `fulfillment_term` with its `name`, `display_name`, `period` in upper case and `duration`. The response gives `period` in lower case.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "fulfillment_term": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "period": {
                  "type": "string",
                  "description": "Send in upper case, such as `MONTHLY`."
                },
                "duration": {
                  "type": "integer",
                  "description": "How many periods the term lasts."
                }
              }
            }
          },
          "required": [
            "fulfillment_term"
          ]
        },
        "example": {
          "fulfillment_term": {
            "name": "One month",
            "display_name": "One month",
            "period": "MONTHLY",
            "duration": 1
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new fulfillment term, under `fulfillment_term`.",
          "schema": {
            "$ref": "#/components/schemas/FulfillmentTermResponse"
          }
        }
      },
      "example_call": {
        "body": {
          "fulfillment_term": {
            "name": "One month",
            "display_name": "One month",
            "period": "MONTHLY",
            "duration": 1
          }
        }
      }
    },
    {
      "key": "get_settings_fulfillment_term",
      "method": "GET",
      "path": "/settings/fulfillment_terms/{fulfillment_term_id}",
      "slug": "retrieve-a-fulfillment-term",
      "title": "Retrieve a fulfillment term",
      "summary": "Returns one fulfillment term by its `id`.",
      "description": "Returns the term under `fulfillment_term`, with its `name`, `period`, `duration` and `status`.",
      "parameters": [
        {
          "name": "fulfillment_term_id",
          "in": "path",
          "required": true,
          "description": "The fulfillment term's `id`, from the listing.",
          "schema": {
            "type": "string",
            "example": "ft_6e7f8091a2b3c4d5e6f708192a3b4c5d"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The fulfillment term, under `fulfillment_term`.",
          "schema": {
            "$ref": "#/components/schemas/FulfillmentTermResponse"
          }
        },
        "404": {
          "description": "No fulfillment term has that `id`."
        }
      },
      "example_call": {
        "path": {
          "fulfillment_term_id": "ft_6e7f8091a2b3c4d5e6f708192a3b4c5d"
        }
      }
    },
    {
      "key": "delete_settings_fulfillment_term",
      "method": "DELETE",
      "path": "/settings/fulfillment_terms/{fulfillment_term_id}",
      "slug": "delete-a-fulfillment-term",
      "title": "Delete a fulfillment term",
      "summary": "Deletes a fulfillment term. A successful call returns `204` with no body.",
      "description": "Deletes the term with that `id`; a later read of it returns `404`.",
      "parameters": [
        {
          "name": "fulfillment_term_id",
          "in": "path",
          "required": true,
          "description": "The fulfillment term's `id`, from the listing.",
          "schema": {
            "type": "string",
            "example": "ft_6e7f8091a2b3c4d5e6f708192a3b4c5d"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The fulfillment term is deleted. No body."
        }
      },
      "example_call": {
        "path": {
          "fulfillment_term_id": "ft_6e7f8091a2b3c4d5e6f708192a3b4c5d"
        }
      }
    },
    {
      "key": "update_settings_fulfillment_term",
      "method": "PATCH",
      "path": "/settings/fulfillment_terms/{fulfillment_term_id}",
      "slug": "update-a-fulfillment-term",
      "title": "Update a fulfillment term",
      "summary": "Changes a fulfillment term, or turns it on or off, and returns it.",
      "description": "Send the changes under `fulfillment_term`. Set `status` to `active` or `inactive` to turn the term on or off.",
      "parameters": [
        {
          "name": "fulfillment_term_id",
          "in": "path",
          "required": true,
          "description": "The fulfillment term's `id`, from the listing.",
          "schema": {
            "type": "string",
            "example": "ft_6e7f8091a2b3c4d5e6f708192a3b4c5d"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "fulfillment_term": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "period": {
                  "type": "string",
                  "description": "Send in upper case, such as `MONTHLY`."
                },
                "duration": {
                  "type": "integer",
                  "description": "How many periods the term lasts."
                },
                "status": {
                  "type": "string",
                  "description": "`active` or `inactive`."
                }
              }
            }
          },
          "required": [
            "fulfillment_term"
          ]
        },
        "example": {
          "fulfillment_term": {
            "display_name": "One month",
            "description": "Fulfil within a month"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The updated fulfillment term, under `fulfillment_term`.",
          "schema": {
            "$ref": "#/components/schemas/FulfillmentTermResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "fulfillment_term_id": "ft_6e7f8091a2b3c4d5e6f708192a3b4c5d"
        },
        "body": {
          "fulfillment_term": {
            "display_name": "One month",
            "description": "Fulfil within a month"
          }
        }
      }
    }
  ],
  "schemas": {
    "FulfillmentTermList": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/FulfillmentTerm"
          }
        },
        "object": {
          "type": "string"
        },
        "pagination": {
          "$ref": "#/components/schemas/FulfillmentTermPagination"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "FulfillmentTerm": {
      "type": "object",
      "properties": {
        "created_by": {},
        "created_on": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "duration": {
          "type": "integer",
          "description": "How many periods the term lasts."
        },
        "href": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "last_updated_by": {},
        "last_updated_on": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "period": {
          "type": "string",
          "description": "The period in lower case, such as `monthly`."
        },
