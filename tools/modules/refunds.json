    {
      "key": "get_refund_note",
      "method": "GET",
      "path": "/refunds/{refund_id}/notes/{note_id}",
      "slug": "retrieve-a-refund-note",
      "title": "Retrieve a refund note",
      "summary": "Returns one note on a refund.",
      "description": "Fetches a single note by its `id`, which starts with `note_`.",
      "parameters": [
        {
