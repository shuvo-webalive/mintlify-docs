      "warning": "**This call has not been confirmed to work.**"
    },
    {
      "key": "create_refund_note",
      "method": "POST",
      "path": "/refunds/{refund_id}/notes",
      "slug": "create-a-refund-note",
      "title": "Create a refund note",
      "summary": "Adds a note, and optionally a file, to a refund and returns the note.",
      "description": "Sends a multipart form: the text as the `note` field and any attachment as `file`. Deleting the note later needs the `CREATE_REFUND_NOTE` permission.",
      "parameters": [
        {
          "name": "refund_id",
          "in": "path",
          "required": true,
          "description": "The refund's code, which the refunds listing returns as `id`.",
          "schema": {
            "type": "string",
            "example": "REF-0001"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "required": [
            "note"
          ],
          "properties": {
            "note": {
              "type": "string",
              "description": "The note text."
            },
            "file": {
              "type": "string",
              "format": "binary",
              "description": "An optional file to attach to the note."
            }
          }
        },
        "example": {
          "note": "Customer asked for a copy by post."
        }
      },
      "multipart": true,
      "responses": {
        "201": {
          "description": "The new note, under `note`.",
          "schema": {
            "$ref": "#/components/schemas/RefundNoteResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "refund_id": "REF-0001"
        },
        "file": "receipt.pdf",
        "note": "Customer asked for a copy by post."
      }
    },
    {
      "key": "delete_refund_note",
      "method": "DELETE",
      "path": "/refunds/{refund_id}/notes/{note_id}",
      "slug": "delete-a-refund-note",
      "title": "Delete a refund note",
      "summary": "Deletes a note from a refund.",
      "description": "Deletes the note. The server checks the `CREATE_REFUND_NOTE` permission here, not a delete permission.",
      "parameters": [
        {
          "name": "refund_id",
          "in": "path",
          "required": true,
          "description": "The refund's code, which the refunds listing returns as `id`.",
          "schema": {
            "type": "string",
            "example": "REF-0001"
          }
        },
        {
          "name": "note_id",
          "in": "path",
          "required": true,
          "description": "The note's `id`, which starts with `note_`.",
          "schema": {
            "type": "string",
            "example": "note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The note is deleted. The response has no body."
        },
        "403": {
          "description": "The API client lacks the `CREATE_REFUND_NOTE` permission, which this delete checks."
        }
      },
      "example_call": {
        "path": {
          "refund_id": "REF-0001",
          "note_id": "note_3f2b8c1d9e4a4f6b8c2d1e0f9a8b7c6d"
        }
      },
      "warning": "**This call has not been confirmed to work.** No successful delete has been confirmed. Deleting a payment note takes the note's `id` as a dashed uuid rather than its `note_` id, and this call may do the same."
    },
