{
  "family": "refunds",
  "tag": "Refunds",
  "slug": "refunds",
  "icon": "rotate-left",
  "base": "/refunds",
  "overview_description": "Create refunds from credit notes, read, update and delete them, and manage the notes and files on them.",
  "intro": "A refund pays money back to an account out of a credit note. This area has 12 endpoints: create a refund from a credit note, read, update and delete refunds, and manage their notes and files. Every SDK supports all of them.",
  "warning": null,
  "notes": [
    "**Identify a refund by its code.** `{refund_id}` is the code the refunds listing returns as `id`.",
    "**A refund comes from a credit note.** Create one under the credit note, identified by its `code`, with `amount` and `payment_method` under `refund`.",
    "**Amounts are strings.** A refund's `amount` reads like `\"2.00\"`.",
    "**Note deletes check the create permission.** Deleting a refund note or its file needs `CREATE_REFUND_NOTE`; without it the call returns `403`.",
    "**Listings page by cursor.** Records are under `data`. Pass `pagination.next_cursor` back as `cursor` while `pagination.has_more` is `true`."
  ],
  "endpoints": [
    {
      "key": "get_refunds",
      "method": "GET",
      "path": "/refunds",
      "slug": "list-refunds",
      "title": "List refunds",
      "summary": "Returns one page of refunds.",
      "description": "Lists every refund, one page at a time, under `data`. Each record carries its `amount` as a string, the `payment_method`, the `reconcile_status`, and the account and credit note it belongs to. To filter, add `filter_<field>=<value>`, or `filter_<field>_<operator>=<value>` with an operator such as `gte` or `contains`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "The most records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` value from the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Put `-` in front for descending order, such as `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "One page of refunds, under `data`, with `pagination`.",
          "schema": {
            "$ref": "#/components/schemas/RefundList"
          }
        }
      },
      "example_call": {
        "path": {},
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "delete_refund",
      "method": "DELETE",
      "path": "/refunds/{refund_id}",
      "slug": "delete-a-refund",
      "title": "Delete a refund",
      "summary": "Deletes a refund.",
      "description": "Deletes the refund. Afterwards a read of the same refund returns `404`.",
      "parameters": [
        {
          "name": "refund_id",
          "in": "path",
          "required": true,
          "description": "The refund's code, which the refunds listing returns as `id`.",
          "schema": {
            "type": "string",
            "example": "REF-0001"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The refund is deleted. The response has no body."
        }
      },
      "example_call": {
        "path": {
          "refund_id": "REF-0001"
        }
      }
    },
    {
      "key": "get_refund",
      "method": "GET",
      "path": "/refunds/{refund_id}",
      "slug": "retrieve-a-refund",
      "title": "Retrieve a refund",
      "summary": "Returns one refund by its code.",
      "description": "Fetches a single refund with its amount, payment method, reference, note, account and credit note.",
      "parameters": [
        {
          "name": "refund_id",
          "in": "path",
          "required": true,
          "description": "The refund's code, which the refunds listing returns as `id`.",
          "schema": {
            "type": "string",
            "example": "REF-0001"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The refund, under `refund`.",
          "schema": {
            "$ref": "#/components/schemas/RefundResponse"
          }
        },
        "404": {
          "description": "No refund has that code."
        }
      },
      "example_call": {
        "path": {
          "refund_id": "REF-0001"
        }
      }
    },
    {
      "key": "update_refund",
      "method": "PATCH",
      "path": "/refunds/{refund_id}",
      "slug": "update-a-refund",
      "title": "Update a refund",
      "summary": "Changes a refund's reference or note and returns the refund.",
      "description": "Updates the fields sent under `refund`, such as `reference` and `note`. The refund's `version` goes up.",
      "parameters": [
        {
          "name": "refund_id",
          "in": "path",
          "required": true,
          "description": "The refund's code, which the refunds listing returns as `id`.",
          "schema": {
            "type": "string",
            "example": "REF-0001"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "refund": {
              "type": "object",
              "properties": {
                "reference": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "refund"
          ]
        },
        "example": {
          "refund": {
            "reference": "BANK-REF-2001",
            "note": "Refunded to the original card."
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The updated refund, under `refund`.",
          "schema": {
            "$ref": "#/components/schemas/RefundWriteResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "refund_id": "REF-0001"
        },
        "body": {
          "refund": {
            "reference": "BANK-REF-2001",
            "note": "Refunded to the original card."
          }
        }
      }
    },
    {
      "key": "create_credit_note_refund",
      "method": "POST",
      "path": "/credit_notes/{credit_note_id}/refunds",
      "slug": "create-a-refund-from-a-credit-note",
      "title": "Create a refund from a credit note",
      "summary": "Refunds part or all of a credit note and returns the new refund.",
      "description": "Creates a refund against the credit note from the fields under `refund`: the `amount` and the `payment_method` to refund through. The credit note's `refund_amount` goes up by the amount.",
      "parameters": [
        {
          "name": "credit_note_id",
          "in": "path",
          "required": true,
          "description": "The credit note's `code`.",
          "schema": {
            "type": "string",
            "example": "CN-0001"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "refund": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string",
                  "description": "The amount to refund, such as `\"2.00\"`."
                },
                "payment_method": {
                  "type": "string",
                  "description": "The payment method, such as the value in the original payment's `payment_applied[].method`."
                }
              }
            }
          },
          "required": [
            "refund"
          ]
        },
        "example": {
          "refund": {
            "amount": "2.00",
            "payment_method": "Cash"
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new refund, under `refund`.",
          "schema": {
            "$ref": "#/components/schemas/RefundWriteResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "credit_note_id": "CN-0001"
        },
        "body": {
          "refund": {
            "amount": "2.00",
            "payment_method": "Cash"
          }
        }
      }
    },
