{
  "family": "credit_note_applications",
  "tag": "Credit note applications",
  "slug": "credit-note-applications",
  "icon": "money-check-dollar",
  "base": "/credit_note_applications",
  "overview_description": "Read the records of credit notes applied to invoices, across all invoices or for one invoice.",
  "intro": "A credit note application records part of a credit note being spent against an invoice through a payment. This area has 3 read endpoints: list all applications, retrieve one, and list one invoice's applications. Every SDK supports all of them.",
  "warning": null,
  "notes": [
    "**Applications are read only here.** One is created when a payment spends a credit note, by listing the credit note's `code` and an `amount` under `credit_applied`.",
    "**Listings page by cursor.** Records are under `data`. Pass `pagination.next_cursor` back as `cursor` while `pagination.has_more` is `true`.",
    "**`amount` and `remaining_balance` are numbers.** Unlike most money fields elsewhere, which are strings, these two come back as JSON numbers.",
    "**A single application comes back under `credit_note_application`.** It names its `credit_note`, `payment` and `refund` as small references with `id`, `name` and `href`."
  ],
  "endpoints": [
    {
      "key": "get_credit_note_applications",
      "method": "GET",
      "path": "/credit_note_applications",
      "slug": "list-credit-note-applications",
      "title": "List credit note applications",
      "summary": "Returns one page of credit note applications across all invoices.",
      "description": "Lists every credit note application, one page at a time, under `data`. Each record names its `credit_note`, the `payment` it made and the `amount` applied. To filter, add `filter_<field>=<value>`, or `filter_<field>_<operator>=<value>` with an operator such as `gte` or `contains`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "The most records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` value from the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Put `-` in front for descending order, such as `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "One page of credit note applications, under `data`, with `pagination`.",
          "schema": {
            "$ref": "#/components/schemas/CreditNoteApplicationList"
          }
        }
      },
      "example_call": {
        "path": {},
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "get_credit_note_application",
      "method": "GET",
      "path": "/credit_note_applications/{credit_note_application_id}",
      "slug": "retrieve-a-credit-note-application",
      "title": "Retrieve a credit note application",
      "summary": "Returns one credit note application by its `id`.",
      "description": "Fetches a single credit note application, with the credit note it drew on, the payment it made, the `amount` and the `remaining_balance`.",
      "parameters": [
        {
          "name": "credit_note_application_id",
          "in": "path",
          "required": true,
          "description": "The credit note application's `id`.",
          "schema": {
            "type": "string",
            "example": "CNA-0001"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The credit note application, under `credit_note_application`.",
          "schema": {
            "$ref": "#/components/schemas/CreditNoteApplicationReadResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "credit_note_application_id": "CNA-0001"
        }
      }
    },
    {
      "key": "get_invoice_credit_note_applications",
      "method": "GET",
      "path": "/invoices/{invoice_id}/credit_note_applications",
      "slug": "list-an-invoices-credit-note-applications",
      "title": "List an invoice's credit note applications",
      "summary": "Returns one page of the credit note applications made to one invoice.",
      "description": "Lists the credit note applications made against the invoice, one page at a time, under `data`. To filter, add `filter_<field>=<value>`, or `filter_<field>_<operator>=<value>` with an operator such as `gte` or `contains`.",
      "parameters": [
        {
          "name": "invoice_id",
          "in": "path",
          "required": true,
          "description": "The invoice's `id`, such as `INV-0001`. Not its `uuid`.",
          "schema": {
            "type": "string",
            "example": "INV-0001"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "The most records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` value from the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Put `-` in front for descending order, such as `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "One page of the invoice's credit note applications, under `data`, with `pagination`.",
          "schema": {
            "$ref": "#/components/schemas/CreditNoteApplicationInvoiceList"
          }
        }
      },
      "example_call": {
        "path": {
          "invoice_id": "INV-0001"
        },
        "query": {
          "limit": 20
        }
      }
    }
  ],
