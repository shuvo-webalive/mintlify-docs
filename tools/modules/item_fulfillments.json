{
  "family": "item_fulfillments",
  "tag": "Item fulfillments",
  "slug": "item-fulfillments",
  "icon": "truck",
  "base": "/item_fulfillments",
  "overview_description": "Record items sent against a sale invoice's lines, then list, read, update and delete fulfillments and manage their notes.",
  "intro": "An item fulfillment records items sent against the lines of a sale invoice. These endpoints create, list, read, update and delete fulfillments, and add, list, read and delete their notes. This area has 9 endpoints, and all seven SDKs call every one.",
  "warning": "**A fulfillment cannot be deleted once any of its stock has been sent.** The delete is refused with `400` `stock_committed`.",
  "notes": [
    "**Writes are wrapped in `item_fulfillment`.** A create names the sale invoice in `invoice_id` and lists `fulfillments`, each with an `invoice_line` id and a `fulfillment_quantity`.",
    "**Fulfillment ids start with `ifm_`, and note ids with `note_`.** Pass them in the paths as they are.",
    "**Notes are stored on the fulfillment's sale invoice.** The notes listing returns the invoice's notes, and a single note read comes back under `item_fulfillment.note`.",
    "**Deleting a note looks on the fulfillment itself.** A note added through the create note endpoint is stored on the invoice, so that delete does not find it.",
    "**A new fulfillment comes back with `fulfillment_status` `shipped`.** Each update raises its `version`.",
    "**The listing pages by cursor.** Pass `limit`, then send the `next_cursor` from `pagination` as `cursor` until `has_more` is `false`."
  ],
  "endpoints": [
    {
      "key": "get_item_fulfillments",
      "method": "GET",
      "path": "/item_fulfillments",
      "slug": "list-item-fulfillments",
      "title": "List item fulfillments",
      "summary": "Returns a page of item fulfillments.",
      "description": "Returns fulfillments under `data`, each with its account, invoice, `fulfillment_status`, `tracking_number` and `fulfillments` lines. Set the page size with `limit` and fetch the next page with `cursor`. Other fields filter as `filter_<field>`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "How many records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` from the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "A page of item fulfillments, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/ItemFulfillmentList"
          }
        }
      },
      "example_call": {
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "create_item_fulfillment",
      "method": "POST",
      "path": "/item_fulfillments",
      "slug": "create-an-item-fulfillment",
      "title": "Create an item fulfillment",
      "summary": "Records items sent against a sale invoice's lines and returns the fulfillment.",
      "description": "Send the fulfillment under `item_fulfillment`: the `invoice_id`, and `fulfillments` listing each invoice line by its id in `invoice_line` with the `fulfillment_quantity` sent. The new fulfillment comes back under `item_fulfillment` with `fulfillment_status` `shipped`.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "item_fulfillment": {
              "type": "object",
              "properties": {
                "invoice_id": {
                  "type": "string",
                  "description": "The sale invoice's `id`."
                },
                "fulfillments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "invoice_line": {
                        "type": "string",
                        "description": "The invoice line's `id`."
                      },
                      "fulfillment_quantity": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "invoice_line",
                      "fulfillment_quantity"
                    ]
                  }
                }
              },
              "required": [
                "invoice_id",
                "fulfillments"
              ]
            }
          },
          "required": [
            "item_fulfillment"
          ]
        },
        "example": {
          "item_fulfillment": {
            "invoice_id": "INV-0001",
            "fulfillments": [
              {
                "invoice_line": "8e7d6c5b-4a39-4281-9706-f5e4d3c2b1a0",
                "fulfillment_quantity": 1
              }
            ]
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new fulfillment, under `item_fulfillment`.",
          "schema": {
            "$ref": "#/components/schemas/ItemFulfillments"
          }
        }
      },
      "example_call": {
        "body": {
          "item_fulfillment": {
            "invoice_id": "INV-0001",
            "fulfillments": [
              {
                "invoice_line": "8e7d6c5b-4a39-4281-9706-f5e4d3c2b1a0",
                "fulfillment_quantity": 1
              }
            ]
          }
        }
      }
    },
    {
      "key": "get_item_fulfillment",
      "method": "GET",
      "path": "/item_fulfillments/{fulfillment_id}",
      "slug": "retrieve-an-item-fulfillment",
      "title": "Retrieve an item fulfillment",
      "summary": "Returns one item fulfillment by its `id`.",
      "description": "Returns the fulfillment under `item_fulfillment`, with its account, invoice, status, `tracking_number`, `version` and `fulfillments` lines.",
      "parameters": [
        {
          "name": "fulfillment_id",
          "in": "path",
          "required": true,
          "description": "The fulfillment's `id`, which starts with `ifm_`.",
          "schema": {
            "type": "string",
            "example": "ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The fulfillment, under `item_fulfillment`.",
          "schema": {
            "$ref": "#/components/schemas/ItemFulfillmentReadResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "fulfillment_id": "ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9"
        }
      }
    },
    {
      "key": "update_item_fulfillment",
      "method": "PATCH",
      "path": "/item_fulfillments/{fulfillment_id}",
      "slug": "update-an-item-fulfillment",
      "title": "Update an item fulfillment",
      "summary": "Changes an item fulfillment, such as its tracking number, and returns a short record.",
      "description": "Send the changes under `item_fulfillment`, such as a new `tracking_number`. The response gives the fulfillment's `id`, `code`, `status` and new `version` under `item_fulfillment`.",
      "parameters": [
        {
          "name": "fulfillment_id",
          "in": "path",
          "required": true,
          "description": "The fulfillment's `id`, which starts with `ifm_`.",
          "schema": {
            "type": "string",
            "example": "ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "item_fulfillment": {
              "type": "object",
              "properties": {
                "tracking_number": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "item_fulfillment"
          ]
        },
        "example": {
          "item_fulfillment": {
            "tracking_number": "TRK-0001"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The short fulfillment record, under `item_fulfillment`.",
          "schema": {
            "$ref": "#/components/schemas/ItemFulfillmentUpdated"
          }
        }
      },
      "example_call": {
        "path": {
          "fulfillment_id": "ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9"
        },
        "body": {
          "item_fulfillment": {
            "tracking_number": "TRK-0001"
          }
        }
      }
    },
    {
      "key": "create_item_fulfillment_note",
      "method": "POST",
      "path": "/item_fulfillments/{fulfillment_id}/notes",
      "slug": "create-an-item-fulfillment-note",
      "title": "Create an item fulfillment note",
      "summary": "Adds a note to a fulfillment, with optional files, and returns the note's id.",
      "description": "Send a multipart form with the text in the `note` field and any files as extra parts. The note is stored on the fulfillment's sale invoice, and the response gives its `id` under `note`.",
      "parameters": [
        {
          "name": "fulfillment_id",
          "in": "path",
          "required": true,
          "description": "The fulfillment's `id`, which starts with `ifm_`.",
          "schema": {
            "type": "string",
            "example": "ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "note": {
              "type": "string",
              "description": "The note's text."
            },
            "file": {
              "type": "string",
              "format": "binary",
              "description": "A file to attach. Optional; send one part per file."
            }
          },
          "required": [
            "note"
          ]
        },
        "example": {
          "note": "<p>Left with reception.</p>"
        }
      },
      "multipart": true,
      "responses": {
        "201": {
          "description": "The new note's `id` and links, under `note`.",
          "schema": {
            "$ref": "#/components/schemas/ItemFulfillmentNotesResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "fulfillment_id": "ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9"
        },
        "note": "<p>Left with reception.</p>",
        "file": "delivery-photo.jpg"
      }
    },
    {
      "key": "delete_item_fulfillment",
      "method": "DELETE",
      "path": "/item_fulfillments/{fulfillment_id}",
      "slug": "delete-an-item-fulfillment",
      "title": "Delete an item fulfillment",
      "summary": "Deletes an item fulfillment. A successful call returns `204` with no body.",
      "description": "Deletes the fulfillment with that `ifm_` id. Once any of its stock has been sent the delete is refused.",
      "parameters": [
        {
          "name": "fulfillment_id",
          "in": "path",
          "required": true,
          "description": "The fulfillment's `id`, which starts with `ifm_`.",
          "schema": {
            "type": "string",
            "example": "ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The fulfillment is deleted. No body."
        },
        "400": {
          "description": "Some of the fulfillment's stock has been sent (`stock_committed`)."
        }
      },
      "example_call": {
        "path": {
          "fulfillment_id": "ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9"
        }
      }
    },
    {
      "key": "delete_item_fulfillment_note",
      "method": "DELETE",
      "path": "/item_fulfillments/{fulfillment_id}/notes/{note_id}",
      "slug": "delete-an-item-fulfillment-note",
      "title": "Delete an item fulfillment note",
      "summary": "Deletes a note held on the fulfillment itself. A successful call returns `204` with no body.",
      "description": "Pass the fulfillment's `ifm_` id and the note's `note_` id. The delete looks for the note on the fulfillment, not on its sale invoice, where the create note endpoint stores notes.",
      "parameters": [
        {
          "name": "fulfillment_id",
          "in": "path",
          "required": true,
          "description": "The fulfillment's `id`, which starts with `ifm_`.",
          "schema": {
            "type": "string",
            "example": "ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9"
          }
        },
        {
          "name": "note_id",
          "in": "path",
          "required": true,
          "description": "The note's `id`, which starts with `note_`.",
          "schema": {
            "type": "string",
            "example": "note_b1c2d3e4f5061728394a5b6c7d8e9f00"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The note is deleted. No body."
        }
      },
      "example_call": {
        "path": {
          "fulfillment_id": "ifm_9a8b7c6d5e4f30211203f4e5d6c7b8a9",
          "note_id": "note_b1c2d3e4f5061728394a5b6c7d8e9f00"
        }
      }
    },
