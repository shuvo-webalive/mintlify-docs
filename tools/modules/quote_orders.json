{
  "family": "quote_orders",
  "tag": "Quote orders",
  "slug": "quote-orders",
  "icon": "file-invoice-dollar",
  "base": "/quote_orders",
  "overview_description": "List the invoices raised from an Exsited quote order, page by page.",
  "intro": "A quote is an order with `quote_order` set to `true`. This area reads the invoices raised from a quote; the quote itself is created, read and converted under Orders. It has 1 endpoint, and every SDK supports it.",
  "warning": null,
  "notes": [
    "**Quotes live under `/orders`.** Create a quote with `quote_order: true`, then read, change or convert it with the order calls.",
    "**Only a quote has this listing.** An order that is not a quote returns `404`.",
    "**Use a converted quote.** A quote converted with [Convert a quote to an order](/api-reference/orders/convert-a-quote-to-an-order) has `quote_converted` set to `true` and carries the invoices to list.",
    "**The listing pages by cursor.** Send `limit`, then pass `pagination.next_cursor` as `cursor` while `pagination.has_more` is `true`."
  ],
  "endpoints": [
    {
      "key": "get_quote_order_invoices",
      "method": "GET",
      "path": "/quote_orders/{quote_order_id}/invoices",
      "slug": "list-a-quotes-invoices",
      "title": "List a quote's invoices",
      "summary": "Lists the invoices raised from a quote, one page at a time.",
      "description": "Pass the quote's order `id`. The records are under `data`, and `pagination` holds the cursor for the next page. An order that is not a quote returns `404`.",
      "parameters": [
        {
          "name": "quote_order_id",
          "in": "path",
          "required": true,
          "description": "The quote's order `id`, as `GET /orders` lists it.",
          "schema": {
            "type": "string",
            "example": "ORD-0002"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "The most records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` from the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Prefix it with `-` to sort in descending order.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "One page of the quote's invoices, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/QuoteOrderInvoiceList"
          }
        },
        "404": {
          "description": "The order is not a quote."
        }
      },
      "example_call": {
        "path": {
          "quote_order_id": "ORD-0002"
        },
        "query": {
          "limit": 20
        }
      }
    }
  ],
