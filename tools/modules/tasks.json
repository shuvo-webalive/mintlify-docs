      "description": "Returns the task under `work_task`, including its `checklist`, its `assignees` (employees, labours, operators and account contacts) and its `alerts`.",
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "description": "The task's `id`, which starts with `wt_`.",
          "schema": {
            "type": "string",
            "example": "wt_2e4f6a8b0c1d4e3f9a7b5c3d1e0f2a4b"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The task, under `work_task`.",
          "schema": {
            "$ref": "#/components/schemas/TaskViewResponse"
          }
        },
        "404": {
          "description": "No task has that `id`, for example because it has been deleted."
