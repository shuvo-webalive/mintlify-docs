      "description": "Send the new items as an array under `checklist`, each with a `name`. The whole task comes back under `work_task`, with the new items at the end of its `checklist`.",
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "description": "The task's `id`, which starts with `wt_`.",
          "schema": {
            "type": "string",
            "example": "wt_2e4f6a8b0c1d4e3f9a7b5c3d1e0f2a4b"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "checklist": {
              "type": "array",
              "items": {
                "type": "object",
