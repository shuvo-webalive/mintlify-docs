          ]
        },
        "example": {
          "note": "<p>Call the client back on Monday.</p>",
          "file": "site-visit.txt"
        }
      },
      "multipart": true,
      "responses": {
        "200": {
          "description": "The new note, under `note`.",
          "schema": {
            "$ref": "#/components/schemas/TaskNoteResponse"
          }
