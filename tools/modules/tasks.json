{
  "family": "tasks",
  "tag": "Tasks",
  "slug": "tasks",
  "icon": "list-check",
  "base": "/tasks",
  "overview_description": "Manage tasks in Exsited: create, read, update and delete tasks, their checklist items, notes and note files.",
  "intro": "Tasks are units of work in Exsited, with a checklist, assignees, notes and attached files. You can create, list, retrieve, update and delete tasks, manage their checklist items, and add, read, change and remove notes and note files. This area has 18 endpoints, each available in all seven SDKs.",
  "warning": "**Adding a note to a task currently fails.** `POST /tasks/{task_code}/notes` returns `409`, so the calls that need an existing note (read, update and delete a note, and list, read and delete its files) have not been confirmed to work. Deletes in this area cannot be undone; a deleted task returns `404`.",
  "notes": [
    "**Task bodies go under `work_task`.** The create and the update wrap their fields in `work_task`, `name` is required to create, and a key the API does not know is refused.",
    "**The note routes take the task's `code`, not its `wt_` id.** A `wt_` id returns `404` on every `/notes` path; the task, checklist and update calls take the `wt_` id.",
    "**Checklist bodies go under `checklist`.** Adding items sends an array of `{\"name\": ...}`; updating one item sends a single object. Most checklist calls return the whole task under `work_task`.",
    "**`checklist` changes shape.** It is an array on the task and on the checklist list, and a single object when you retrieve one checklist item.",
    "**Notes are multipart forms.** Send the text as the `note` field and, optionally, a `file`. To read an attached file's details, use the `uuid` from the note's file list; the call returns the file's details, not its contents.",
    "**A `COMPLETED` checklist item cannot be deleted.** The delete returns `409`."
  ],
  "endpoints": [
    {
      "key": "get_tasks",
      "method": "GET",
      "path": "/tasks",
      "slug": "list-tasks",
      "title": "List tasks",
      "summary": "Lists tasks, one page at a time.",
      "description": "Returns one page of tasks under `data`, with `pagination` for the next page. Each task carries its `id`, `code`, `name`, `status`, `task_status`, `priority`, dates and hours. Any other field of the record filters the listing as `filter_<field>` or `filter_<field>_<operator>`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "How many records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` of the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by; prefix it with `-` for descending order, such as `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "One page of tasks.",
          "schema": {
            "$ref": "#/components/schemas/TaskList"
          }
        }
      },
      "example_call": {
        "path": {},
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "delete_task",
      "method": "DELETE",
      "path": "/tasks/{task_id}",
      "slug": "delete-a-task",
      "title": "Delete a task",
      "summary": "Deletes a task; the response has no body.",
      "description": "Deletes the task with this `id`. A successful delete returns `204` with no body, and reading the task afterwards returns `404`.",
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "description": "The task's `id`, which starts with `wt_`.",
          "schema": {
            "type": "string",
            "example": "wt_2e4f6a8b0c1d4e3f9a7b5c3d1e0f2a4b"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The task is deleted. No body."
        }
      },
      "example_call": {
        "path": {
          "task_id": "wt_2e4f6a8b0c1d4e3f9a7b5c3d1e0f2a4b"
        }
      }
    },
    {
      "key": "get_task",
      "method": "GET",
      "path": "/tasks/{task_id}",
