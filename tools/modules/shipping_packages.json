      "slug": "delete-a-shipping-package",
      "title": "Delete a shipping package",
      "summary": "Deletes a shipping package. A successful call returns `204` with no body.",
      "description": "Deletes the package with that `id`; a later read of it returns `404`.",
      "parameters": [
        {
          "name": "shipping_package_id",
          "in": "path",
          "required": true,
          "description": "The shipping package's `id`, from the listing.",
          "schema": {
            "type": "string",
            "example": "sp_2b3c4d5e6f708192a3b4c5d6e7f8091a"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
