      "method": "GET",
      "path": "/settings/shipping_packages/{shipping_package_id}",
      "slug": "retrieve-a-shipping-package",
      "title": "Retrieve a shipping package",
      "summary": "Returns one shipping package by its `id`.",
      "description": "Returns the package under `shipping_package`, with its name, dimensions, weight and units.",
      "parameters": [
        {
          "name": "shipping_package_id",
          "in": "path",
          "required": true,
          "description": "The shipping package's `id`, from the listing.",
          "schema": {
            "type": "string",
            "example": "sp_2b3c4d5e6f708192a3b4c5d6e7f8091a"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The shipping package, under `shipping_package`.",
          "schema": {
            "$ref": "#/components/schemas/ShippingPackageResponse"
          }
        },
        "404": {
          "description": "No shipping package has that `id`."
        }
      },
      "example_call": {
        "path": {
          "shipping_package_id": "sp_2b3c4d5e6f708192a3b4c5d6e7f8091a"
        }
      }
    },
    {
      "key": "delete_settings_shipping_package",
      "method": "DELETE",
