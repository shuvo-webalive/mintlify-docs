{
  "family": "shipping_packages",
  "tag": "Shipping packages",
  "slug": "shipping-packages",
  "icon": "box-open",
  "base": "/settings/shipping_packages",
  "overview_description": "List, read, create, update and delete shipping packages, the boxes described by their size and weight.",
  "intro": "A shipping package describes a box by its length, width, height and weight, each with an optional unit. These endpoints list, read, create, update and delete shipping packages. This area has 5 endpoints, each available in all seven SDKs.",
  "warning": null,
  "notes": [
    "**Writes are wrapped in `shipping_package`, and one package comes back under `shipping_package`.** The example create sends a `name`, a `length` and a `weight`.",
    "**Dimensions are numbers.** `length`, `width`, `height` and `weight` take numbers such as `10` or `1.5`.",
    "**A `*_uom` field takes the unit's bare uuid.** Not the unit's prefixed `id` from `GET /settings/uom`. A unit record from that listing carries only its prefixed `id`, and setting a `*_uom` field has not been confirmed to work.",
    "**The listing pages by cursor.** Pass `limit`, then send the `next_cursor` from `pagination` as `cursor` until `has_more` is `false`."
  ],
  "endpoints": [
    {
      "key": "get_settings_shipping_packages",
      "method": "GET",
      "path": "/settings/shipping_packages",
      "slug": "list-shipping-packages",
      "title": "List shipping packages",
      "summary": "Returns a page of shipping packages.",
      "description": "Returns packages under `data`, each with its name, dimensions, weight and units. Set the page size with `limit` and fetch the next page with `cursor`. Other fields filter as `filter_<field>`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "How many records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` from the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Prefix it with `-` to sort descending, as in `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "A page of shipping packages, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/ShippingPackageList"
          }
        }
      },
      "example_call": {
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "create_settings_shipping_package",
      "method": "POST",
      "path": "/settings/shipping_packages",
      "slug": "create-a-shipping-package",
      "title": "Create a shipping package",
      "summary": "Creates a shipping package and returns it under `shipping_package`.",
      "description": "Send the package under `shipping_package` with its `name` and the dimensions you know. Give a unit for a dimension in its `*_uom` field as the unit's bare uuid. Setting a `*_uom` field has not been confirmed to work.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "shipping_package": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "length": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                },
                "weight": {
                  "type": "number"
                },
                "cubic": {
                  "type": "number"
                },
                "length_uom": {
                  "type": "string",
                  "description": "The unit's bare uuid, not its prefixed id."
                },
                "width_uom": {
                  "type": "string",
                  "description": "The unit's bare uuid, not its prefixed id."
                },
                "height_uom": {
                  "type": "string",
                  "description": "The unit's bare uuid, not its prefixed id."
                },
                "weight_uom": {
                  "type": "string",
                  "description": "The unit's bare uuid, not its prefixed id."
                },
                "cubic_uom": {
                  "type": "string",
                  "description": "The unit's bare uuid, not its prefixed id."
                }
              }
            }
          },
          "required": [
            "shipping_package"
          ]
        },
        "example": {
          "shipping_package": {
            "name": "Small box",
            "length": 10,
            "weight": 1.5
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new shipping package, under `shipping_package`.",
          "schema": {
            "$ref": "#/components/schemas/ShippingPackageResponse"
          }
        }
      },
      "example_call": {
        "body": {
          "shipping_package": {
            "name": "Small box",
            "length": 10,
            "weight": 1.5
          }
        }
      }
    },
    {
