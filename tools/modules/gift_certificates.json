    {
      "key": "amend_gift_certificate",
      "method": "POST",
      "path": "/gift_certificates/{gc_id}/amend",
      "slug": "amend-a-gift-certificates-balance",
      "title": "Amend a gift certificate's balance",
      "summary": "Sets a new remaining balance on a gift certificate and returns it under `gift_certificate`.",
      "description": "Send `new_balance` under `gift_certificate`; it is the one field this call takes. A balance below the amount already used returns `400`.",
      "parameters": [
        {
          "name": "gc_id",
          "in": "path",
          "required": true,
          "description": "The gift certificate's `id`.",
          "schema": {
            "type": "string",
            "example": "gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "gift_certificate": {
              "type": "object",
              "properties": {
                "new_balance": {
                  "type": "string",
                  "description": "The balance to set, as a decimal string such as `7.00`."
                }
              },
              "required": [
                "new_balance"
              ]
            }
          },
          "required": [
            "gift_certificate"
          ]
        },
        "example": {
          "gift_certificate": {
            "new_balance": "7.00"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The gift certificate with its new balance, under `gift_certificate`.",
          "schema": {
            "$ref": "#/components/schemas/GiftCertificateResponse"
          }
        },
        "400": {
          "description": "`new_balance` is below the amount already used."
        }
      },
      "example_call": {
        "path": {
          "gc_id": "gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f"
        },
        "body": {
          "gift_certificate": {
            "new_balance": "7.00"
          }
        }
      }
    },
    {
      "key": "allocate_gift_certificate",
      "method": "POST",
      "path": "/gift_certificates/{gc_id}/allocations",
      "slug": "allocate-a-gift-certificate-to-an-account",
      "title": "Allocate a gift certificate to an account",
      "summary": "Allocates a gift certificate to an account and returns the certificate under `gift_certificate`.",
      "description": "Name the account in `gift_certificate.account.code`, using the account's `id` from the accounts API, such as `W13ZGY`. The call returns `200`, not `201`, and the certificate's `allocations` gains an entry.",
      "parameters": [
        {
          "name": "gc_id",
          "in": "path",
          "required": true,
          "description": "The gift certificate's `id`.",
          "schema": {
            "type": "string",
            "example": "gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "gift_certificate": {
              "type": "object",
              "properties": {
                "account": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "The account's `id`, such as `W13ZGY`."
                    },
                    "id": {
                      "type": "string",
                      "description": "The account's `acc_` uuid form. The `id` from the accounts API does not work here."
                    }
                  },
                  "description": "Name the account by `code` or by `id`."
                }
              },
              "required": [
                "account"
              ]
            }
          },
          "required": [
            "gift_certificate"
          ]
        },
        "example": {
          "gift_certificate": {
            "account": {
              "code": "W13ZGY"
            }
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The gift certificate with its allocations, under `gift_certificate`.",
          "schema": {
            "$ref": "#/components/schemas/GiftCertificateResponse"
          }
        },
        "404": {
          "description": "`account.id` held the account's `id`, such as `W13ZGY`, instead of its `acc_` uuid. Send that value as `account.code` instead."
        }
      },
      "example_call": {
        "path": {
          "gc_id": "gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f"
        },
        "body": {
          "gift_certificate": {
            "account": {
              "code": "W13ZGY"
            }
          }
        }
      }
    },
    {
