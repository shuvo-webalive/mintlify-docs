      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "gift_certificate": {
              "type": "object",
              "properties": {
                "account": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "The account's `id`, such as `W13ZGY`."
                    },
                    "id": {
                      "type": "string",
                      "description": "The account's `acc_` uuid form. The `id` from the accounts API does not work here."
                    }
                  },
                  "description": "Name the account by `code` or by `id`."
                }
              },
              "required": [
                "account"
              ]
            }
          },
          "required": [
            "gift_certificate"
          ]
        },
        "example": {
          "gift_certificate": {
            "account": {
              "code": "W13ZGY"
            }
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The gift certificate with its allocations, under `gift_certificate`.",
          "schema": {
            "$ref": "#/components/schemas/GiftCertificateResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "gc_id": "gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f"
        },
        "body": {
          "gift_certificate": {
            "account": {
              "code": "W13ZGY"
            }
          }
        }
      }
    },
