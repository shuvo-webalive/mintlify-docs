{
  "family": "gift_certificates",
  "tag": "Gift certificates",
  "slug": "gift-certificates",
  "icon": "gift",
  "base": "/gift_certificates",
  "overview_description": "Create, read, change and delete Exsited gift certificates, set balances, and allocate them to accounts.",
  "intro": "A gift certificate holds a balance a customer can spend. This area creates, lists, reads, updates and deletes certificates, sets a new balance, allocates a certificate to an account or takes it back, and reads its allocations and transactions. It has 12 endpoints, and every SDK supports all of them.",
  "warning": null,
  "notes": [
    "**Send bodies under `gift_certificate`.** A new certificate takes `amount` and `expiry_date`; amounts and balances are decimal strings such as `5.00`.",
    "**Change the balance with amend.** `POST /gift_certificates/{gc_id}/amend` takes only `new_balance`, and a balance below the amount already used returns `400`.",
    "**Name the account by `code` when allocating.** Send `{\"account\": {\"code\": \"W13ZGY\"}}`. The `id` form wants the account's `acc_` uuid and returns `404` for the `id` the accounts API gives you.",
    "**Allocate and deallocate return `200`.** Both return the certificate with its `allocations`; a deallocation changes the entry rather than removing it.",
    "**`status` is `active` or `inactive`.** Set it with an update to stop a certificate being used or allow it again.",
    "**Listings page by cursor.** Send `limit`, then pass `pagination.next_cursor` as `cursor` while `pagination.has_more` is `true`."
  ],
  "endpoints": [
    {
      "key": "get_gift_certificates",
      "method": "GET",
      "path": "/gift_certificates",
      "slug": "list-gift-certificates",
      "title": "List gift certificates",
      "summary": "Lists gift certificates, one page at a time.",
      "description": "The records are under `data`, and `pagination` holds the cursor for the next page. To filter, add `filter_<field>=<value>`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "The most records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` from the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Prefix it with `-` to sort in descending order.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "One page of gift certificates, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/GiftCertificateList"
          }
        }
      },
      "example_call": {
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "create_gift_certificate",
      "method": "POST",
      "path": "/gift_certificates",
      "slug": "create-a-gift-certificate",
      "title": "Create a gift certificate",
      "summary": "Creates a gift certificate with a starting amount and an expiry date and returns it under `gift_certificate`.",
      "description": "Send `amount` and `expiry_date` under `gift_certificate`. The new certificate gets a `code`, and its transactions start with one of type `initial`.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "gift_certificate": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string",
                  "description": "The starting balance, as a decimal string such as `5.00`."
                },
                "expiry_date": {
                  "type": "string",
                  "description": "The last day the certificate can be used, as `YYYY-MM-DD`."
                }
              }
            }
          },
          "required": [
            "gift_certificate"
          ]
        },
        "example": {
          "gift_certificate": {
            "amount": "5.00",
            "expiry_date": "2027-10-01"
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new gift certificate, under `gift_certificate`.",
          "schema": {
            "$ref": "#/components/schemas/GiftCertificateResponse"
          }
        }
      },
      "example_call": {
        "body": {
          "gift_certificate": {
            "amount": "5.00",
            "expiry_date": "2027-10-01"
          }
        }
      }
    },
    {
      "key": "delete_gift_certificate",
      "method": "DELETE",
      "path": "/gift_certificates/{gc_id}",
      "slug": "delete-a-gift-certificate",
      "title": "Delete a gift certificate",
      "summary": "Deletes a gift certificate and returns no content.",
      "description": "Pass the certificate's `id`. A successful delete returns `204` with an empty body, and reading the certificate afterwards returns `404`.",
      "parameters": [
        {
          "name": "gc_id",
          "in": "path",
          "required": true,
          "description": "The gift certificate's `id`.",
          "schema": {
            "type": "string",
            "example": "gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The gift certificate is deleted. The body is empty."
        }
      },
      "example_call": {
        "path": {
          "gc_id": "gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f"
        }
      }
    },
    {
      "key": "get_gift_certificate",
      "method": "GET",
      "path": "/gift_certificates/{gc_id}",
      "slug": "retrieve-a-gift-certificate",
      "title": "Retrieve a gift certificate",
      "summary": "Returns one gift certificate, under `gift_certificate`.",
      "description": "Pass the certificate's `id`. The response holds its `code`, `amount`, `remaining_balance`, `used_amount`, `status`, and its `allocations` and `transactions`.",
      "parameters": [
        {
          "name": "gc_id",
          "in": "path",
          "required": true,
          "description": "The gift certificate's `id`.",
          "schema": {
            "type": "string",
            "example": "gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The gift certificate, under `gift_certificate`.",
          "schema": {
            "$ref": "#/components/schemas/GiftCertificateResponse"
          }
        },
        "404": {
          "description": "No gift certificate has that `id`, for example after it is deleted."
        }
      },
      "example_call": {
        "path": {
          "gc_id": "gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f"
        }
      }
    },
    {
      "key": "update_gift_certificate",
      "method": "PATCH",
      "path": "/gift_certificates/{gc_id}",
      "slug": "update-a-gift-certificate",
      "title": "Update a gift certificate",
      "summary": "Changes a gift certificate's expiry date or status and returns it under `gift_certificate`.",
      "description": "Send only the fields to change under `gift_certificate`. Set `status` to `inactive` to stop the certificate being used, and back to `active` to allow it again. To change the balance, use the amend call instead.",
      "parameters": [
        {
          "name": "gc_id",
          "in": "path",
          "required": true,
          "description": "The gift certificate's `id`.",
          "schema": {
            "type": "string",
            "example": "gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "gift_certificate": {
              "type": "object",
              "properties": {
                "expiry_date": {
                  "type": "string",
                  "description": "As `YYYY-MM-DD`."
                },
                "status": {
                  "type": "string",
                  "description": "`active` or `inactive`."
                }
              }
            }
          },
          "required": [
            "gift_certificate"
          ]
        },
        "example": {
          "gift_certificate": {
            "expiry_date": "2027-12-31"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The updated gift certificate, under `gift_certificate`.",
          "schema": {
            "$ref": "#/components/schemas/GiftCertificateResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "gc_id": "gc_5b2e8f1a7c3d4e9b0a6f2c4d8e1b3a7f"
        },
        "body": {
          "gift_certificate": {
            "expiry_date": "2027-12-31"
          }
        }
      }
    },
