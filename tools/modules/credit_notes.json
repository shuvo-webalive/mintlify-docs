            "type": "string",
            "example": "cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "credit_note": {
              "type": "object",
              "properties": {
                "invoices": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "invoice_id": {
                        "type": "string"
                      },
                      "amount": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          },
          "required": [
            "credit_note"
          ]
        },
        "example": {
          "credit_note": {
            "invoices": [
              {
                "invoice_id": "INV-0001",
                "amount": 5
              }
            ]
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The credit note after the application."
        }
      },
      "example_call": {
        "path": {
          "credit_note_id": "cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d"
        },
        "body": {
          "credit_note": {
            "invoices": [
              {
                "invoice_id": "INV-0001",
                "amount": 5
              }
            ]
          }
        }
      }
    },
