        "403": {
          "description": "Your API client does not have the `DELETE_CREDIT_NOTE` permission."
        }
      },
      "example_call": {
        "path": {
          "credit_note_id": "cn_8a1d2c3b4e5f4a6b9c7d0e1f2a3b4c5d"
        }
      }
    },
    {
      "key": "apply_credit_note",
      "method": "POST",
      "path": "/credit_notes/{credit_note_id}/apply",
      "slug": "apply-a-credit-note-to-invoices",
      "title": "Apply a credit note to invoices",
      "summary": "Spends a credit note against one or more invoices and returns the credit note.",
      "description": "Applies the credit note to each invoice listed under `credit_note.invoices`, each entry with only `invoice_id` and `amount`. It records a payment against each invoice and a journal posting, and returns the credit note.",
      "parameters": [
        {
          "name": "credit_note_id",
          "in": "path",
          "required": true,
          "description": "The credit note's `id`, which starts with `cn_`.",
