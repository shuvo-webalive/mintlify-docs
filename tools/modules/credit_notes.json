    {
      "key": "create_credit_note",
      "method": "POST",
      "path": "/credit_notes",
      "slug": "create-a-credit-note",
      "title": "Create a credit note",
      "summary": "Credits an invoice by an amount and creates a credit note.",
      "description": "Creates a credit note for an invoice. The body takes only `invoice_id` and `amount` under `credit_note`; any other key returns `400`. The amount is drawn from the invoice's active payments, oldest first. Creating a credit note schedules the credit note issued communication.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "credit_note": {
              "type": "object",
              "properties": {
                "invoice_id": {
                  "type": "string",
                  "description": "The `id` of the invoice to credit."
                },
                "amount": {
                  "type": "number",
                  "description": "The amount to credit."
                }
              }
            }
          },
          "required": [
            "credit_note"
          ]
        },
        "example": {
          "credit_note": {
            "invoice_id": "INV-0001",
            "amount": 5
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The credit note is created."
        },
        "400": {
          "description": "The body has a key other than `invoice_id` and `amount`."
        }
      },
      "example_call": {
        "path": {},
        "body": {
          "credit_note": {
            "invoice_id": "INV-0001",
            "amount": 5
          }
        }
      }
    },
    {
