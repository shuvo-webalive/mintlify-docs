{
  "family": "credit_notes",
  "tag": "Credit notes",
  "slug": "credit-notes",
  "icon": "receipt",
  "base": "/credit_notes",
  "overview_description": "Create, read, update, apply and delete credit notes, and read their balance items, applications and notes.",
  "intro": "A credit note holds credit owed to an account, raised against an invoice or by an overpayment, that can be applied to invoices or refunded. This area has 14 endpoints: create, read, update, apply and delete credit notes, read their balance items and applications, and manage their notes and files. All seven SDKs call every one.",
  "warning": "**Applying a credit note records a payment against each invoice it names, and the call returns the credit note rather than those payments.**",
  "notes": [
    "**Creating a credit note takes only `invoice_id` and `amount`.** Both go under `credit_note`, and any other key returns `400`. The amount is drawn from the invoice's active payments, oldest first.",
    "**Applying takes only `invoices`.** Each entry of `credit_note.invoices` takes `invoice_id` and `amount` and nothing else.",
    "**A credit note with an active refund cannot be deleted.** The delete is refused with `400` and the code `in_use`. It accepts the `cn_` id or the credit note's code.",
    "**Items and applications are not paged.** Both come back under `credit_note`, carrying only `object`, `href` and their own list.",
    "**Money comes back as text.** `initial_amount`, `refund_amount` and `remaining_amount` are strings."
  ],
  "endpoints": [
    {
      "key": "get_credit_notes",
      "method": "GET",
      "path": "/credit_notes",
      "slug": "list-credit-notes",
      "title": "List credit notes",
      "summary": "Returns one page of credit notes.",
      "description": "Lists every credit note, one page at a time, under `data`. Each record carries its `code`, the `initial_amount`, `refund_amount` and `remaining_amount` as strings, and whether it is `refundable`. Other fields filter as `filter_<field>`, or `filter_<field>_<operator>` with an operator such as `gte` or `contains`.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "The most records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `next_cursor` value from the previous page, to fetch the page after it.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Put `-` in front for descending order, such as `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "One page of credit notes, under `data`, with `pagination`.",
          "schema": {
            "$ref": "#/components/schemas/CreditNoteList"
          }
        }
      },
      "example_call": {
        "path": {},
        "query": {
          "limit": 20
        }
      }
    },
