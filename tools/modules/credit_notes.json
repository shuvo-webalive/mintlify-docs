      "path": "/credit_notes/{credit_note_id}",
      "slug": "delete-a-credit-note",
      "title": "Delete a credit note",
      "summary": "Deletes a credit note.",
      "description": "Deletes the credit note, named by its `cn_` id or its code. A credit note with an active refund is refused with `400` and the code `in_use`. Your API client needs the `DELETE_CREDIT_NOTE` permission.",
      "parameters": [
        {
          "name": "credit_note_id",
          "in": "path",
          "required": true,
          "description": "The credit note's `id`, which starts with `cn_`, or its `code`.",
