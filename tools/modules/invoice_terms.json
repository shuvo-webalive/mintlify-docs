{
  "family": "invoice_terms",
  "tag": "Invoice terms",
  "slug": "invoice-terms",
  "icon": "file-invoice",
  "base": "/settings/invoice_terms",
  "overview_description": "List, create, read, update, enable, disable and delete invoice terms, each a period and a duration.",
  "intro": "An invoice term is a settings record made of a period, such as `MONTHLY`, and a duration. You can list, create, read, update, enable or disable and delete invoice terms. This area has 5 endpoints, and all seven SDKs call every one.",
  "warning": null,
  "notes": [
    "**Writes and reads return different shapes.** A create or an update returns a flat `period` and an integer `duration`, where a read nests them as `duration.period` and `duration.count`.",
    "**A create sends `period` and `duration`.** For example `\"period\": \"MONTHLY\"` and `\"duration\": 1`, with `name` and `display_name`, under `invoice_term`.",
    "**Listings page by cursor.** Pass `limit` for the page size, then pass `pagination.next_cursor` back as `cursor` while `pagination.has_more` is true.",
    "**A delete returns `204` with no body.** Reading the invoice term afterwards returns `404`."
  ],
  "endpoints": [
    {
      "key": "get_settings_invoice_terms",
      "method": "GET",
      "path": "/settings/invoice_terms",
      "slug": "list-invoice-terms",
      "title": "List invoice terms",
      "summary": "Returns a page of invoice terms under `data`, with paging details under `pagination`.",
      "description": "Lists the invoice terms on the instance. Pass `limit` to set the page size, and while `pagination.has_more` is true pass `pagination.next_cursor` back as `cursor` to read the next page. Other fields filter as `filter_<field>` or `filter_<field>_<operator>`, and `sort` orders the results.",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "How many records to return on one page.",
          "schema": {
            "type": "integer",
            "example": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "The `pagination.next_cursor` of the previous page, to read the next one.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "description": "The field to sort by. Prefix it with `-` for descending order, such as `-created_on`.",
          "schema": {
            "type": "string",
            "example": "-created_on"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "A page of invoice terms, under `data`.",
          "schema": {
            "$ref": "#/components/schemas/InvoiceTermList"
          }
        }
      },
      "example_call": {
        "path": {},
        "query": {
          "limit": 20
        }
      }
    },
    {
      "key": "create_settings_invoice_term",
      "method": "POST",
      "path": "/settings/invoice_terms",
      "slug": "create-an-invoice-term",
      "title": "Create an invoice term",
      "summary": "Creates an invoice term and returns it under `invoice_term`.",
      "description": "Send the new invoice term under `invoice_term`. The response is flat, with `period` and an integer `duration`, where a read nests them under `duration`.",
      "parameters": [],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "invoice_term": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The invoice term's name."
                },
                "display_name": {
                  "type": "string",
                  "description": "The name shown for the invoice term."
                },
                "period": {
                  "type": "string",
                  "description": "The period, such as `MONTHLY`."
                },
                "duration": {
                  "type": "integer",
                  "description": "How many periods the term lasts."
                }
              }
            }
          },
          "required": [
            "invoice_term"
          ]
        },
        "example": {
          "invoice_term": {
            "name": "Net one month",
            "display_name": "Net one month",
            "period": "MONTHLY",
            "duration": 1
          }
        }
      },
      "multipart": false,
      "responses": {
        "201": {
          "description": "The new invoice term, under `invoice_term`.",
          "schema": {
            "$ref": "#/components/schemas/InvoiceTermWriteResponse"
          }
        }
      },
      "example_call": {
        "path": {},
        "body": {
          "invoice_term": {
            "name": "Net one month",
            "display_name": "Net one month",
            "period": "MONTHLY",
            "duration": 1
          }
        }
      }
    },
    {
      "key": "get_settings_invoice_term",
      "method": "GET",
      "path": "/settings/invoice_terms/{invoice_term_id}",
      "slug": "retrieve-an-invoice-term",
      "title": "Retrieve an invoice term",
      "summary": "Returns one invoice term by its `id`, under `invoice_term`.",
      "description": "Reads the invoice term with this `id`. The `id` is the one a listing or a create returns. A read nests the period and count under `duration`.",
      "parameters": [
        {
          "name": "invoice_term_id",
          "in": "path",
          "required": true,
          "description": "The invoice term's `id`, as a listing or a create returns it.",
          "schema": {
            "type": "string",
            "example": "946ed1d6908648ca86cb1e5baef55e40"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "200": {
          "description": "The invoice term, under `invoice_term`.",
          "schema": {
            "$ref": "#/components/schemas/InvoiceTermResponse"
          }
        },
        "404": {
          "description": "No invoice term has that `id`."
        }
      },
      "example_call": {
        "path": {
          "invoice_term_id": "946ed1d6908648ca86cb1e5baef55e40"
        }
      }
    },
    {
      "key": "delete_settings_invoice_term",
      "method": "DELETE",
      "path": "/settings/invoice_terms/{invoice_term_id}",
      "slug": "delete-an-invoice-term",
      "title": "Delete an invoice term",
      "summary": "Deletes an invoice term. The response has no body.",
      "description": "Deletes the invoice term with this `id`. Reading the same `id` afterwards returns `404`.",
      "parameters": [
        {
          "name": "invoice_term_id",
          "in": "path",
          "required": true,
          "description": "The invoice term's `id`, as a listing or a create returns it.",
          "schema": {
            "type": "string",
            "example": "946ed1d6908648ca86cb1e5baef55e40"
          }
        }
      ],
      "body": null,
      "multipart": false,
      "responses": {
        "204": {
          "description": "The invoice term is deleted. The response has no body."
        }
      },
      "example_call": {
        "path": {
          "invoice_term_id": "946ed1d6908648ca86cb1e5baef55e40"
        }
      }
    },
    {
      "key": "update_settings_invoice_term",
      "method": "PATCH",
      "path": "/settings/invoice_terms/{invoice_term_id}",
      "slug": "update-an-invoice-term",
      "title": "Update an invoice term",
      "summary": "Changes the fields of an invoice term, or enables or disables it, and returns it under `invoice_term`.",
      "description": "Send the fields to change under `invoice_term`. Send `status` to enable or disable it. The response is flat, with `period` and an integer `duration`, where a read nests them under `duration`.",
      "parameters": [
        {
          "name": "invoice_term_id",
          "in": "path",
          "required": true,
          "description": "The invoice term's `id`, as a listing or a create returns it.",
          "schema": {
            "type": "string",
            "example": "946ed1d6908648ca86cb1e5baef55e40"
          }
        }
      ],
      "body": {
        "schema": {
          "type": "object",
          "properties": {
            "invoice_term": {
              "type": "object",
              "properties": {
                "display_name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "invoice_term"
          ]
        },
        "example": {
          "invoice_term": {
            "display_name": "Net one month (AU)",
            "description": "Due one month after issue"
          }
        }
      },
      "multipart": false,
      "responses": {
        "200": {
          "description": "The updated invoice term, under `invoice_term`.",
          "schema": {
            "$ref": "#/components/schemas/InvoiceTermWriteResponse"
          }
        }
      },
      "example_call": {
        "path": {
          "invoice_term_id": "946ed1d6908648ca86cb1e5baef55e40"
        },
        "body": {
          "invoice_term": {
            "display_name": "Net one month (AU)",
            "description": "Due one month after issue"
          }
        }
      }
    }
  ],
